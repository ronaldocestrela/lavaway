# ==========================================
# Build Stage - Migrations Bundles
# ==========================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .

RUN dotnet tool install --global dotnet-ef --version 10.0.9
ENV PATH="$PATH:/root/.dotnet/tools"

# Provide dummy connection string required by Program.cs during design-time build
ENV ConnectionStrings__CarWashSaaS="Server=localhost;Database=Dummy;User Id=sa;Password=Dummy123!;"

# Restore all projects
RUN dotnet restore CarWashSaaS.sln

WORKDIR /app
RUN dotnet ef migrations bundle --project /src/src/Backend/Modules/Tenants/CarWashSaaS.Tenants.Infrastructure --startup-project /src/src/Backend/CarWashSaaS.Api --context TenantsDbContext -o /app/bundle-tenants --force
RUN dotnet ef migrations bundle --project /src/src/Backend/Modules/Identity/CarWashSaaS.Identity.Infrastructure --startup-project /src/src/Backend/CarWashSaaS.Api --context IdentityModuleDbContext -o /app/bundle-identity --force
RUN dotnet ef migrations bundle --project /src/src/Backend/Modules/YardOperations/CarWashSaaS.YardOperations.Infrastructure --startup-project /src/src/Backend/CarWashSaaS.Api --context YardOperationsDbContext -o /app/bundle-yard --force
RUN dotnet ef migrations bundle --project /src/src/Backend/Modules/WhatsApp/CarWashSaaS.WhatsApp.Infrastructure --startup-project /src/src/Backend/CarWashSaaS.Api --context WhatsAppDbContext -o /app/bundle-whatsapp --force
RUN dotnet ef migrations bundle --project /src/src/Backend/Modules/Billing/CarWashSaaS.Billing.Infrastructure --startup-project /src/src/Backend/CarWashSaaS.Api --context BillingDbContext -o /app/bundle-billing --force

# ==========================================
# Runtime Stage - AspNet Runtime
# ==========================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/bundle-* ./
COPY scripts/docker-entrypoint-migrator.sh ./entrypoint.sh

USER root
RUN chmod +x ./entrypoint.sh ./bundle-*

ENTRYPOINT ["./entrypoint.sh"]
