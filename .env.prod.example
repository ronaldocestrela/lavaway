# ==============================================================================
# Lavaway SaaS - Variáveis de Ambiente para Produção
# Copie este arquivo para .env.prod antes de subir o ambiente:
#   cp .env.prod.example .env.prod
# ==============================================================================

# Porta pública do Nginx / Frontend Web
WEB_PORT=80
APP_URL=http://localhost

# ------------------------------------------------------------------------------
# Banco de Dados Principal (Microsoft SQL Server 2022)
# ------------------------------------------------------------------------------
MSSQL_PID=Standard
MSSQL_SA_PASSWORD=TroqueEstaSenhaForteSqlServer2026!
SQL_DATABASE=CarWashSaaS

# ------------------------------------------------------------------------------
# Object Storage Privado (MinIO S3)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=lavaway_admin
MINIO_ROOT_PASSWORD=TroqueEstaSenhaForteMinio2026!
MINIO_BUCKET=lavaway-private

# ------------------------------------------------------------------------------
# Mensageria & Filas (RabbitMQ 4)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=lavaway_broker
RABBITMQ_DEFAULT_PASS=TroqueEstaSenhaForteRabbit2026!
RABBITMQ_QUEUE=lavaway.tenant-events

# ------------------------------------------------------------------------------
# Autenticação & Segurança (JWT)
# ATENÇÃO: JWT_SIGNING_KEY deve ter no mínimo 32 caracteres (256 bits)
# ------------------------------------------------------------------------------
JWT_SIGNING_KEY=TroqueParaUmaChaveSeguraComMaisDe32CaracteresProducao2026!
JWT_LIFETIME_MINUTES=60
AUTH_AUTHORITY=http://api:8080
AUTH_ISSUER=http://api:8080
AUTH_AUDIENCE=CarWashSaaS.Client

# ------------------------------------------------------------------------------
# WhatsApp Integration (Evolution API v2.3.7)
# ------------------------------------------------------------------------------
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution_admin
EVOLUTION_POSTGRES_PASSWORD=TroqueEstaSenhaFortePostgresEvo2026!
EVOLUTION_API_KEY=TroqueParaUmaChaveGlobalForteEvo2026
EVOLUTION_SERVER_URL=http://evolution-api:8080
WHATSAPP_INSTANCE_PREFIX=lavaway
WHATSAPP_WEBHOOK_SECRET=TroquePorUmSegredoUnicoDoWebhook2026!

# ------------------------------------------------------------------------------
# Seed Inicial de Dados (Executado automaticamente na inicialização da API)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@lavaway.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_RECEPTION_EMAIL=recepcao@lavaway.com
SEED_RECEPTION_PASSWORD=Recepcao123!
SEED_PLATFORM_ADMIN_EMAIL=platform@lavaway.com
SEED_PLATFORM_ADMIN_PASSWORD=PlatformAdmin123!

