@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Routing
<div class="app-shell">
    <!-- Sidebar Desktop -->
    <aside class="sidebar">
        <a class="brand" href="reception" aria-label="Lavaway, recepção">
            <span class="brand-mark">L</span>
            <span class="brand-name">lavaway</span>
        </a>
        <div class="sidebar-caption">OPERAÇÃO</div>
        <NavMenu />
        <div class="sidebar-bottom">
            <span class="connection-dot"></span>
            <span>Ambiente de loja</span>
        </div>
    </aside>

    <!-- Mobile Drawer Overlay & Panel -->
    <div class="mobile-drawer-backdrop @(isMobileDrawerOpen ? "open" : "")" @onclick="CloseMobileDrawer" aria-hidden="@(!isMobileDrawerOpen)"></div>
    <aside class="mobile-drawer @(isMobileDrawerOpen ? "open" : "")" aria-label="Menu móvel de navegação" aria-hidden="@(!isMobileDrawerOpen)">
        <div class="drawer-header">
            <a class="brand" href="reception" @onclick="CloseMobileDrawer">
                <span class="brand-mark">L</span>
                <span class="brand-name">lavaway</span>
            </a>
            <button type="button" class="btn-drawer-close" @onclick="CloseMobileDrawer" aria-label="Fechar menu">✕</button>
        </div>
        <div class="drawer-scroll">
            <div class="drawer-caption">OPERAÇÃO &amp; GESTÃO</div>
            <NavMenu />
        </div>
        <div class="drawer-footer">
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="drawer-user-info">
                        <span class="account-indicator"></span>
                        <span class="drawer-user-name">@(authState.User.Identity?.Name ?? "Sessão ativa")</span>
                    </div>
                    <a class="logout-link drawer-logout" href="authentication/logout" title="Encerrar sessão">Sair</a>
                </Authorized>
                <NotAuthorized>
                    <a class="account-link drawer-account-link" href="authentication/login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn-mobile-menu" @onclick="ToggleMobileDrawer" aria-label="Abrir menu de navegação">
                    <span class="menu-icon-bar"></span>
                    <span class="menu-icon-bar"></span>
                    <span class="menu-icon-bar"></span>
                </button>
                <div class="breadcrumb">
                    <span class="breadcrumb-prefix">Operação</span>
                    <span class="breadcrumb-slash">/</span>
                    <strong>@CurrentSection</strong>
                </div>
            </div>
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="user-session-bar">
                        <div class="account-chip"><span class="account-indicator"></span>@(authState.User.Identity?.Name ?? "Sessão ativa")</div>
                        <a class="logout-link" href="authentication/logout" title="Encerrar sessão">Sair</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="account-link" href="authentication/login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>
        <main class="page-content">@Body</main>
    </div>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-nav" aria-label="Ações rápidas da base">
        <NavLink class="bottom-nav-item" href="reception">
            <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/>
                <circle cx="7" cy="17" r="2"/>
                <circle cx="17" cy="17" r="2"/>
            </svg>
            <span class="bottom-nav-label">Recepção</span>
        </NavLink>
        <NavLink class="bottom-nav-item" href="yard">
            <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="5" height="18" rx="1"/>
                <rect x="11" y="3" width="5" height="12" rx="1"/>
                <rect x="19" y="3" width="5" height="8" rx="1"/>
            </svg>
            <span class="bottom-nav-label">Pátio</span>
        </NavLink>
        <NavLink class="bottom-nav-item" href="cashier">
            <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
                <circle cx="12" cy="15" r="2"/>
            </svg>
            <span class="bottom-nav-label">Caixa</span>
        </NavLink>
        <NavLink class="bottom-nav-item" href="customers">
            <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span class="bottom-nav-label">Clientes</span>
        </NavLink>
        <button type="button" class="bottom-nav-item @(isMobileDrawerOpen ? "active" : "")" @onclick="ToggleMobileDrawer" aria-label="Abrir menu mais opções">
            <svg class="bottom-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <span class="bottom-nav-label">Mais</span>
        </button>
    </nav>
</div>

@code {
    private bool isMobileDrawerOpen = false;

    private void ToggleMobileDrawer()
    {
        isMobileDrawerOpen = !isMobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        isMobileDrawerOpen = false;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private string CurrentSection => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/') switch
    {
        "reception" => "Recepção",
        "yard" => "Pátio & Kanban",
        "customers" => "Clientes",
        "scheduling" => "Agenda & Reservas",
        "after-sales" => "Pós-Venda & Retenção",
        "cashier" => "Caixa & Comissões",
        "loyalty" => "Fidelidade & Selos",
        "subscriptions" => "Assinaturas & Clubes",
        "settings/profile" => "Perfil da Loja",
        "settings/services" => "Serviços & Preços",
        "settings/team" => "Capacidade & Equipe",
        "settings/whatsapp" => "WhatsApp",
        "platform/audit" => "Auditoria & Backoffice",
        "work-orders/new" => "Nova Ordem de Serviço",

        _ when Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("work-orders/", StringComparison.OrdinalIgnoreCase) => "Vistoria do Veículo",
        _ => "Operação"
    };

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (isMobileDrawerOpen)
        {
            isMobileDrawerOpen = false;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
