@page "/settings/subscription"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@inject SaasBillingApiClient BillingClient
@inject IToastService ToastService

<PageTitle>Meu Plano &amp; Assinatura — Lavaway</PageTitle>

<div class="tenant-subscription-page">
    <PageHeading Eyebrow="GESTÃO DE ASSINATURA"
                 Title="Meu Plano & Assinatura"
                 Subtitle="Acompanhe seu consumo mensal de cotas, vigência da assinatura e faturas da plataforma.">
        <Actions>
            <button type="button" @onclick="OpenUpgradeModal" class="btn-upgrade-action">
                <svg class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <span>Alterar Plano / Upgrade</span>
            </button>
        </Actions>
    </PageHeading>

    @if (Overview is not null)
    {
        <!-- Alerta de Inadimplência / Carência -->
        @if (Overview.Status == TenantSubscriptionStatus.GracePeriod || Overview.Status == TenantSubscriptionStatus.Delinquent)
        {
            <DelinquencyAlertBanner Status="Overview.Status"
                                    GracePeriodEndsAtUtc="Overview.GracePeriodEndsAtUtc"
                                    OnSettleClicked="OpenPendingInvoice" />
        }

        <!-- Grid Superior: Resumo do Plano e Quotas -->
        <section class="overview-grid" aria-label="Resumo do Plano e Quotas">
            <!-- Card do Plano Ativo -->
            <div class="subscription-card plan-summary-card">
                <div>
                    <div class="card-meta-header">
                        <div class="card-label-group">
                            <span class="card-label">Plano Atual</span>
                        </div>
                        <span class="status-pill @GetStatusBadgeClass(Overview.Status)">
                            @GetStatusDisplay(Overview.Status)
                        </span>
                    </div>
                    <div class="plan-body">
                        <h2 class="plan-name">Plano @Overview.PlanName</h2>
                        <div class="price-display">
                            <span class="price-currency">R$</span>
                            <span class="price-value">@Overview.MonthlyPrice.ToString("N2")</span>
                            <span class="price-period">/mês</span>
                        </div>
                    </div>
                </div>

                <div class="billing-cycle-info">
                    <p>Ciclo: @Overview.CurrentPeriodStartUtc.ToString("dd/MM") a @Overview.CurrentPeriodEndUtc.ToString("dd/MM/yyyy")</p>
                    @if (Overview.NextBillingDateUtc.HasValue)
                    {
                        <p>Próxima renovação: <strong>@Overview.NextBillingDateUtc.Value.ToString("dd/MM/yyyy")</strong></p>
                    }
                </div>
            </div>

            <!-- Card de Cotas de OS -->
            <div class="subscription-card quota-card">
                <div>
                    <div class="card-meta-header">
                        <div class="card-label-group">
                            <svg class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                            </svg>
                            <span class="card-label">Cota Mensal de OS</span>
                        </div>
                    </div>
                    <div class="quota-card-body">
                        <PlanQuotaProgressBar Title="Ordens de Serviço Abertas"
                                              Used="Overview.UsedWorkOrders"
                                              Max="Overview.MaxWorkOrders" />
                    </div>
                </div>
                <p class="quota-footnote">
                    Contabiliza as ordens de serviço geradas durante o ciclo mensal vigente.
                </p>
            </div>

            <!-- Card de Cotas de WhatsApp -->
            <div class="subscription-card quota-card">
                <div>
                    <div class="card-meta-header">
                        <div class="card-label-group">
                            <svg class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                            </svg>
                            <span class="card-label">Cota Mensal de WhatsApp</span>
                        </div>
                    </div>
                    <div class="quota-card-body">
                        <PlanQuotaProgressBar Title="Disparos de Notificação"
                                              Used="Overview.UsedWhatsAppMessages"
                                              Max="Overview.MaxWhatsAppMessages" />
                    </div>
                </div>
                <p class="quota-footnote">
                    Mensagens transacionais de OS, agendamentos e cobranças Pix enviadas pelo sistema.
                </p>
            </div>
        </section>

        <!-- Faturas da Assinatura -->
        <section class="invoices-section" aria-label="Histórico de Faturas">
            <div class="invoices-header">
                <h3 class="invoices-title">Histórico de Faturas do SaaS</h3>
                <p class="invoices-subtitle">Comprovantes e liquidações das mensalidades do estabelecimento</p>
            </div>

            @if (Overview.Invoices.Count == 0)
            {
                <div class="invoices-empty">
                    <svg class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <p class="empty-text">Nenhuma fatura registrada até o momento.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="invoices-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Vencimento</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th class="text-right">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in Overview.Invoices)
                            {
                                <tr>
                                    <td class="invoice-code">@invoice.GatewayInvoiceId</td>
                                    <td class="invoice-date">@invoice.DueDateUtc.ToString("dd/MM/yyyy")</td>
                                    <td class="invoice-amount">R$ @invoice.Amount.ToString("N2")</td>
                                    <td>
                                        <span class="badge-invoice @GetInvoiceStatusBadge(invoice.Status)">
                                            @GetInvoiceStatusDisplay(invoice.Status)
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        @if (invoice.Status == "Pending" || invoice.Status == "Overdue")
                                        {
                                            <button type="button" @onclick="() => OpenInvoice(invoice)" class="btn-pay-pix">
                                                <span>Pagar Pix</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="settled-label">Liquidado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">
            <span class="button-spinner" aria-hidden="true"></span>
            <span>Carregando informações da assinatura...</span>
        </div>
    }
</div>

<!-- Modais -->
<UpgradePlanModal IsOpen="IsUpgradeModalOpen"
                  CurrentTier="@(Overview?.PlanTier ?? SaasPlanTier.Basic)"
                  Plans="AvailablePlans"
                  OnClose="() => IsUpgradeModalOpen = false"
                  OnConfirm="HandlePlanChange" />

<SettleInvoiceModal IsOpen="IsInvoiceModalOpen"
                    Invoice="SelectedInvoice"
                    OnClose="() => IsInvoiceModalOpen = false"
                    OnSettle="HandleInvoiceSettle" />

@code {
    private TenantSubscriptionOverviewDto? Overview { get; set; }
    private IReadOnlyList<SaasPlanDto> AvailablePlans { get; set; } = [];
    private bool IsLoading { get; set; } = true;

    private bool IsUpgradeModalOpen { get; set; }
    private bool IsInvoiceModalOpen { get; set; }
    private SaasInvoiceDto? SelectedInvoice { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var overviewResult = await BillingClient.GetTenantOverviewAsync();
            if (overviewResult.IsSuccess)
            {
                Overview = overviewResult.Value;
            }
            else
            {
                ToastService.ShowError(overviewResult.Error!.Description);
            }

            var plansResult = await BillingClient.ListPlansAsync();
            if (plansResult.IsSuccess)
            {
                AvailablePlans = plansResult.Value!;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenUpgradeModal() => IsUpgradeModalOpen = true;

    private void OpenPendingInvoice()
    {
        if (Overview?.PendingInvoice is not null)
        {
            SelectedInvoice = Overview.PendingInvoice;
            IsInvoiceModalOpen = true;
        }
    }

    private void OpenInvoice(SaasInvoiceDto invoice)
    {
        SelectedInvoice = invoice;
        IsInvoiceModalOpen = true;
    }

    private async Task HandlePlanChange(SaasPlanTier newTier)
    {
        var result = await BillingClient.ChangePlanAsync(newTier);
        if (result.IsSuccess)
        {
            Overview = result.Value;
            IsUpgradeModalOpen = false;
            ToastService.ShowSuccess("Plano atualizado com sucesso!");
        }
        else
        {
            ToastService.ShowError(result.Error!.Description);
        }
    }

    private async Task HandleInvoiceSettle(Guid invoiceId)
    {
        var result = await BillingClient.SettleInvoiceAsync(invoiceId);
        if (result.IsSuccess)
        {
            Overview = result.Value;
            IsInvoiceModalOpen = false;
            ToastService.ShowSuccess("Fatura quitada! Assinatura ativada com sucesso.");
        }
        else
        {
            ToastService.ShowError(result.Error!.Description);
        }
    }

    private static string GetStatusBadgeClass(TenantSubscriptionStatus status) => status switch
    {
        TenantSubscriptionStatus.Active => "status-active",
        TenantSubscriptionStatus.Trial => "status-trial",
        TenantSubscriptionStatus.GracePeriod => "status-grace",
        TenantSubscriptionStatus.Delinquent => "status-delinquent",
        _ => "status-canceled"
    };

    private static string GetStatusDisplay(TenantSubscriptionStatus status) => status switch
    {
        TenantSubscriptionStatus.Active => "Ativo",
        TenantSubscriptionStatus.Trial => "Período de Testes",
        TenantSubscriptionStatus.GracePeriod => "Em Carência",
        TenantSubscriptionStatus.Delinquent => "Suspenso",
        TenantSubscriptionStatus.Canceled => "Cancelado",
        _ => status.ToString()
    };

    private static string GetInvoiceStatusBadge(string status) => status switch
    {
        "Paid" => "badge-paid",
        "Pending" => "badge-pending",
        "Overdue" => "badge-overdue",
        _ => "badge-other"
    };

    private static string GetInvoiceStatusDisplay(string status) => status switch
    {
        "Paid" => "Paga",
        "Pending" => "Pendente",
        "Overdue" => "Vencida",
        _ => status
    };
}
