@page "/settings/subscription"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@inject SaasBillingApiClient BillingClient
@inject IToastService ToastService

<PageTitle>Meu Plano & Assinatura — Lavaway</PageTitle>

<div class="mx-auto max-w-5xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900">Meu Plano & Assinatura</h1>
            <p class="text-xs text-slate-500">Acompanhe seu consumo mensal de cotas, vigência da assinatura e faturas da plataforma.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" @onclick="OpenUpgradeModal"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-700">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Alterar Plano / Upgrade
            </button>
        </div>
    </div>

    @if (Overview is not null)
    {
        <!-- Alerta de Inadimplência / Carência -->
        @if (Overview.Status == TenantSubscriptionStatus.GracePeriod || Overview.Status == TenantSubscriptionStatus.Delinquent)
        {
            <DelinquencyAlertBanner Status="Overview.Status"
                                    GracePeriodEndsAtUtc="Overview.GracePeriodEndsAtUtc"
                                    OnSettleClicked="OpenPendingInvoice" />
        }

        <!-- Grid Superior: Resumo do Plano e Quotas -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <!-- Card do Plano Ativo -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-slate-500">Plano Atual</span>
                    <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold @GetStatusBadgeClass(Overview.Status)">
                        @GetStatusDisplay(Overview.Status)
                    </span>
                </div>
                <h3 class="mt-2 text-2xl font-black text-slate-900">Plano @Overview.PlanName</h3>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-xl font-bold text-slate-900">R$ @Overview.MonthlyPrice.ToString("N2")</span>
                    <span class="text-xs text-slate-500">/mês</span>
                </div>
                <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500 space-y-1">
                    <p>Ciclo: @Overview.CurrentPeriodStartUtc.ToString("dd/MM") a @Overview.CurrentPeriodEndUtc.ToString("dd/MM/yyyy")</p>
                    @if (Overview.NextBillingDateUtc.HasValue)
                    {
                        <p>Próxima renovação: <strong>@Overview.NextBillingDateUtc.Value.ToString("dd/MM/yyyy")</strong></p>
                    }
                </div>
            </div>

            <!-- Card de Cotas de OS -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm flex flex-col justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-500">Cota Mensal de Ordens de Serviço</span>
                    <div class="mt-3">
                        <PlanQuotaProgressBar Title="Ordens de Serviço Abertas"
                                              Used="Overview.UsedWorkOrders"
                                              Max="Overview.MaxWorkOrders" />
                    </div>
                </div>
                <p class="mt-4 text-[11px] text-slate-400">
                    Contabiliza as ordens de serviço geradas durante o ciclo mensal vigente.
                </p>
            </div>

            <!-- Card de Cotas de WhatsApp -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm flex flex-col justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-500">Cota Mensal de Mensagens WhatsApp</span>
                    <div class="mt-3">
                        <PlanQuotaProgressBar Title="Disparos de Notificação"
                                              Used="Overview.UsedWhatsAppMessages"
                                              Max="Overview.MaxWhatsAppMessages" />
                    </div>
                </div>
                <p class="mt-4 text-[11px] text-slate-400">
                    Mensagens transacionais de OS, agendamentos e cobranças Pix enviadas pelo sistema.
                </p>
            </div>
        </div>

        <!-- Faturas da Assinatura -->
        <div class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 px-5 py-4 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Histórico de Faturas do SaaS</h3>
                    <p class="text-xs text-slate-500">Comprovantes e liquidações das mensalidades do estabelecimento</p>
                </div>
            </div>

            @if (Overview.Invoices.Count == 0)
            {
                <div class="p-8 text-center text-xs text-slate-400">
                    Nenhuma fatura registrada até o momento.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-100">
                            <tr>
                                <th class="px-5 py-3">Código</th>
                                <th class="px-5 py-3">Vencimento</th>
                                <th class="px-5 py-3">Valor</th>
                                <th class="px-5 py-3">Status</th>
                                <th class="px-5 py-3 text-right">Ação</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var invoice in Overview.Invoices)
                            {
                                <tr class="hover:bg-slate-50/50">
                                    <td class="px-5 py-3 font-mono font-medium text-slate-700">@invoice.GatewayInvoiceId</td>
                                    <td class="px-5 py-3 text-slate-600">@invoice.DueDateUtc.ToString("dd/MM/yyyy")</td>
                                    <td class="px-5 py-3 font-bold text-slate-900">R$ @invoice.Amount.ToString("N2")</td>
                                    <td class="px-5 py-3">
                                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @GetInvoiceStatusBadge(invoice.Status)">
                                            @GetInvoiceStatusDisplay(invoice.Status)
                                        </span>
                                    </td>
                                    <td class="px-5 py-3 text-right">
                                        @if (invoice.Status == "Pending" || invoice.Status == "Overdue")
                                        {
                                            <button type="button" @onclick="() => OpenInvoice(invoice)"
                                                    class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm hover:bg-emerald-700">
                                                Pagar Pix
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 font-medium">Liquidado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (IsLoading)
    {
        <div class="flex items-center justify-center p-12 text-xs text-slate-400">
            Carregando informações da assinatura...
        </div>
    }
</div>

<!-- Modais -->
<UpgradePlanModal IsOpen="IsUpgradeModalOpen"
                  CurrentTier="@(Overview?.PlanTier ?? SaasPlanTier.Basic)"
                  Plans="AvailablePlans"
                  OnClose="() => IsUpgradeModalOpen = false"
                  OnConfirm="HandlePlanChange" />

<SettleInvoiceModal IsOpen="IsInvoiceModalOpen"
                    Invoice="SelectedInvoice"
                    OnClose="() => IsInvoiceModalOpen = false"
                    OnSettle="HandleInvoiceSettle" />

@code {
    private TenantSubscriptionOverviewDto? Overview { get; set; }
    private IReadOnlyList<SaasPlanDto> AvailablePlans { get; set; } = [];
    private bool IsLoading { get; set; } = true;

    private bool IsUpgradeModalOpen { get; set; }
    private bool IsInvoiceModalOpen { get; set; }
    private SaasInvoiceDto? SelectedInvoice { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var overviewResult = await BillingClient.GetTenantOverviewAsync();
            if (overviewResult.IsSuccess)
            {
                Overview = overviewResult.Value;
            }
            else
            {
                ToastService.ShowError(overviewResult.Error!.Description);
            }

            var plansResult = await BillingClient.ListPlansAsync();
            if (plansResult.IsSuccess)
            {
                AvailablePlans = plansResult.Value!;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenUpgradeModal() => IsUpgradeModalOpen = true;

    private void OpenPendingInvoice()
    {
        if (Overview?.PendingInvoice is not null)
        {
            SelectedInvoice = Overview.PendingInvoice;
            IsInvoiceModalOpen = true;
        }
    }

    private void OpenInvoice(SaasInvoiceDto invoice)
    {
        SelectedInvoice = invoice;
        IsInvoiceModalOpen = true;
    }

    private async Task HandlePlanChange(SaasPlanTier newTier)
    {
        var result = await BillingClient.ChangePlanAsync(newTier);
        if (result.IsSuccess)
        {
            Overview = result.Value;
            IsUpgradeModalOpen = false;
            ToastService.ShowSuccess("Plano atualizado com sucesso!");
        }
        else
        {
            ToastService.ShowError(result.Error!.Description);
        }
    }

    private async Task HandleInvoiceSettle(Guid invoiceId)
    {
        var result = await BillingClient.SettleInvoiceAsync(invoiceId);
        if (result.IsSuccess)
        {
            Overview = result.Value;
            IsInvoiceModalOpen = false;
            ToastService.ShowSuccess("Fatura quitada! Assinatura ativada com sucesso.");
        }
        else
        {
            ToastService.ShowError(result.Error!.Description);
        }
    }

    private static string GetStatusBadgeClass(TenantSubscriptionStatus status) => status switch
    {
        TenantSubscriptionStatus.Active => "bg-emerald-50 text-emerald-700",
        TenantSubscriptionStatus.Trial => "bg-blue-50 text-blue-700",
        TenantSubscriptionStatus.GracePeriod => "bg-amber-50 text-amber-700",
        TenantSubscriptionStatus.Delinquent => "bg-rose-50 text-rose-700",
        _ => "bg-slate-100 text-slate-700"
    };

    private static string GetStatusDisplay(TenantSubscriptionStatus status) => status switch
    {
        TenantSubscriptionStatus.Active => "Ativo",
        TenantSubscriptionStatus.Trial => "Período de Testes",
        TenantSubscriptionStatus.GracePeriod => "Em Carência",
        TenantSubscriptionStatus.Delinquent => "Suspenso",
        TenantSubscriptionStatus.Canceled => "Cancelado",
        _ => status.ToString()
    };

    private static string GetInvoiceStatusBadge(string status) => status switch
    {
        "Paid" => "bg-emerald-50 text-emerald-700",
        "Pending" => "bg-amber-50 text-amber-700",
        "Overdue" => "bg-rose-50 text-rose-700",
        _ => "bg-slate-100 text-slate-700"
    };

    private static string GetInvoiceStatusDisplay(string status) => status switch
    {
        "Paid" => "Paga",
        "Pending" => "Pendente",
        "Overdue" => "Vencida",
        _ => status
    };
}
