@page "/settings/payments"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Roles = "Administrator")]
@inject BillingApiClient BillingApi
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Configuração de Pagamentos | Lavaway</PageTitle>

<section class="payment-settings-page">
    <PageHeading Eyebrow="PAGAMENTOS & GATEWAYS"
                 Title="Emissor de Cobrança e Pix"
                 Subtitle="Configure as credenciais da sua conta Pagar.me (Stone Co.) para receber pagamentos Pix diretamente na sua conta bancária e conciliar baixas no sistema em tempo real." />

    @if (_isLoading)
    {
        <div class="loading-state" role="status">
            <span class="button-spinner" aria-hidden="true"></span>
            <span>Carregando configurações de pagamento...</span>
        </div>
    }
    else
    {
        <div class="settings-layout-grid">
            <!-- Coluna Principal: Provedor e Credenciais -->
            <div class="settings-card provider-selection-card">
                <div class="card-header-styled">
                    <div class="header-icon-pill">💳</div>
                    <div>
                        <h2 class="card-title">Provedor de Pagamento</h2>
                        <p class="card-subtitle">Escolha o gateway responsável por gerar os QR Codes e receber as notificações.</p>
                    </div>
                </div>

                <div class="provider-options-grid">
                    <div class="provider-radio-card @(_selectedProvider == PaymentGatewayProviderConstants.PagarMe ? "selected" : "")"
                         @onclick="() => SelectProvider(PaymentGatewayProviderConstants.PagarMe)">
                        <div class="provider-card-top">
                            <span class="provider-name">Pagar.me (Stone Co.)</span>
                            <span class="badge-recommended">RECOMENDADO</span>
                        </div>
                        <p class="provider-desc">Taxas competitivas, liquidação Pix veloz e integração nativa com o ecossistema Stone.</p>
                    </div>

                    <div class="provider-radio-card @(_selectedProvider == PaymentGatewayProviderConstants.MercadoPago ? "selected" : "")"
                         @onclick="() => SelectProvider(PaymentGatewayProviderConstants.MercadoPago)">
                        <div class="provider-card-top">
                            <span class="provider-name">Mercado Pago</span>
                            <span class="badge-neutral">ALTERNATIVO</span>
                        </div>
                        <p class="provider-desc">Integração padrão com conta PJ e checkout Pix do Mercado Pago.</p>
                    </div>

                    <div class="provider-radio-card @(_selectedProvider == PaymentGatewayProviderConstants.Simulated ? "selected" : "")"
                         @onclick="() => SelectProvider(PaymentGatewayProviderConstants.Simulated)">
                        <div class="provider-card-top">
                            <span class="provider-name">Ambiente Simulado</span>
                            <span class="badge-dev">TESTES / HOMOLOGAÇÃO</span>
                        </div>
                        <p class="provider-desc">Gera códigos Pix fictícios no padrão Bacen sem movimentação financeira real.</p>
                    </div>
                </div>

                @if (_selectedProvider == PaymentGatewayProviderConstants.PagarMe)
                {
                    <div class="credentials-section">
                        <div class="section-divider"></div>
                        <h3 class="section-subtitle">Credenciais da API Pagar.me v5</h3>

                        <div class="form-group">
                            <label class="form-label" for="pagarme-secret-key">
                                Chave Secreta da API (Secret Key) <span class="required">*</span>
                            </label>
                            <div class="input-password-wrapper">
                                <input id="pagarme-secret-key"
                                       type="@(_showSecretKey ? "text" : "password")"
                                       class="form-input @(!string.IsNullOrWhiteSpace(_secretKeyError) ? "input-error" : "")"
                                       placeholder="@(_config?.HasSecretKey == true ? "••••••••••••••••••••••••••••••••" : "sk_test_... ou sk_...")"
                                       @bind="_secretKeyInput"
                                       @bind:event="oninput" />
                                <button type="button"
                                        class="button-toggle-visibility"
                                        @onclick="() => _showSecretKey = !_showSecretKey"
                                        title="@(_showSecretKey ? "Ocultar chave" : "Exibir chave")">
                                    @(_showSecretKey ? "👁️" : "🔒")
                                </button>
                            </div>
                            @if (_config?.HasSecretKey == true && string.IsNullOrWhiteSpace(_secretKeyInput))
                            {
                                <div class="key-status-hint">
                                    <span class="key-status-badge">✅ Chave ativa gravada: @_config.PagarMeSecretKeyMasked</span>
                                    <span class="key-status-text">(Deixe em branco para manter a chave atual)</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_secretKeyError))
                            {
                                <span class="field-error-text">@_secretKeyError</span>
                            }
                            <span class="form-help-text">
                                Localize no Dashboard Pagar.me em <strong>Configurações &gt; Chaves de API</strong>. Criptografada com AES-GCM 256 bits.
                            </span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="pagarme-public-key">Chave Pública da API (Public Key)</label>
                            <input id="pagarme-public-key"
                                   type="text"
                                   class="form-input"
                                   placeholder="pk_test_... ou pk_..."
                                   @bind="_publicKeyInput" />
                            <span class="form-help-text">Utilizada para validações e identificação pública da sua conta na Pagar.me.</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="pagarme-webhook-secret">Segredo do Webhook (Opcional)</label>
                            <div class="input-password-wrapper">
                                <input id="pagarme-webhook-secret"
                                       type="@(_showWebhookSecret ? "text" : "password")"
                                       class="form-input"
                                       placeholder="@(_config?.HasWebhookSecret == true ? "••••••••••••••••" : "Segredo de assinatura configurado no webhook")"
                                       @bind="_webhookSecretInput" />
                                <button type="button"
                                        class="button-toggle-visibility"
                                        @onclick="() => _showWebhookSecret = !_showWebhookSecret">
                                    @(_showWebhookSecret ? "👁️" : "🔒")
                                </button>
                            </div>
                            <span class="form-help-text">Chave secreta de autenticação de webhooks para proteção criptográfica adicional.</span>
                        </div>
                    </div>
                }

                <div class="form-group toggle-group">
                    <label class="toggle-container">
                        <input type="checkbox" @bind="_isActive" />
                        <span class="toggle-slider"></span>
                        <span class="toggle-label">Habilitar emissão de cobranças Pix neste estabelecimento</span>
                    </label>
                </div>

                <div class="card-actions-bar">
                    <button type="button"
                            class="button button-outline"
                            disabled="@_isTesting"
                            @onclick="TestConnectionAsync">
                        @if (_isTesting)
                        {
                            <span class="button-spinner"></span>
                            <span>Testando Conexão...</span>
                        }
                        else
                        {
                            <span>🧪 Testar Conexão</span>
                        }
                    </button>

                    <button type="button"
                            class="button button-primary"
                            disabled="@_isSaving"
                            @onclick="SaveSettingsAsync">
                        @if (_isSaving)
                        {
                            <span class="button-spinner"></span>
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <span>Salvar Configurações</span>
                        }
                    </button>
                </div>

                @if (_testResult is not null)
                {
                    <div class="test-feedback-card @(_testResult.Success ? "feedback-success" : "feedback-error")">
                        <div class="feedback-icon">@(_testResult.Success ? "✅" : "⚠️")</div>
                        <div class="feedback-content">
                            <div class="feedback-title">@(_testResult.Success ? "Conexão Validada com Sucesso" : "Falha na Verificação da Conexão")</div>
                            <p class="feedback-msg">@_testResult.Message</p>
                            <span class="feedback-time">Testado às @_testResult.TestedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Coluna Lateral: Guia do Webhook & Status -->
            <div class="settings-sidebar-column">
                <div class="settings-card webhook-guide-card">
                    <div class="card-header-styled">
                        <div class="header-icon-pill">🔔</div>
                        <div>
                            <h3 class="card-title">Webhook de Notificação</h3>
                            <p class="card-subtitle">Receba a confirmação dos pagamentos automaticamente.</p>
                        </div>
                    </div>

                    <p class="guide-text">
                        Para que o Lavaway confirme o recebimento do Pix e baixe a Ordem de Serviço na hora, cadastre a URL abaixo no painel da sua conta Pagar.me:
                    </p>

                    <div class="webhook-url-box">
                        <label class="url-label">URL exclusiva do seu estabelecimento:</label>
                        <div class="url-copy-wrapper">
                            <input type="text"
                                   readonly
                                   class="url-input"
                                   value="@(_config?.WebhookUrl ?? "Carregando...")" />
                            <button type="button"
                                    class="button-copy @(_isUrlCopied ? "copied" : "")"
                                    @onclick="CopyWebhookUrlAsync">
                                @(_isUrlCopied ? "Copiado! ✓" : "Copiar")
                            </button>
                        </div>
                    </div>

                    <div class="guide-steps-list">
                        <div class="step-item">
                            <span class="step-num">1</span>
                            <span>Acesse o <strong>Dashboard da Pagar.me</strong> &gt; <strong>Configurações</strong> &gt; <strong>Webhooks</strong>.</span>
                        </div>
                        <div class="step-item">
                            <span class="step-num">2</span>
                            <span>Clique em <strong>Criar Webhook</strong> e cole a URL acima.</span>
                        </div>
                        <div class="step-item">
                            <span class="step-num">3</span>
                            <span>Marque os eventos <code>charge.paid</code> e <code>order.paid</code> e salve.</span>
                        </div>
                    </div>
                </div>

                <div class="settings-card security-info-card">
                    <div class="security-badge-header">
                        <span class="lock-icon">🔒</span>
                        <h4>Segurança &amp; Isolamento</h4>
                    </div>
                    <ul class="security-features-list">
                        <li><strong>Criptografia em Repouso:</strong> Chaves protegidas por criptografia militar AEAD AES-GCM.</li>
                        <li><strong>Conta Direta:</strong> O dinheiro das OS é depositado diretamente na conta bancária vinculada ao seu CNPJ na Pagar.me.</li>
                        <li><strong>Idempotência:</strong> O sistema previne baixas duplicadas de uma mesma transação.</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isTesting;
    private bool _isUrlCopied;
    private bool _showSecretKey;
    private bool _showWebhookSecret;

    private TenantPaymentGatewayConfigDto? _config;
    private string _selectedProvider = PaymentGatewayProviderConstants.PagarMe;
    private string _secretKeyInput = string.Empty;
    private string _publicKeyInput = string.Empty;
    private string _webhookSecretInput = string.Empty;
    private bool _isActive = true;

    private string? _secretKeyError;
    private TestTenantGatewayConnectionResultDto? _testResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _isLoading = true;
        try
        {
            _config = await BillingApi.GetGatewayConfigAsync();
            if (_config is not null)
            {
                _selectedProvider = _config.Provider;
                _publicKeyInput = _config.PagarMePublicKey ?? string.Empty;
                _isActive = _config.IsActive;

                if (_config.LastTestedAtUtc.HasValue && _config.LastTestSuccess.HasValue)
                {
                    _testResult = new TestTenantGatewayConnectionResultDto(
                        _config.LastTestSuccess.Value,
                        _config.LastTestMessage ?? string.Empty,
                        _config.LastTestedAtUtc.Value);
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao carregar configurações de pagamento: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectProvider(string provider)
    {
        _selectedProvider = provider;
        _secretKeyError = null;
    }

    private async Task SaveSettingsAsync()
    {
        _secretKeyError = null;

        if (_selectedProvider == PaymentGatewayProviderConstants.PagarMe &&
            _config?.HasSecretKey != true &&
            string.IsNullOrWhiteSpace(_secretKeyInput))
        {
            _secretKeyError = "A Chave Secreta da Pagar.me é obrigatória para este provedor.";
            return;
        }

        _isSaving = true;
        try
        {
            var request = new SaveTenantPaymentGatewayConfigRequest(
                Provider: _selectedProvider,
                PagarMePublicKey: string.IsNullOrWhiteSpace(_publicKeyInput) ? null : _publicKeyInput.Trim(),
                PagarMeSecretKey: string.IsNullOrWhiteSpace(_secretKeyInput) ? null : _secretKeyInput.Trim(),
                PagarMeWebhookSecret: string.IsNullOrWhiteSpace(_webhookSecretInput) ? null : _webhookSecretInput.Trim(),
                IsActive: _isActive);

            _config = await BillingApi.SaveGatewayConfigAsync(request);
            _secretKeyInput = string.Empty;
            _webhookSecretInput = string.Empty;
            ToastService.ShowSuccess("Configurações do gateway de pagamento salvas com sucesso!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao salvar configurações: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        _isTesting = true;
        _testResult = null;

        try
        {
            var request = new TestTenantGatewayConnectionRequest(
                Provider: _selectedProvider,
                PagarMeSecretKey: string.IsNullOrWhiteSpace(_secretKeyInput) ? null : _secretKeyInput.Trim());

            _testResult = await BillingApi.TestGatewayConnectionAsync(request);
            if (_testResult.Success)
            {
                ToastService.ShowSuccess("Conexão com a Pagar.me autenticada com sucesso!");
            }
            else
            {
                ToastService.ShowWarning("Aviso: Teste de conexão não obteve sucesso. Verifique as credenciais.");
            }
        }
        catch (Exception ex)
        {
            _testResult = new TestTenantGatewayConnectionResultDto(
                Success: false,
                Message: $"Falha ao testar conexão: {ex.Message}",
                TestedAtUtc: DateTimeOffset.UtcNow);
            ToastService.ShowError($"Erro no teste: {ex.Message}");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task CopyWebhookUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_config?.WebhookUrl)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _config.WebhookUrl);
            _isUrlCopied = true;
            ToastService.ShowSuccess("URL do Webhook copiada para a área de transferência!");
            StateHasChanged();

            await Task.Delay(3000);
            _isUrlCopied = false;
            StateHasChanged();
        }
        catch
        {
            ToastService.ShowInfo("Não foi possível copiar automaticamente. Selecione e copie manualmente.");
        }
    }
}
