@page "/termos"
@page "/terms"
@layout LandingLayout

<PageTitle>Termos de Uso do Serviço | Lava Aê</PageTitle>

<div class="legal-page-container">
    <!-- TOP NAVIGATION BAR -->
    <header class="legal-header">
        <div class="legal-header-inner">
            <a href="/" class="brand-link" aria-label="Voltar para a página inicial do Lava Aê">
