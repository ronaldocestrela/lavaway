        {
          "@@type": "SoftwareApplication",
          "name": "Lava Aê - Gestão e Comissão de Equipe",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS (Cloud SaaS)",
          "offers": {
            "@@type": "Offer",
            "price": "299.00",
            "priceCurrency": "BRL",
            "description": "Cálculo de comissões liberado a partir do plano Pro (R$ 299/mês até 10 colaboradores) e Enterprise (R$ 599/mês colaboradores ilimitados)."
          },
          "description": "Sistema de rateio e apuração automática de comissões para lavadores, polidores e funcionários de lava-jatos e estética automotiva baseado no fluxo de pátio."
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Início",
              "item": "https://lavaae.app/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Soluções",
              "item": "https://lavaae.app/#recursos"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Comissão de Equipe",
              "item": "https://lavaae.app/funcionalidades/comissao-equipe"
            }
          ]
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Como a comissão é calculada quando dois lavadores limpam o mesmo carro?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O sistema suporta atribuição individual ou compartilhada por serviço. A comissão pode ser dividida igualmente entre os operadores ou atribuída especificamente por etapa executada (ex: lavagem externa para um, higienização interna para outro)."
              }
            },
            {
              "@@type": "Question",
              "name": "Consigo configurar porcentagem diferente para polidores e lavadores simples?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Você pode definir regras de comissão por serviço (ex: 20% em polimento técnico e R$ 10 fixos em lavagem simples) ou por cargo/colaborador, trazendo total flexibilidade para a sua política de remuneração."
              }
            },
            {
              "@@type": "Question",
              "name": "O operador consegue ver quanto ganhou de comissão no dia?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Com o login de operador, cada colaborador pode acompanhar o seu próprio extrato diário de carros finalizados e comissões acumuladas, gerando motivação e transparência absoluta."
              }
            },
            {
              "@@type": "Question",
              "name": "A comissão desconta se o serviço sofrer refação por erro?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Como o sistema rastreia os motivos de refação no controle de qualidade, o gestor tem a visibilidade exata de quais veículos tiveram retrabalho antes de autorizar o fechamento e pagamento das comissões."
              }
            },
            {
              "@@type": "Question",
              "name": "Em quais planos o cálculo de comissões está liberado?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O módulo de comissões por serviço e cargo está disponível a partir do plano Pro (R$ 299/mês para até 10 colaboradores) e no plano Enterprise (R$ 599/mês ilimitado)."
              }
            }
          ]
        }
      ]
