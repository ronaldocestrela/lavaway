    <meta name="twitter:title" content="Cálculo de Comissão de Lavadores para Lava-Jato | Lava Aê" />
    <meta name="twitter:description" content="Comissão automática por lavagem e polimento vinculada ao Kanban. Gestão de equipe justa e transparente." />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
