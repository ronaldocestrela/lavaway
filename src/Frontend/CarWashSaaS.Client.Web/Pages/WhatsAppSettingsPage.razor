@page "/settings/whatsapp"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator")]
@implements IDisposable
@inject WhatsAppApiClient WhatsAppApi
@inject IToastService ToastService

<PageTitle>Pareamento &amp; Mensageria WhatsApp | Lavaway</PageTitle>

<section class="whatsapp-page">
    <PageHeading Eyebrow="COMUNICAÇÃO &amp; MENSAGERIA"
                 Title="Canal Oficial do WhatsApp"
                 Subtitle="Configure o canal oficial do WhatsApp da sua loja, monitore quotas anti-ban, envie mensagens de teste e acompanhe a entrega em tempo real." />

    @if (_isLoading)
    {
        <div class="loading-state" role="status">
            <span class="button-spinner" aria-hidden="true"></span>
            <span>Carregando estado do canal do WhatsApp...</span>
        </div>
    }
    else
    {
        <div class="section-container">
            <WhatsAppPairingCard Connection="@_connection"
                                 IsLoading="@_isActionLoading"
                                 ErrorMessage="@_cardErrorMessage"
                                 OnStartPairing="StartPairingAsync"
                                 OnRefreshPairing="RefreshPairingAsync"
                                 OnDisconnect="DisconnectAsync" />

            @if (_connection?.IsConnected == true)
            {
                <WhatsAppQuotaMeter Quota="@_quota" />

                <WhatsAppTestMessageCard IsConnected="@_connection.IsConnected"
                                         IsSending="@_isSendingTest"
                                         FeedbackMessage="@_testFeedbackMessage"
                                         IsSuccessFeedback="@_isTestFeedbackSuccess"
                                         OnSendTestMessage="SendTestMessageAsync" />

                <WhatsAppMessageHistoryTable Messages="@_messages"
                                             IsLoading="@_isLoadingMessages"
                                             OnRefresh="LoadMessagesAndQuotaAsync" />
            }
        </div>
    }
</section>

@code {
    private WhatsAppConnectionDto? _connection;
    private WhatsAppQuotaDto? _quota;
    private IReadOnlyList<WhatsAppMessageDto>? _messages;
    private bool _isLoading = true;
    private bool _isActionLoading = false;
    private bool _isSendingTest = false;
    private bool _isLoadingMessages = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _cardErrorMessage;
    private string? _testFeedbackMessage;
    private bool _isTestFeedbackSuccess = false;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadStatusAsync();

        if (_connection?.IsConnected == true)
        {
            await LoadMessagesAndQuotaAsync();
        }
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            _connection = await WhatsAppApi.GetStatusAsync(_cts?.Token ?? CancellationToken.None);

            if (_connection?.IsConnecting == true)
            {
                StartPolling();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível consultar o status do WhatsApp: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMessagesAndQuotaAsync()
    {
        try
        {
            _isLoadingMessages = true;
            var token = _cts?.Token ?? CancellationToken.None;
            var quotaTask = WhatsAppApi.GetQuotaAsync(token);
            var messagesTask = WhatsAppApi.GetRecentMessagesAsync(20, token);

            await Task.WhenAll(quotaTask, messagesTask);
            _quota = await quotaTask;
            _messages = await messagesTask;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Falha ao carregar métricas de mensageria: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isLoadingMessages = false;
        }
    }

    private async Task StartPairingAsync()
    {
        try
        {
            _isActionLoading = true;
            _cardErrorMessage = null;
            _errorMessage = null;
            _successMessage = null;

            _connection = await WhatsAppApi.StartPairingAsync(_cts?.Token ?? CancellationToken.None);
            _successMessage = "Sessão iniciada! Aponte a câmera do seu celular para o QR Code.";
            ToastService.ShowSuccess(_successMessage);
            
            StartPolling();
        }
        catch (Exception ex)
        {
            _cardErrorMessage = ex.Message;
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isActionLoading = false;
        }
    }

    private async Task RefreshPairingAsync()
    {
        try
        {
            _isActionLoading = true;
            _cardErrorMessage = null;
            _errorMessage = null;
            _successMessage = null;

            _connection = await WhatsAppApi.RefreshPairingAsync(_cts?.Token ?? CancellationToken.None);
            _successMessage = "QR Code atualizado com sucesso.";
            ToastService.ShowSuccess(_successMessage);

            StartPolling();
        }
        catch (Exception ex)
        {
            _cardErrorMessage = ex.Message;
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isActionLoading = false;
        }
    }

    private async Task DisconnectAsync()
    {
        try
        {
            _isActionLoading = true;
            _cardErrorMessage = null;
            _errorMessage = null;
            _successMessage = null;

            StopPolling();

            _connection = await WhatsAppApi.DisconnectAsync(_cts?.Token ?? CancellationToken.None);
            _successMessage = "Instância desconectada com sucesso.";
            ToastService.ShowSuccess(_successMessage);
            _quota = null;
            _messages = null;
        }
        catch (Exception ex)
        {
            _cardErrorMessage = ex.Message;
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isActionLoading = false;
        }
    }

    private async Task SendTestMessageAsync(SendWhatsAppTestMessageRequest request)
    {
        try
        {
            _isSendingTest = true;
            _testFeedbackMessage = null;

            var result = await WhatsAppApi.SendTestMessageAsync(request, _cts?.Token ?? CancellationToken.None);
            _isTestFeedbackSuccess = true;
            _testFeedbackMessage = $"Mensagem disparada com sucesso! Status inicial: '{result.Status}'. Acompanhe no histórico abaixo.";
            ToastService.ShowSuccess(_testFeedbackMessage);
            
            await LoadMessagesAndQuotaAsync();
        }
        catch (Exception ex)
        {
            _isTestFeedbackSuccess = false;
            _testFeedbackMessage = $"Falha ao disparar mensagem de teste: {ex.Message}";
            ToastService.ShowError(_testFeedbackMessage);
        }
        finally
        {
            _isSendingTest = false;
        }
    }

    private void StartPolling()
    {
        StopPolling();
        _ = RunPollingLoopAsync();
    }

    private void StopPolling()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
    }

    private async Task RunPollingLoopAsync()
    {
        var token = _cts?.Token ?? CancellationToken.None;

        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(3000, token);
                if (token.IsCancellationRequested)
                {
                    break;
                }

                var latest = await WhatsAppApi.GetStatusAsync(token);
                if (latest is not null)
                {
                    _connection = latest;
                    await InvokeAsync(StateHasChanged);

                    if (latest.IsConnected)
                    {
                        _successMessage = "WhatsApp conectado com sucesso! O canal da loja está ativo.";
                        ToastService.ShowSuccess(_successMessage);
                        await LoadMessagesAndQuotaAsync();
                        await InvokeAsync(StateHasChanged);
                        break;
                    }

                    if (latest.IsDisconnected)
                    {
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Ignora erros transitórios no loop de polling em background
            }
        }
    }

    public void Dispose()
    {
        StopPolling();
    }
}
