@page "/funcionalidades/pos-venda-e-fidelidade"
@layout LandingLayout

<PageTitle>Clube de Assinaturas e Fidelidade para Lava-Jato | Lava Aê</PageTitle>

<HeadContent>
    <meta name="description" content="Clube de assinaturas recorrentes por placa e cartão fidelidade digital com selos no WhatsApp para lava-jato e estética. Reative clientes sumidos e garanta receita previsível todo mês." />
    <link rel="canonical" href="https://lavaae.app/funcionalidades/pos-venda-e-fidelidade" />
    <meta property="og:title" content="Clube de Assinaturas e Fidelidade para Lava-Jato | Lava Aê" />
    <meta property="og:description" content="Recorrência mensal vinculada à placa, cartão fidelidade digital com selos no WhatsApp, pesquisa de satisfação 1h após a entrega e reativação automática de clientes sumidos." />
    <meta property="og:url" content="https://lavaae.app/funcionalidades/pos-venda-e-fidelidade" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://lavaae.app/icon-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Clube de Assinaturas e Fidelidade para Lava-Jato | Lava Aê" />
    <meta name="twitter:description" content="Clube de assinaturas por placa e fidelidade no WhatsApp. Transforme clientes eventuais em mensalistas fiéis no seu lava-jato." />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "Lava Aê - Pós-Venda, Fidelidade & Clubes de Assinatura",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS (Cloud SaaS)",
          "offers": {
            "@@type": "Offer",
            "price": "299.00",
            "priceCurrency": "BRL",
            "description": "Clubes de assinatura por placa, cartão fidelidade digital e automação de pós-venda liberados a partir do plano Pro (R$ 299/mês com até 1.500 msgs) e Enterprise (R$ 599/mês ilimitado)."
          },
          "description": "Plataforma de fidelização e receita recorrente para lava-jatos e estética automotiva com clubes de lavagem mensal vinculados à placa do veículo, cartões fidelidade digitais com selos no WhatsApp, pesquisas de satisfação de 1 a 5 estrelas e recuperação de clientes inativos."
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Início",
              "item": "https://lavaae.app/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Soluções",
              "item": "https://lavaae.app/#recursos"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Pós-Venda & Fidelidade",
              "item": "https://lavaae.app/funcionalidades/pos-venda-e-fidelidade"
            }
          ]
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Como funciona o clube de assinaturas mensal vinculado à placa?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O cliente assina um plano mensal (ex: 4 lavagens por mês ou lavagens ilimitadas) que fica atrelado diretamente à placa do veículo dele. Ao dar entrada no pátio, o sistema reconhece a assinatura ativa e debita o crédito automaticamente sem cobrança avulsa."
              }
            },
            {
              "@@type": "Question",
              "name": "O cliente precisa de cartão de papel para juntar selos de fidelidade?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O cartão fidelidade é 100% digital. A cada serviço concluído, o cliente recebe um aviso no WhatsApp com a quantidade atualizada de selos (ex: 'Você completou 7 de 10 selos!'). Ele pode consultar o saldo a qualquer momento digitando FIDELIDADE ou SELOS."
              }
            },
            {
              "@@type": "Question",
              "name": "Como funciona a pesquisa de satisfação após a retirada do carro?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Exatamente 1 hora após o veículo ser retirado do pátio, o sistema dispara uma pesquisa rápida no WhatsApp de 1 a 5 estrelas. Caso o cliente avalie com nota baixa (1 a 3 estrelas), um alerta imediato é gerado para a gerência intervir antes de uma avaliação pública negativa."
              }
            },
            {
              "@@type": "Question",
              "name": "Como a plataforma recupera clientes sumidos que não voltam há semanas?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O sistema monitora o tempo sem visita e envia convites automáticos aos 15, 30 ou 45 dias com ofertas de retorno. O disparo respeita intervalos de segurança de 7 dias, exclui automaticamente quem já possui agendamento ou OS aberta e honra opt-out imediato caso o motorista digite PARAR ou SAIR."
              }
            },
            {
              "@@type": "Question",
              "name": "Em quais planos do Lava Aê o clube de assinaturas e a fidelidade estão disponíveis?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Os clubes de assinatura por placa, cartão fidelidade digital com selos e campanhas automáticas de reativação estão liberados a partir do plano Pro (R$ 299/mês) e no plano Enterprise (R$ 599/mês)."
              }
            }
          ]
        }
      ]
    }
    </script>
</HeadContent>

<div class="solution-page">
    <!-- TOP STICKY BAR -->
    <header class="solution-navbar">
        <div class="solution-container navbar-inner">
            <a href="/" class="brand-link" aria-label="Ir para a página inicial do Lava Aê">
                <img src="/icon-192.png" alt="Lava Aê" width="32" height="32" class="brand-logo" />
                <span class="brand-name">Lava Aê</span>
            </a>

            <div class="navbar-actions">
                <a href="/#planos" class="nav-link-subtle">Ver Planos</a>
                <a href="/authentication/login" class="btn-login-ghost">Entrar</a>
                <a href="/authentication/login" class="btn-top-cta">Testar 14 Dias Grátis</a>
            </div>
        </div>
    </header>

    <main class="solution-main">
        <!-- HERO SECTION -->
        <section class="hero-solution">
            <div class="solution-container">
                <nav class="breadcrumb-trail" aria-label="Breadcrumb">
                    <a href="/">Início</a>
                    <span class="separator">/</span>
                    <a href="/#recursos">Soluções</a>
                    <span class="separator">/</span>
                    <span class="current">Pós-Venda & Fidelidade</span>
                </nav>

                <div class="hero-badge">
                    <span class="badge-dot"></span>
                    <span>RECEITA RECORRENTE E RETENÇÃO DE CLIENTES</span>
                </div>

                <h1 class="hero-heading">
                    Clube de assinaturas e fidelidade para lava-jato: <span class="highlight-text">receita garantida todo mês e clientes voltando sempre</span>.
                </h1>

                <p class="hero-lead">
                    Pare de depender apenas do sol de sábado para faturar. Crie planos de lavagem mensal vinculados à placa do veículo, acumule selos de fidelidade automáticos no WhatsApp e traga de volta clientes sumidos há 30 dias sem esforço manual.
                </p>

                <div class="hero-cta-group">
                    <a href="/authentication/login" class="btn-primary-action">
                        <span>Criar Meu Clube Grátis por 14 Dias</span>
                        <span class="arrow">&rarr;</span>
                    </a>
                    <a href="#comparativo" class="btn-secondary-action">
                        <span>Ver Comparativo com Cartão de Papel</span>
                    </a>
                </div>

                <div class="hero-trust-bar">
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>Assinatura vinculada à placa (sem fraudes de troca de carro)</span>
                    </div>
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>Selos digitais automáticos no WhatsApp</span>
                    </div>
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>Reativação inteligente aos 15, 30 e 45 dias</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ANSWER-FIRST BLOCK (GEO / IA OVERVIEWS) -->
        <section class="answer-first-section">
            <div class="solution-container">
                <div class="answer-card">
                    <div class="answer-badge">RESPOSTA DIRETA PARA GESTORES</div>
                    <h2 class="answer-title">O que é e como funciona o Clube e Fidelidade no Lava Aê?</h2>
                    <p class="answer-paragraph">
                        O <strong>Pós-Venda, Fidelidade & Clube de Assinaturas do Lava Aê</strong> é uma suíte de retenção que transforma clientes eventuais em receita previsível. Ele permite criar planos mensais vinculados à placa do veículo, cartões de selos digitais no WhatsApp, pesquisas de satisfação de 1 a 5 estrelas enviadas 1 hora após a retirada e campanhas automáticas para resgatar motoristas sumidos há 15, 30 ou 45 dias.
                    </p>
                </div>
            </div>
        </section>

        <!-- OPERATIONAL COMPARISON TABLE -->
        <section class="comparison-section" id="comparativo">
            <div class="solution-container">
                <div class="section-header">
                    <span class="section-tag">CONFRONTO OPERACIONAL</span>
                    <h2 class="section-title">Cartãozinho de papel no porta-luvas vs. Fidelização digital</h2>
                    <p class="section-subtitle">
                        Descubra por que a maioria dos programas de fidelidade tradicionais falham e como a recorrência no WhatsApp muda o seu jogo.
                    </p>
                </div>

                <div class="table-wrapper">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th scope="col" class="col-metric">Situação da Loja</th>
                                <th scope="col" class="col-legacy">Cartão de Papel / Pós-Venda Esquecido</th>
                                <th scope="col" class="col-lavaae">Fidelidade e Clubes Lava Aê</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="metric-name">Fidelidade e Selos</td>
                                <td class="legacy-val">Cartão de papel carimbado que o cliente perde na primeira chuva, esquece em casa ou falsifica com caneta.</td>
                                <td class="lavaae-val"><strong>Selos 100% digitais no WhatsApp:</strong> a cada lavagem o cliente recebe o saldo de selos e consulta quando quiser via comando.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Faturamento em Dias de Chuva</td>
                                <td class="legacy-val">Pista vazia, desespero para pagar o aluguel e dependência total de finais de semana ensolarados.</td>
                                <td class="lavaae-val"><strong>Receita mensal previsível (Clube):</strong> mensalidades recorrentes debitadas todo mês caem na sua conta mesmo se chover a semana toda.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Controle da Placa Assinante</td>
                                <td class="legacy-val">Cliente compra pacote mensal e traz o carro da esposa, do irmão e do amigo para lavar na mesma conta.</td>
                                <td class="lavaae-val"><strong>Trava estrita por placa:</strong> o benefício do clube fica amarrado à placa cadastrada; se for outro carro, cobra valor avulso.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Clientes Sumidos (Inativos)</td>
                                <td class="legacy-val">O cliente para de frequentar e você só percebe 4 meses depois, quando ele já acostumou a lavar no concorrente do bairro.</td>
                                <td class="lavaae-val"><strong>Reativação automática no WhatsApp:</strong> mensagens inteligentes aos 15, 30 ou 45 dias convidando o cliente a voltar com oferta especial.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Pesquisa de Satisfação e Reclamações</td>
                                <td class="legacy-val">Cliente insatisfeito com um vidro manchado não fala nada na saída, vai para a internet e posta nota 1 no Google Meu Negócio.</td>
                                <td class="lavaae-val"><strong>Pesquisa 1h após a retirada:</strong> notas de 1 a 3 geram alerta urgente para o gerente ligar e resolver antes do cliente reclamar na web.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- STEP BY STEP ON THE TRACK -->
        <section class="workflow-section">
            <div class="solution-container">
                <div class="section-header">
                    <span class="section-tag">CICLO DE RETENÇÃO</span>
                    <h2 class="section-title">Como a máquina de fidelização opera sem tomar seu tempo</h2>
                    <p class="section-subtitle">
                        Automação de ponta a ponta desde a entrega do veículo até o retorno do cliente no mês seguinte.
                    </p>
                </div>

                <div class="steps-grid">
                    <div class="step-card">
                        <div class="step-number">01</div>
                        <h3 class="step-title">Pesquisa Rápida no WhatsApp</h3>
                        <p class="step-description">
                            1 hora após o cliente retirar o veículo limpo, o robô envia: <em>"Como foi sua experiência hoje de 1 a 5 estrelas?"</em>. Respostas baixas alertam a gerência imediatamente.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">02</div>
                        <h3 class="step-title">Selo de Fidelidade Automático</h3>
                        <p class="step-description">
                            Junto com a confirmação, o motorista vê seu cartão de fidelidade digital: <em>"Você acumulou 8 de 10 selos para ganhar uma lavagem com cera grátis!"</em>.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">03</div>
                        <h3 class="step-title">Convite para o Clube de Assinatura</h3>
                        <p class="step-description">
                            Clientes recorrentes recebem o convite para assinar o clube da loja: lavagens garantidas no mês por um valor fixo debitado na placa do carro.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">04</div>
                        <h3 class="step-title">Resgate de Clientes Ausentes</h3>
                        <p class="step-description">
                            Se o motorista não voltar em 30 dias, o sistema envia automaticamente uma mensagem amigável no WhatsApp lembrando de cuidar do carro, enchendo sua pista na terça-feira.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- TECHNICAL SPECS & PLAN INCLUSION -->
        <section class="specs-section">
            <div class="solution-container">
                <div class="specs-box">
                    <div class="specs-header">
                        <span class="specs-badge">ESPECIFICAÇÕES TÉCNICAS E PLANOS</span>
                        <h2 class="specs-title">Retenção de clientes projetada para a rotina automotiva</h2>
                        <p class="specs-lead">
                            Diga adeus ao trabalho manual de mandar mensagens uma a uma e tenha um fluxo profissional de pós-venda.
                        </p>
                    </div>

                    <div class="specs-columns">
                        <div class="spec-col">
                            <h3 class="spec-group-title">Módulos Inclusos</h3>
                            <ul class="spec-list">
                                <li><strong>Clubes de Assinatura por Placa:</strong> Planos mensais com limites de lavagens ou créditos acumuláveis.</li>
                                <li><strong>Cartão Fidelidade com Selos Digitais:</strong> Recompensa configurável (ex: a cada 10 lavagens, 1 grátis).</li>
                                <li><strong>Pesquisa de Satisfação NPS (1 a 5 estrelas):</strong> Disparo automático 1h após a retirada com alerta de notas baixas.</li>
                                <li><strong>Reativação com Filtros Inteligentes:</strong> Disparos aos 15, 30 e 45 dias com intervalo de proteção de 7 dias.</li>
                                <li><strong>Proteção Anti-Spam com Opt-Out:</strong> O sistema respeita se o cliente digitar <code>PARAR</code> ou <code>SAIR</code>.</li>
                                <li><strong>Exclusão de OS Aberta:</strong> Clientes com carro no pátio ou agendamento marcado não recebem mensagens de reativação.</li>
                            </ul>
                        </div>

                        <div class="spec-col">
                            <h3 class="spec-group-title">Disponibilidade nos Planos</h3>
                            <div class="plan-availability-card">
                                <div class="plan-row">
                                    <span class="plan-name">Plano Básico (R$ 149/mês)</span>
                                    <span class="plan-status-basic">Pesquisa Manual + Notificações Básicas</span>
                                </div>
                                <div class="plan-row active">
                                    <span class="plan-name">Plano Pro (R$ 299/mês)</span>
                                    <span class="plan-status">Clubes por Placa + Selos + Reativação 24/7</span>
                                </div>
                                <div class="plan-row active">
                                    <span class="plan-name">Plano Enterprise (R$ 599/mês)</span>
                                    <span class="plan-status">Recursos de Fidelidade e Clubes Ilimitados</span>
                                </div>
                            </div>
                            <p class="plan-note">
                                * O módulo de clubes de assinatura mensal por placa, o cartão fidelidade digital com selos automáticos e as campanhas de reativação aos 15, 30 e 45 dias estão liberados a partir do Plano Pro.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ SECTION -->
        <section class="faq-section">
            <div class="solution-container">
                <div class="section-header">
                    <span class="section-tag">PERGUNTAS FREQUENTES</span>
                    <h2 class="section-title">Dúvidas sobre fidelidade e clubes de assinatura</h2>
                    <p class="section-subtitle">
                        Perguntas frequentes de gestores que desejam previsibilidade de caixa e clientes fiéis.
                    </p>
                </div>

                <div class="faq-list">
                    <details class="faq-item">
                        <summary class="faq-question">
                            <span>Como funciona o clube de assinaturas mensal vinculado à placa?</span>
                            <span class="faq-toggle">+</span>
                        </summary>
                        <div class="faq-answer">
                            <p>
                                O cliente assina um plano mensal (ex: 4 lavagens por mês ou lavagens ilimitadas) que fica atrelado diretamente à placa do veículo dele. Ao dar entrada no pátio, o sistema reconhece a assinatura ativa e debita o crédito automaticamente sem cobrança avulsa.
                            </p>
                        </div>
                    </details>

                    <details class="faq-item">
                        <summary class="faq-question">
                            <span>O cliente precisa de cartão de papel para juntar selos de fidelidade?</span>
                            <span class="faq-toggle">+</span>
                        </summary>
                        <div class="faq-answer">
                            <p>
                                Não. O cartão fidelidade é 100% digital. A cada serviço concluído, o cliente recebe um aviso no WhatsApp com a quantidade atualizada de selos (ex: 'Você completou 7 de 10 selos!'). Ele pode consultar o saldo a qualquer momento digitando FIDELIDADE ou SELOS.
                            </p>
                        </div>
                    </details>

                    <details class="faq-item">
                        <summary class="faq-question">
                            <span>Como funciona a pesquisa de satisfação após a retirada do carro?</span>
                            <span class="faq-toggle">+</span>
                        </summary>
                        <div class="faq-answer">
                            <p>
                                Exatamente 1 hora após o veículo ser retirado do pátio, o sistema dispara uma pesquisa rápida no WhatsApp de 1 a 5 estrelas. Caso o cliente avalie com nota baixa (1 a 3 estrelas), um alerta imediato é gerado para a gerência intervir antes de uma avaliação pública negativa.
                            </p>
                        </div>
                    </details>

                    <details class="faq-item">
                        <summary class="faq-question">
                            <span>Como a plataforma recupera clientes sumidos que não voltam há semanas?</span>
                            <span class="faq-toggle">+</span>
                        </summary>
                        <div class="faq-answer">
                            <p>
                                O sistema monitora o tempo sem visita e envia convites automáticos aos 15, 30 ou 45 dias com ofertas de retorno. O disparo respeita intervalos de segurança de 7 dias, exclui automaticamente quem já possui agendamento ou OS aberta e honra opt-out imediato caso o motorista digite PARAR ou SAIR.
                            </p>
                        </div>
                    </details>

                    <details class="faq-item">
                        <summary class="faq-question">
                            <span>Em quais planos do Lava Aê o clube de assinaturas e a fidelidade estão disponíveis?</span>
                            <span class="faq-toggle">+</span>
                        </summary>
                        <div class="faq-answer">
                            <p>
                                Os clubes de assinatura por placa, cartão fidelidade digital com selos e campanhas automáticas de reativação estão liberados a partir do plano Pro (R$ 299/mês) e no plano Enterprise (R$ 599/mês).
                            </p>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- FINAL RISK-FREE CTA -->
        <section class="final-cta-section">
            <div class="solution-container">
                <div class="final-cta-card">
                    <span class="cta-mini-tag">RECORRÊNCIA NA PRÁTICA</span>
                    <h2 class="final-cta-title">Comece o próximo mês sabendo exatamente quanto vai faturar</h2>
                    <p class="final-cta-subtitle">
                        Crie seu próprio clube de lavagem por assinatura e coloque seu pós-venda para rodar no automático. Experimente grátis por 14 dias.
                    </p>
                    <div class="final-cta-actions">
                        <a href="/authentication/login" class="btn-primary-action large">
                            <span>Testar Fidelidade & Clubes Grátis</span>
                            <span class="arrow">&rarr;</span>
                        </a>
                        <a href="https://wa.me/5575991897068?text=Quero%20criar%20um%20clube%20de%20assinatura%20no%20Lava%20Ae" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-ghost">
                            <span>Falar com Especialista de Fidelização</span>
                        </a>
                    </div>
                    <p class="final-cta-guarantee">
                        Não pedimos cartão de crédito no cadastro. Suporte humano para configurar seus primeiros planos no mesmo dia.
                    </p>
                </div>
            </div>
        </section>
    </main>

