@page "/funcionalidades/catalogo-de-servicos"
@layout LandingLayout

<PageTitle>Tabela de Preços por Porte para Lava-Rápido | Lava Aê</PageTitle>

<HeadContent>
    <meta name="description" content="Tabela de preços por porte de veículo para lava-jato e estética automotiva. Configure valores para Hatch, SUV, Picape e Moto, com cálculo de tempo de box e consulta no WhatsApp." />
    <link rel="canonical" href="https://lavaae.app/funcionalidades/catalogo-de-servicos" />
    <meta property="og:title" content="Tabela de Preços por Porte para Lava-Rápido | Lava Aê" />
    <meta property="og:description" content="Catálogo inteligente de serviços por porte de veículo. Preços claros, tempo de box estimado e autoatendimento de preços 24/7 no WhatsApp." />
    <meta property="og:url" content="https://lavaae.app/funcionalidades/catalogo-de-servicos" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://lavaae.app/icon-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tabela de Preços por Porte para Lava-Rápido | Lava Aê" />
    <meta name="twitter:description" content="Catálogo inteligente de lavagem automotiva por porte. Sem prejuízo lavando caminhonete pelo preço de carro popular." />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "Lava Aê - Catálogo de Serviços por Porte",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS (Cloud SaaS)",
          "offers": {
            "@@type": "Offer",
            "price": "149.00",
            "priceCurrency": "BRL",
            "description": "Catálogo completo de serviços por porte incluso em todos os planos a partir do Básico (R$ 149/mês)."
          },
          "description": "Módulo de precificação dinâmica por porte de veículos (Hatch/Sedan, SUV, Picape/Van e Moto) com estimativa de duração para lava-jatos e centros de estética automotiva."
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Início",
              "item": "https://lavaae.app/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Soluções",
              "item": "https://lavaae.app/#recursos"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Catálogo de Serviços",
              "item": "https://lavaae.app/funcionalidades/catalogo-de-servicos"
            }
          ]
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Quais são as categorias de porte suportadas no sistema?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O Lava Aê divide os veículos em 4 portes reais de pista: Hatch/Sedan (pequeno e médio), SUV (médio e grande), Picape/Van (veículos utilitários pesados) e Moto."
              }
            },
            {
              "@@type": "Question",
              "name": "O cliente consegue ver a tabela de preços direto pelo WhatsApp?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Ao mandar mensagem no WhatsApp da loja, o cliente escolhe o porte do veículo dele e o robô apresenta a tabela de preços atualizada na hora, evitando atendimentos manuais repetitivos."
              }
            },
            {
              "@@type": "Question",
              "name": "A duração do serviço também varia conforme o porte do carro?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Você pode definir tempos estimados de execução diferentes para cada porte, garantindo previsões de entrega realistas e bloqueio de capacidade de box na agenda."
              }
            },
            {
              "@@type": "Question",
              "name": "O preço da ordem de serviço muda se eu alterar o catálogo depois?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O preço e as condições contratadas são gravados de forma imutável na Ordem de Serviço no momento exato da abertura, garantindo segurança fiscal e jurídica."
              }
            },
            {
              "@@type": "Question",
              "name": "O catálogo por porte está liberado em todos os planos?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. O cadastro e gestão do catálogo de serviços por porte está disponível desde o plano Básico (R$ 149/mês), sem limites de itens cadastrados."
              }
            }
          ]
        }
      ]
    }
    </script>
</HeadContent>

<div class="solution-page">
