@page "/platform/metrics"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,PlatformAuditor,PlatformSupport,PlatformBillingAdmin")]
@inject PlatformObservabilityApiClient ObservabilityClient
@inject GlobalTenantApiClient GlobalTenantClient
@inject IToastService ToastService

<PageTitle>Métricas &amp; Observabilidade Global — Lavaway</PageTitle>

<div class="platform-metrics-page">
    <PageHeading Eyebrow="BACKOFFICE DA PLATAFORMA"
                 Title="Métricas &amp; Observabilidade Global"
                 Subtitle="Monitore receita recorrente (MRR/ARR/LTV), volume de veículos e Pix, webhooks e telemetria de mensageria.">
        <Actions>
            <div class="header-controls">
                <div class="period-selector">
                    <button type="button" @onclick='() => ChangeDaysWindow(7)'
                            class="btn-period @(SelectedDaysWindow == 7 ? "active" : "")">
                        7d
                    </button>
                    <button type="button" @onclick='() => ChangeDaysWindow(30)'
                            class="btn-period @(SelectedDaysWindow == 30 ? "active" : "")">
                        30d
                    </button>
                    <button type="button" @onclick='() => ChangeDaysWindow(90)'
                            class="btn-period @(SelectedDaysWindow == 90 ? "active" : "")">
                        90d
                    </button>
                    <button type="button" @onclick='() => ChangeDaysWindow(365)'
                            class="btn-period @(SelectedDaysWindow == 365 ? "active" : "")">
                        12m
                    </button>
                </div>

                <button type="button" @onclick="LoadOverviewAsync" disabled="@IsLoading" class="btn-refresh" id="btn-refresh-metrics">
                    <span class="@(IsLoading ? "spin-icon" : "")">↻</span>
                    <span>Atualizar</span>
                </button>
            </div>
        </Actions>
    </PageHeading>

    <!-- 4 Cards Executivos -->
    <section class="kpi-grid" aria-label="Indicadores Executivos da Plataforma">
        <!-- Card 1: MRR & ARR -->
        <div class="kpi-card">
            <div class="kpi-card-header">
                <span class="kpi-label">MRR / ARR</span>
                <span class="kpi-tag">Recorrência</span>
            </div>
            <strong class="kpi-value">R$ @(Overview?.SaasRevenue.Mrr.ToString("N2") ?? "0,00")</strong>
            <div class="kpi-footer">
                <span>ARR: R$ @(Overview?.SaasRevenue.Arr.ToString("N2") ?? "0,00")</span>
                <span class="text-rose font-bold">Churn: @(Overview?.SaasRevenue.ChurnRatePercentage.ToString("F1") ?? "0,0")%</span>
            </div>
        </div>

        <!-- Card 2: LTV & ARPU -->
        <div class="kpi-card">
            <div class="kpi-card-header">
                <span class="kpi-label">LTV MÉDIO</span>
                <span class="kpi-tag">Valor Vitalício</span>
            </div>
            <strong class="kpi-value text-emerald">R$ @(Overview?.SaasRevenue.Ltv.ToString("N2") ?? "0,00")</strong>
            <div class="kpi-footer">
                <span>Assinaturas: @(Overview?.SaasRevenue.ActiveSubscriptionsCount ?? 0)</span>
                <span>Trial: @(Overview?.SaasRevenue.TrialSubscriptionsCount ?? 0)</span>
            </div>
        </div>

        <!-- Card 3: Veículos Atendidos -->
        <div class="kpi-card">
            <div class="kpi-card-header">
                <span class="kpi-label">VEÍCULOS ATENDIDOS</span>
                <span class="kpi-tag">Pátio</span>
            </div>
            <strong class="kpi-value text-blue">@(Overview?.YardOperations.TotalAttendedVehicles ?? 0)</strong>
            <div class="kpi-footer">
                <span>Média: @(Overview?.YardOperations.AverageDailyAttendedVehicles.ToString("F1") ?? "0,0")/dia</span>
                <span>Em andamento: @(Overview?.YardOperations.InProgressWorkOrders ?? 0)</span>
            </div>
        </div>

        <!-- Card 4: Volume Pix Transacionado -->
        <div class="kpi-card">
            <div class="kpi-card-header">
                <span class="kpi-label">VOLUME PIX</span>
                <span class="kpi-tag">Pagamentos</span>
            </div>
            <strong class="kpi-value">R$ @(Overview?.PixTransactions.TotalAmountTransacted.ToString("N2") ?? "0,00")</strong>
            <div class="kpi-footer">
                <span>Transações: @(Overview?.PixTransactions.TotalTransactionsCount ?? 0)</span>
                <span>Ticket Médio: R$ @(Overview?.PixTransactions.AverageTicket.ToString("N2") ?? "0,00")</span>
            </div>
        </div>
    </section>

    <!-- Navegação em Abas -->
    <nav class="tabs-nav" aria-label="Abas de métricas">
        <button type="button" @onclick='() => ActiveTab = "overview"'
                class="tab-btn @(ActiveTab == "overview" ? "active" : "")">
            Inteligência de Negócio &amp; Tendências
        </button>
        <button type="button" @onclick='() => SelectTab("webhooks")'
                class="tab-btn @(ActiveTab == "webhooks" ? "active" : "")">
            Logs de Webhooks Recebidos
        </button>
        <button type="button" @onclick='() => SelectTab("whatsapp")'
                class="tab-btn @(ActiveTab == "whatsapp" ? "active" : "")">
            Falhas de Mensageria (WhatsApp)
        </button>
    </nav>

    <!-- Conteúdo da Aba 1: Inteligência de Negócio & Tendências -->
    @if (ActiveTab == "overview")
    {
        <div class="overview-grid">
            <!-- Distribuição de Planos SaaS -->
            <div class="card-panel">
                <h3 class="card-header-title">Distribuição Comercial de Planos SaaS</h3>
                <p class="card-header-sub">Participação de cada plano na receita mensal recorrente</p>

                <div class="plan-list">
                    @if (Overview?.SaasRevenue.PlanDistribution is { Count: > 0 } plans)
                    {
                        @foreach (var plan in plans)
                        {
                            <div class="plan-item">
                                <div>
                                    <span class="plan-name">@plan.PlanName</span>
                                    <span class="plan-badge">@plan.SubscriptionsCount assinante(s)</span>
                                </div>
                                <div>
                                    <span class="plan-value">R$ @plan.TotalMonthlyContribution.ToString("N2")</span>
                                    <span class="period-text">/mês</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-state">Nenhuma assinatura contratada no momento.</p>
                    }
                </div>
            </div>

            <!-- Saúde Resumida do WhatsApp na Plataforma -->
            <div class="card-panel">
                <h3 class="card-header-title">Telemetria de Entrega WhatsApp</h3>
                <p class="card-header-sub">Índice de entrega e saúde das conexões de mensageria</p>

                <div class="telemetry-grid">
                    <div class="telemetry-card">
                        <span class="telemetry-label">Instâncias Online</span>
                        <p class="telemetry-val text-emerald">
                            @(Overview?.WhatsAppSummary.OnlineInstancesCount ?? 0) / @(Overview?.WhatsAppSummary.TotalConfiguredInstances ?? 0)
                        </p>
                    </div>
                    <div class="telemetry-card">
                        <span class="telemetry-label">Taxa de Sucesso na Janela</span>
                        <p class="telemetry-val text-blue">
                            @(Overview?.WhatsAppSummary.DeliverySuccessRatePercentage.ToString("F1") ?? "100,0")%
                        </p>
                    </div>
                    <div class="telemetry-card">
                        <span class="telemetry-label">Total Transmitidas</span>
                        <p class="telemetry-val">
                            @(Overview?.WhatsAppSummary.TotalMessagesDispatchedInPeriod ?? 0)
                        </p>
                    </div>
                    <div class="telemetry-card">
                        <span class="telemetry-label">Falhas Registradas</span>
                        <p class="telemetry-val text-rose">
                            @(Overview?.WhatsAppSummary.FailedMessagesInPeriod ?? 0)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Série Temporal de Veículos e Pix -->
        <div class="timeseries-panel">
            <h3 class="card-header-title">Evolução de Atendimento e Pagamentos na Janela</h3>
            <p class="card-header-sub">Detalhamento diário consolidado de veículos atendidos e volume financeiro</p>

            <div class="timeseries-grid">
                <!-- Tabela Diária de Veículos -->
                <div class="subtable-container">
                    <div class="subtable-title">Veículos Atendidos por Dia</div>
                    <table class="mini-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th class="text-right">Veículos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Overview?.YardOperations.DailyVolume is { Count: > 0 } dailyYard)
                            {
                                @foreach (var item in dailyYard.Take(7))
                                {
                                    <tr>
                                        <td class="font-mono">@item.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-right font-mono text-blue font-bold">@item.VehiclesAttendedCount</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="empty-state">Sem atendimentos concluídos no período.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Tabela Diária de Pix -->
                <div class="subtable-container">
                    <div class="subtable-title">Volume Pix por Dia</div>
                    <table class="mini-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Qtd</th>
                                <th class="text-right">Valor Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Overview?.PixTransactions.DailyVolume is { Count: > 0 } dailyPix)
                            {
                                @foreach (var item in dailyPix.Take(7))
                                {
                                    <tr>
                                        <td class="font-mono">@item.Date.ToString("dd/MM/yyyy")</td>
                                        <td>@item.TransactionsCount</td>
                                        <td class="text-right font-mono text-emerald font-bold">R$ @item.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="empty-state">Sem transações Pix liquidadas no período.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Conteúdo da Aba 2: Logs de Webhooks -->
    @if (ActiveTab == "webhooks")
    {
        <div class="table-panel">
            <div class="panel-header">
                <h3 class="card-header-title">Logs de Eventos Recebidos por Webhook</h3>
                <p class="card-header-sub">Eventos notificados assincronamente pelos gateways externos (Asaas, Pix, Provedores)</p>
            </div>

            @if (IsLoadingWebhooks)
            {
                <div class="loading-state">Carregando logs de webhooks...</div>
            }
            else if (WebhookLogs.Count == 0)
            {
                <div class="empty-state">Nenhum evento de webhook registrado no período.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="metrics-table">
                        <thead>
                            <tr>
                                <th>Data/Hora UTC</th>
                                <th>Provedor</th>
                                <th>Evento</th>
                                <th>Estabelecimento</th>
                                <th>Status</th>
                                <th class="text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in WebhookLogs)
                            {
                                <tr>
                                    <td class="font-mono">@log.ReceivedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td><strong>@log.Provider</strong></td>
                                    <td class="font-mono text-blue font-bold">@log.EventType</td>
                                    <td>@(log.TenantName ?? "Global / Plataforma")</td>
                                    <td>
                                        <span class="status-badge @GetStatusBadgeClass(log.Status)">
                                            @log.Status
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <button type="button" @onclick="() => OpenWebhookInspection(log)"
                                                class="btn-inspect">
                                            Inspecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Conteúdo da Aba 3: Falhas de WhatsApp -->
    @if (ActiveTab == "whatsapp")
    {
        <div class="table-panel">
            <div class="panel-header">
                <h3 class="card-header-title">Auditoria de Falhas de Mensageria (WhatsApp)</h3>
                <p class="card-header-sub">Mensagens rejeitadas pelo provedor ou com erro de conexão para investigação técnica</p>
            </div>

            @if (IsLoadingWhatsAppFailures)
            {
                <div class="loading-state">Carregando histórico de falhas de envio...</div>
            }
            else if (WhatsAppFailures.Count == 0)
            {
                <div class="empty-state">Zero falhas de envio registradas no período selecionado. Excelente saúde operacional!</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="metrics-table">
                        <thead>
                            <tr>
                                <th>Data/Hora UTC</th>
                                <th>Estabelecimento</th>
                                <th>Destinatário</th>
                                <th>Tentativas</th>
                                <th>Motivo da Falha</th>
                                <th class="text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var failure in WhatsAppFailures)
                            {
                                <tr>
                                    <td class="font-mono">@failure.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td><strong>@failure.TenantName</strong></td>
                                    <td class="font-mono">@failure.RecipientPhoneMasked</td>
                                    <td><strong>@failure.AttemptCount</strong></td>
                                    <td>
                                        <span class="status-badge status-failed" title="@failure.FailureReason">
                                            @failure.FailureReason
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <button type="button" @onclick="() => OpenWhatsAppFailureModal(failure)"
                                                class="btn-inspect">
                                            Detalhes
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- Modais -->
<WebhookPayloadInspectionModal IsOpen="@IsWebhookModalOpen" Log="@SelectedWebhookLog" OnClose="@CloseWebhookModal" />
<WhatsAppFailureDetailsModal IsOpen="@IsWhatsAppModalOpen" Failure="@SelectedWhatsAppFailure" OnClose="@CloseWhatsAppModal" />

@code {
    private bool IsLoading = true;
    private bool IsLoadingWebhooks = false;
    private bool IsLoadingWhatsAppFailures = false;

    private int SelectedDaysWindow = 30;
    private string ActiveTab = "overview";

    private PlatformMetricsOverviewDto? Overview;
    private List<PlatformWebhookLogDto> WebhookLogs = [];
    private List<PlatformWhatsAppFailureDto> WhatsAppFailures = [];

    private bool IsWebhookModalOpen = false;
    private PlatformWebhookLogDto? SelectedWebhookLog;

    private bool IsWhatsAppModalOpen = false;
    private PlatformWhatsAppFailureDto? SelectedWhatsAppFailure;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();
    }

    private async Task ChangeDaysWindow(int days)
    {
        SelectedDaysWindow = days;
        await LoadOverviewAsync();
        if (ActiveTab == "webhooks") await LoadWebhookLogsAsync();
        if (ActiveTab == "whatsapp") await LoadWhatsAppFailuresAsync();
    }

    private async Task SelectTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "webhooks" && WebhookLogs.Count == 0)
        {
            await LoadWebhookLogsAsync();
        }
        else if (tab == "whatsapp" && WhatsAppFailures.Count == 0)
        {
            await LoadWhatsAppFailuresAsync();
        }
    }

    private async Task LoadOverviewAsync()
    {
        IsLoading = true;
        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = to.AddDays(-SelectedDaysWindow);
            Overview = await ObservabilityClient.GetOverviewAsync(from, to, null);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao carregar métricas da plataforma: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadWebhookLogsAsync()
    {
        IsLoadingWebhooks = true;
        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = to.AddDays(-SelectedDaysWindow);
            var logs = await ObservabilityClient.GetWebhookLogsAsync(from, to, null, null, 1, 50);
            WebhookLogs = logs.ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao carregar logs de webhooks: {ex.Message}");
        }
        finally
        {
            IsLoadingWebhooks = false;
        }
    }

    private async Task LoadWhatsAppFailuresAsync()
    {
        IsLoadingWhatsAppFailures = true;
        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = to.AddDays(-SelectedDaysWindow);
            var failures = await ObservabilityClient.GetWhatsAppFailuresAsync(from, to, null, 1, 50);
            WhatsAppFailures = failures.ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao carregar falhas de WhatsApp: {ex.Message}");
        }
        finally
        {
            IsLoadingWhatsAppFailures = false;
        }
    }

    private void OpenWebhookInspection(PlatformWebhookLogDto log)
    {
        SelectedWebhookLog = log;
        IsWebhookModalOpen = true;
    }

    private void CloseWebhookModal()
    {
        IsWebhookModalOpen = false;
        SelectedWebhookLog = null;
    }

    private void OpenWhatsAppFailureModal(PlatformWhatsAppFailureDto failure)
    {
        SelectedWhatsAppFailure = failure;
        IsWhatsAppModalOpen = true;
    }

    private void CloseWhatsAppModal()
    {
        IsWhatsAppModalOpen = false;
        SelectedWhatsAppFailure = null;
    }

    private static string GetStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "processed" or "success" => "status-processed",
        "pending" => "status-pending",
        _ => "status-failed"
    };
}
