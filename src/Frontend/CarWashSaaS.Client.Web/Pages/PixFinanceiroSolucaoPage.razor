</div>

<style>
    /* RESET & VARIAVEIS DA IDENTIDADE VISUAL DO LAVA AÊ */
    :root {
        --bg-main: #0B1514;
        --surface-card: #122421;
        --surface-highlight: #142A27;
        --brand-accent: #C6F277;
        --brand-accent-hover: #b5e85d;
        --accent-dark: #122421;
        --support-pine: #256B57;
        --support-mint: #90E0B3;
        --text-pure: #FFFFFF;
        --text-subtle: #C9DBD3;
        --text-muted: #7E9C92;
        --border-subtle: rgba(37, 107, 87, 0.25);
        --border-highlight: rgba(198, 242, 119, 0.2);
    }

    .solution-page {
