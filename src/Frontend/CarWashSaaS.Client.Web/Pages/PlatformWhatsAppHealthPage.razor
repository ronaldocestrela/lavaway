@page "/platform/whatsapp"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,PlatformSupport")]
@inject PlatformWhatsAppApiClient PlatformApi
@inject IToastService ToastService

<PageTitle>Saúde das Instâncias WhatsApp — Lavaway Backoffice</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="inline-flex items-center gap-2 rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                <span>Backoffice Plataforma</span>
            </div>
            <h1 class="mt-1 text-xl font-bold tracking-tight text-slate-900">Saúde das Instâncias WhatsApp</h1>
            <p class="text-xs text-slate-500">Monitore as instâncias conectadas por tenant, execute testes ativos de conectividade e dispare alertas de reconexão.</p>
        </div>
        <div>
            <button type="button" @onclick="LoadDataAsync" disabled="@_isLoading"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
                <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>@(_isLoading ? "Carregando..." : "Atualizar")</span>
            </button>
        </div>
    </div>

    <!-- KPIs Globais -->
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
            <span class="text-xs font-medium text-slate-500">Total de Instâncias</span>
            <p class="mt-2 text-2xl font-black text-slate-900">@(_overview?.Summary.TotalInstances ?? 0)</p>
            <p class="mt-1 text-[11px] text-slate-400">Estabelecimentos com canal configurado</p>
        </div>
        <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
            <span class="text-xs font-medium text-slate-500">Conectadas (Online)</span>
            <p class="mt-2 text-2xl font-black text-emerald-600">@(_overview?.Summary.ConnectedCount ?? 0)</p>
            <p class="mt-1 text-[11px] text-emerald-500/80">Disparos e chatbots operando normalmente</p>
        </div>
        <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
            <span class="text-xs font-medium text-slate-500">Desconectadas (Offline)</span>
            <p class="mt-2 text-2xl font-black text-rose-600">@(_overview?.Summary.DisconnectedCount ?? 0)</p>
            <p class="mt-1 text-[11px] text-rose-500/80">Requerem novo QR Code ou pareamento</p>
        </div>
        <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
            <span class="text-xs font-medium text-slate-500">Alertas Ativos</span>
            <p class="mt-2 text-2xl font-black text-amber-500">@(_overview?.Summary.AlertsActiveCount ?? 0)</p>
            <p class="mt-1 text-[11px] text-slate-400">Instâncias com aviso de reconexão pendente</p>
        </div>
    </div>

    <!-- Filtros de Busca e Status -->
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-1 items-center gap-2">
            <input type="text" @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
                   placeholder="Buscar por estabelecimento, tenant ID ou sessão..."
                   class="w-full max-w-md rounded-lg border border-slate-200 px-3 py-1.5 text-xs text-slate-700 placeholder-slate-400 focus:border-indigo-500 focus:outline-none" />
            <button type="button" @onclick="LoadDataAsync"
                    class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500">
                Buscar
            </button>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" @onclick='() => SetStatusFilter(null)'
                    class='rounded-lg px-2.5 py-1 text-xs font-medium @(string.IsNullOrEmpty(_selectedStatus) ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")'>
                Todas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("connected")'
                    class='rounded-lg px-2.5 py-1 text-xs font-medium @(_selectedStatus == "connected" ? "bg-emerald-600 text-white" : "bg-emerald-50 text-emerald-700 hover:bg-emerald-100")'>
                Conectadas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("disconnected")'
                    class='rounded-lg px-2.5 py-1 text-xs font-medium @(_selectedStatus == "disconnected" ? "bg-rose-600 text-white" : "bg-rose-50 text-rose-700 hover:bg-rose-100")'>
                Desconectadas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("alert")'
                    class='rounded-lg px-2.5 py-1 text-xs font-medium @(_selectedStatus == "alert" ? "bg-amber-600 text-white" : "bg-amber-50 text-amber-700 hover:bg-amber-100")'>
                Em Alerta
            </button>
        </div>
    </div>

    <!-- Tabela de Instâncias -->
    <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
        @if (_isLoading)
        {
            <div class="p-8 text-center text-xs text-slate-500">
                <span class="inline-block animate-spin mr-2">⏳</span> Carregando instâncias do WhatsApp...
            </div>
        }
        else if (_overview?.Instances.Items.Count == 0)
        {
            <div class="p-8 text-center text-xs text-slate-500">
                Nenhuma instância de WhatsApp encontrada para os critérios selecionados.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="border-b border-slate-100 bg-slate-50 text-[11px] font-semibold text-slate-500 uppercase">
                        <tr>
                            <th class="px-4 py-3">Estabelecimento</th>
                            <th class="px-4 py-3">Sessão / ID</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3">Última Conexão</th>
                            <th class="px-4 py-3">Última Queda / Motivo</th>
                            <th class="px-4 py-3">Alertas</th>
                            <th class="px-4 py-3 text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-600">
                        @foreach (var instance in _overview!.Instances.Items)
                        {
                            <tr class="hover:bg-slate-50/50">
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-slate-900">@instance.TenantName</div>
                                    <div class="text-[10px] text-slate-400 font-mono">@instance.TenantId.ToString()[..8]...</div>
                                </td>
                                <td class="px-4 py-3 font-mono text-[11px] text-slate-500">
                                    @instance.ProviderSessionId
                                </td>
                                <td class="px-4 py-3">
                                    @if (instance.Status == "connected")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Conectado
                                        </span>
                                    }
                                    else if (instance.Status == "connecting")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> Pareando
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span> Desconectado
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-slate-500">
                                    @(instance.LastConnectedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                                </td>
                                <td class="px-4 py-3">
                                    @if (instance.LastDisconnectedAtUtc.HasValue)
                                    {
                                        <div class="text-rose-600 font-medium">@instance.LastDisconnectedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="text-[10px] text-slate-400 truncate max-w-xs" title="@instance.DisconnectReason">
                                            @(instance.DisconnectReason ?? "Sem detalhes")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">Nenhuma queda recente</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (instance.HasActiveAlert)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-amber-800">
                                            ⚠️ Ativo (@instance.AlertCount)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">@instance.AlertCount envios</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button type="button" @onclick="() => RunProbeForInstanceAsync(instance.TenantId)"
                                                class="rounded border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50"
                                                title="Sondar conectividade diretamente na Evolution API">
                                            🔍 Testar
                                        </button>
                                        <button type="button" @onclick="() => TriggerAlertForInstanceAsync(instance.TenantId)"
                                                class="rounded border border-amber-200 bg-amber-50 px-2 py-1 text-[11px] font-semibold text-amber-800 hover:bg-amber-100"
                                                title="Reenviar e-mail de alerta para o lojista com novo QR Code">
                                            📧 Alertar
                                        </button>
                                        <button type="button" @onclick="() => OpenDiagnosticModal(instance)"
                                                class="rounded border border-indigo-200 bg-indigo-50 px-2 py-1 text-[11px] font-semibold text-indigo-700 hover:bg-indigo-100">
                                            Diagnóstico
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<WhatsAppInstanceDiagnosticModal
    @ref="_diagnosticModal"
    IsOpen="@_isDiagnosticOpen"
    Instance="@_selectedInstance"
    OnClose="CloseDiagnosticModal"
    OnRunProbe="RunProbeFromModalAsync"
    OnTriggerAlert="TriggerAlertFromModalAsync" />

@code {
    private PlatformWhatsAppInstancesOverviewDto? _overview;
    private bool _isLoading = true;
    private string? _searchTerm;
    private string? _selectedStatus;
    private int _currentPage = 1;

    private bool _isDiagnosticOpen = false;
    private PlatformWhatsAppInstanceItemDto? _selectedInstance;
    private WhatsAppInstanceDiagnosticModal? _diagnosticModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _overview = await PlatformApi.GetOverviewAsync(_searchTerm, _selectedStatus, _currentPage, 20);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Falha ao carregar instâncias do WhatsApp: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetStatusFilter(string? status)
    {
        _selectedStatus = status;
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadDataAsync();
        }
    }

    private void OpenDiagnosticModal(PlatformWhatsAppInstanceItemDto instance)
    {
        _selectedInstance = instance;
        _isDiagnosticOpen = true;
    }

    private void CloseDiagnosticModal()
    {
        _isDiagnosticOpen = false;
        _selectedInstance = null;
    }

    private async Task RunProbeForInstanceAsync(Guid tenantId)
    {
        try
        {
            var probeResult = await PlatformApi.RunProbeAsync(tenantId);
            if (probeResult.IsReachable)
            {
                ToastService.ShowSuccess($"Instância online! Estado: {probeResult.ProviderState}");
            }
            else
            {
                ToastService.ShowWarning($"Instância offline ou inacessível: {probeResult.Message}");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao executar teste de conexão: {ex.Message}");
        }
    }

    private async Task RunProbeFromModalAsync(Guid tenantId)
    {
        try
        {
            var probeResult = await PlatformApi.RunProbeAsync(tenantId);
            _diagnosticModal?.SetProbeResult(probeResult);
            if (probeResult.IsReachable)
            {
                ToastService.ShowSuccess($"Instância online! Estado: {probeResult.ProviderState}");
            }
            else
            {
                ToastService.ShowWarning($"Instância offline: {probeResult.Message}");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao executar teste de conexão: {ex.Message}");
        }
    }

    private async Task TriggerAlertForInstanceAsync(Guid tenantId)
    {
        try
        {
            await PlatformApi.TriggerAlertAsync(tenantId);
            ToastService.ShowSuccess("Alerta de reconexão disparado com sucesso para o lojista.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao enviar alerta: {ex.Message}");
        }
    }

    private async Task TriggerAlertFromModalAsync(Guid tenantId)
    {
        await TriggerAlertForInstanceAsync(tenantId);
    }
}
