@page "/platform/whatsapp"
@using CarWashSaaS.Client.Components
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin,PlatformSupport")]
@inject PlatformWhatsAppApiClient PlatformApi
@inject IToastService ToastService

<PageTitle>Saúde das Instâncias WhatsApp — Lava Aê</PageTitle>

<div class="platform-whatsapp-page">
    <PageHeading Eyebrow="BACKOFFICE DA PLATAFORMA"
                 Title="Saúde das Instâncias WhatsApp"
                 Subtitle="Monitore as instâncias conectadas por tenant, execute testes ativos de conectividade e dispare alertas de reconexão.">
        <Actions>
            <button type="button" class="btn-refresh" @onclick="LoadDataAsync" disabled="@_isLoading" id="btn-refresh-whatsapp">
                <span class="@(_isLoading ? "spin-icon" : "")">↻</span>
                <span>@(_isLoading ? "Carregando..." : "Atualizar")</span>
            </button>
        </Actions>
    </PageHeading>

    <!-- KPIs Globais -->
    <section class="kpi-grid" aria-label="Indicadores Globais de WhatsApp">
        <div class="kpi-card">
            <span class="kpi-label">TOTAL DE INSTÂNCIAS</span>
            <strong class="kpi-value">@(_overview?.Summary.TotalInstances ?? 0)</strong>
            <span class="kpi-subtext">Estabelecimentos com canal configurado</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">CONECTADAS (ONLINE)</span>
            <strong class="kpi-value text-emerald">@(_overview?.Summary.ConnectedCount ?? 0)</strong>
            <span class="kpi-subtext">Disparos e chatbots operando normalmente</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">DESCONECTADAS (OFFLINE)</span>
            <strong class="kpi-value text-rose">@(_overview?.Summary.DisconnectedCount ?? 0)</strong>
            <span class="kpi-subtext">Requerem novo QR Code ou pareamento</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">ALERTAS ATIVOS</span>
            <strong class="kpi-value text-amber">@(_overview?.Summary.AlertsActiveCount ?? 0)</strong>
            <span class="kpi-subtext">Instâncias com aviso de reconexão pendente</span>
        </div>
    </section>

    <!-- Filtros de Busca e Status -->
    <section class="filter-card" aria-label="Filtros de busca e status">
        <div class="search-group">
            <input type="text" @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
                   placeholder="Buscar por estabelecimento, tenant ID ou sessão..."
                   class="form-control" />
            <button type="button" @onclick="LoadDataAsync" class="btn-search">
                Buscar
            </button>
        </div>

        <div class="filter-pills">
            <button type="button" @onclick='() => SetStatusFilter(null)'
                    class='pill-btn @(string.IsNullOrEmpty(_selectedStatus) ? "active" : "")'>
                Todas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("connected")'
                    class='pill-btn pill-connected @(_selectedStatus == "connected" ? "active" : "")'>
                Conectadas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("disconnected")'
                    class='pill-btn pill-disconnected @(_selectedStatus == "disconnected" ? "active" : "")'>
                Desconectadas
            </button>
            <button type="button" @onclick='() => SetStatusFilter("alert")'
                    class='pill-btn pill-alert @(_selectedStatus == "alert" ? "active" : "")'>
                Em Alerta
            </button>
        </div>
    </section>

    <!-- Tabela de Instâncias -->
    <section class="table-panel" aria-label="Lista de Instâncias do WhatsApp">
        @if (_isLoading)
        {
            <div class="loading-state">
                <span class="spin-icon">⏳</span> Carregando instâncias do WhatsApp...
            </div>
        }
        else if (_overview?.Instances.Items.Count == 0)
        {
            <div class="empty-state">
                Nenhuma instância de WhatsApp encontrada para os critérios selecionados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="instances-table">
                    <thead>
                        <tr>
                            <th>Estabelecimento</th>
                            <th>Sessão / ID</th>
                            <th>Status</th>
                            <th>Última Conexão</th>
                            <th>Última Queda / Motivo</th>
                            <th>Alertas</th>
                            <th class="text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var instance in _overview!.Instances.Items)
                        {
                            <tr>
                                <td class="tenant-primary-cell">
                                    <strong class="tenant-name">@instance.TenantName</strong>
                                    <span class="tenant-id">@instance.TenantId.ToString()[..8]...</span>
                                </td>
                                <td>
                                    <span class="session-text">@instance.ProviderSessionId</span>
                                </td>
                                <td>
                                    @if (instance.Status == "connected")
                                    {
                                        <span class="status-badge status-connected">
                                            <span class="status-dot"></span> Conectado
                                        </span>
                                    }
                                    else if (instance.Status == "connecting")
                                    {
                                        <span class="status-badge status-connecting">
                                            <span class="status-dot"></span> Pareando
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-disconnected">
                                            <span class="status-dot"></span> Desconectado
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="date-text">@(instance.LastConnectedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</span>
                                </td>
                                <td>
                                    @if (instance.LastDisconnectedAtUtc.HasValue)
                                    {
                                        <div class="disconnect-cell">
                                            <span class="disconnect-date">@instance.LastDisconnectedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            <span class="disconnect-reason" title="@instance.DisconnectReason">
                                                @(instance.DisconnectReason ?? "Sem detalhes")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nenhuma queda recente</span>
                                    }
                                </td>
                                <td>
                                    @if (instance.HasActiveAlert)
                                    {
                                        <span class="alert-badge">
                                            ⚠️ Ativo (@instance.AlertCount)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@instance.AlertCount envios</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <div class="actions-group">
                                        <button type="button" @onclick="() => RunProbeForInstanceAsync(instance.TenantId)"
                                                class="btn-table-action"
                                                title="Sondar conectividade diretamente na Evolution API">
                                            🔍 Testar
                                        </button>
                                        <button type="button" @onclick="() => TriggerAlertForInstanceAsync(instance.TenantId)"
                                                class="btn-table-action btn-alert-action"
                                                title="Reenviar e-mail de alerta para o lojista com novo QR Code">
                                            📧 Alertar
                                        </button>
                                        <button type="button" @onclick="() => OpenDiagnosticModal(instance)"
                                                class="btn-table-action btn-diagnostic-action">
                                            Diagnóstico
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<WhatsAppInstanceDiagnosticModal
    @ref="_diagnosticModal"
    IsOpen="@_isDiagnosticOpen"
    Instance="@_selectedInstance"
    OnClose="CloseDiagnosticModal"
    OnRunProbe="RunProbeFromModalAsync"
    OnTriggerAlert="TriggerAlertFromModalAsync" />

@code {
    private PlatformWhatsAppInstancesOverviewDto? _overview;
    private bool _isLoading = true;
    private string? _searchTerm;
    private string? _selectedStatus;
    private int _currentPage = 1;

    private bool _isDiagnosticOpen = false;
    private PlatformWhatsAppInstanceItemDto? _selectedInstance;
    private WhatsAppInstanceDiagnosticModal? _diagnosticModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _overview = await PlatformApi.GetOverviewAsync(_searchTerm, _selectedStatus, _currentPage, 20);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Falha ao carregar instâncias do WhatsApp: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadDataAsync();
        }
    }

    private async Task SetStatusFilter(string? status)
    {
        _selectedStatus = status;
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task RunProbeForInstanceAsync(Guid tenantId)
    {
        try
        {
            var probeResult = await PlatformApi.RunProbeAsync(tenantId);
            if (probeResult.IsReachable)
            {
                ToastService.ShowSuccess($"Instância online! Estado: {probeResult.ProviderState}");
            }
            else
            {
                ToastService.ShowWarning($"Instância offline ou inacessível: {probeResult.Message}");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao executar teste de conexão: {ex.Message}");
        }
    }

    private async Task RunProbeFromModalAsync(Guid tenantId)
    {
        try
        {
            var probeResult = await PlatformApi.RunProbeAsync(tenantId);
            _diagnosticModal?.SetProbeResult(probeResult);
            if (probeResult.IsReachable)
            {
                ToastService.ShowSuccess($"Instância online! Estado: {probeResult.ProviderState}");
            }
            else
            {
                ToastService.ShowWarning($"Instância offline: {probeResult.Message}");
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao executar teste de conexão: {ex.Message}");
        }
    }

    private async Task TriggerAlertForInstanceAsync(Guid tenantId)
    {
        try
        {
            await PlatformApi.TriggerAlertAsync(tenantId);
            ToastService.ShowSuccess("Alerta de reconexão disparado com sucesso para o lojista.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao enviar alerta: {ex.Message}");
        }
    }

    private async Task TriggerAlertFromModalAsync(Guid tenantId)
    {
        await TriggerAlertForInstanceAsync(tenantId);
    }

    private void OpenDiagnosticModal(PlatformWhatsAppInstanceItemDto instance)
    {
        _selectedInstance = instance;
        _isDiagnosticOpen = true;
    }

    private void CloseDiagnosticModal()
    {
        _isDiagnosticOpen = false;
        _selectedInstance = null;
    }
}
