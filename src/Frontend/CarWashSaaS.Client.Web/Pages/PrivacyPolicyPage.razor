    <!-- MAIN CONTENT CONTAINER -->
    <main class="legal-body">
        <div class="legal-layout">
            <!-- STICKY TABLE OF CONTENTS -->
            <aside class="legal-toc">
                <div class="toc-card">
                    <h3 class="toc-title">Índice da Política</h3>
                    <nav class="toc-nav">
