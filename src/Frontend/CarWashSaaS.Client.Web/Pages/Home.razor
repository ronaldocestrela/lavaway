    private int _calcAvgTicket = 85;
    private int _openFaqIndex = 0;

    // Contract / Lead modal state
    private bool _isContractModalOpen;
    private string _selectedPlan = "Pro";
    private string _hireStoreName = string.Empty;
    private string _hireContactName = string.Empty;
    private string _hireEmail = string.Empty;
    private string _hirePassword = string.Empty;
    private string _hirePhone = string.Empty;
    private string _hireCity = string.Empty;
    private bool _hireSubmitted;
    private bool _isSubmitting;
    private string? _errorMessage;

    private void ToggleMobileMenu() => _isMobileMenuOpen = !_isMobileMenuOpen;
    private void CloseMobileMenu() => _isMobileMenuOpen = false;

    private void SetDemoTab(string tab) => _activeDemoTab = tab;

    private void ToggleBilling() => _isAnnualBilling = !_isAnnualBilling;

    private void ToggleFaq(int index) => _openFaqIndex = _openFaqIndex == index ? -1 : index;

    private string GetDemoPrice(string size) => size switch
    {
        "Hatch" => "R$ 70,00",
        "SUV" => "R$ 95,00",
        "Pickup" => "R$ 120,00",
        "Moto" => "R$ 45,00",
        _ => "R$ 80,00"
    };

    private decimal GetExtraRevenueMonthly()
    {
        // 26 days * dailyCars * 18% retained * avgTicket
        return _calcDailyCars * 26m * 0.18m * _calcAvgTicket;
    }

    private int GetHoursSavedMonthly()
    {
        // ~2.5 mins saved per check-in * cars/day * 26 days / 60
        var totalMinutes = _calcDailyCars * 2.5 * 26;
        return (int)Math.Round(totalMinutes / 60.0);
    }

    private int GetRoiMultiplier()
    {
        var planCost = 149m;
        var extra = GetExtraRevenueMonthly();
        return (int)Math.Max(1, Math.Round(extra / planCost));
    }

    private void OpenContractModal(string plan)
    {
        _selectedPlan = plan;
        _hireSubmitted = false;
        _isSubmitting = false;
        _errorMessage = null;
        _isContractModalOpen = true;
    }

    private void CloseContractModal()
    {
        _isContractModalOpen = false;
    }

    private async Task SubmitHireRequest()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_hireStoreName) ||
            string.IsNullOrWhiteSpace(_hireContactName) ||
            string.IsNullOrWhiteSpace(_hireEmail) ||
            string.IsNullOrWhiteSpace(_hirePassword) ||
            string.IsNullOrWhiteSpace(_hirePhone))
        {
            _errorMessage = "Por favor, preencha todos os campos obrigatórios (*).";
            return;
        }

        if (_hirePassword.Trim().Length < 6)
        {
            _errorMessage = "A senha de acesso deve ter pelo menos 6 caracteres.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var planTier = _selectedPlan switch
            {
                "Start" => SaasPlanTier.Basic,
                "Redes" => SaasPlanTier.Enterprise,
                _ => SaasPlanTier.Pro
            };

            var request = new RegisterTenantRequest(
                StoreName: _hireStoreName.Trim(),
                AdminName: _hireContactName.Trim(),
                Email: _hireEmail.Trim().ToLowerInvariant(),
                Password: _hirePassword,
                Phone: _hirePhone.Trim(),
                City: string.IsNullOrWhiteSpace(_hireCity) ? null : _hireCity.Trim(),
                State: null,
                PlanTier: planTier);

            var result = await AuthApi.RegisterTenantAsync(request);
            if (result.IsSuccess && result.Value is not null)
            {
                var auth = result.Value;
                await TokenStorage.SetAccessTokenAsync(auth.AccessToken);
                if (!string.IsNullOrWhiteSpace(auth.RefreshToken))
                {
                    await TokenStorage.SetRefreshTokenAsync(auth.RefreshToken);
                }
                AuthStateProvider.NotifyUserAuthentication(auth.AccessToken);
                _hireSubmitted = true;
            }
            else
            {
                _errorMessage = result.Error?.Description ?? "Ocorreu um erro ao criar a conta. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro de conexão: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void NavigateToApp()
    {
        CloseContractModal();
        Navigation.NavigateTo("reception");
    }

    private string GetWhatsAppDirectLink()
    {
        var message = $"Olá! Acabei de ativar meu teste no Lavaway para o plano {_selectedPlan}. Meu estabelecimento: {_hireStoreName} ({_hireCity}), responsável: {_hireContactName}.";
        return $"https://wa.me/5511999999999?text={Uri.EscapeDataString(message)}";
    }
