@page "/"
@layout LandingLayout
@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@inject AuthApiClient AuthApi
@inject ITokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Lavaway | O Sistema Operacional para Lava-Jatos e Estética Automotiva</PageTitle>

<div class="landing-page">
    <!-- TOP NOTIFICATION BANNER -->
    <div class="top-banner">
        <div class="banner-inner">
            <span class="banner-pill">NOVIDADE</span>
            <span class="banner-text">Automação de WhatsApp nativa sem cobrança por mensagem disparada.</span>
            <button class="banner-link" type="button" @onclick='() => OpenContractModal("Pro")'>Experimente 14 dias grátis &rarr;</button>
        </div>
    </div>

    <!-- STICKY HEADER NAVBAR -->
    <header class="navbar" id="top">
        <div class="navbar-container">
            <a class="brand" href="/" aria-label="Lavaway início">
                <span class="brand-badge">L</span>
                <span class="brand-text">lavaway</span>
                <span class="brand-tag">SaaS</span>
            </a>

            <button class="mobile-menu-btn" type="button" @onclick="ToggleMobileMenu" aria-label="Abrir menu de navegação">
                <span class="menu-bar"></span>
                <span class="menu-bar"></span>
                <span class="menu-bar"></span>
            </button>

            <nav class="nav-links @(_isMobileMenuOpen ? "open" : "")" aria-label="Navegação institucional">
                <a href="#recursos" @onclick="CloseMobileMenu">Recursos</a>
                <a href="#demonstracao" @onclick="CloseMobileMenu">Como Funciona</a>
                <a href="#whatsapp" @onclick="CloseMobileMenu">WhatsApp</a>
                <a href="#roi" @onclick="CloseMobileMenu">Calculadora ROI</a>
                <a href="#planos" @onclick="CloseMobileMenu">Planos</a>
                <a href="#faq" @onclick="CloseMobileMenu">Dúvidas</a>
            </nav>

            <div class="nav-actions">
                <AuthorizeView>
                    <Authorized Context="userState">
                        <a class="btn-ghost panel-link" href="reception" id="nav-btn-reception">
                            <span class="status-indicator-dot"></span>
                            <span>Acessar Recepção</span>
                            <span class="arrow">&rarr;</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn-ghost" href="authentication/login" id="nav-btn-login">Entrar</a>
                        <button class="btn-primary glow" type="button" @onclick='() => OpenContractModal("Pro")' id="nav-btn-trial">
                            Testar Grátis
                        </button>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main>
        <!-- HERO SECTION -->
        <section class="hero-section">
            <div class="hero-glow hero-glow-1"></div>
            <div class="hero-glow hero-glow-2"></div>

            <div class="section-container hero-content">
                <div class="hero-badge">
                    <span class="badge-dot"></span>
                    <span>O SISTEMA OPERACIONAL DA ESTÉTICA AUTOMOTIVA</span>
                </div>

                <h1 class="hero-title">
                    Transforme o seu lava-jato em uma <span class="gradient-text">máquina de faturar e fidelizar</span>.
                </h1>

                <p class="hero-description">
                    Abandone a prancheta de papel. Tenha <strong>check-in em 35 segundos</strong>, vistoria digital com fotos
                    contra acusações de danos, <strong>notificações automáticas no WhatsApp</strong> do cliente e controle
                    rigoroso de boxes e comissões.
                </p>

                <div class="hero-cta-group">
                    <button class="btn-cta-hero glow" type="button" @onclick='() => OpenContractModal("Pro")' id="hero-cta-start">
                        <span>Iniciar Teste Grátis de 14 Dias</span>
                        <span class="cta-arrow">&rarr;</span>
                    </button>
                    <a class="btn-secondary-hero" href="#demonstracao" id="hero-cta-demo">
                        <span class="play-icon">&#9658;</span>
                        <span>Ver Como Funciona</span>
                    </a>
                </div>

                <div class="hero-guarantees">
                    <div class="guarantee-item">
                        <span class="check-icon">&#10003;</span> Sem necessidade de cartão de crédito
                    </div>
                    <div class="guarantee-item">
                        <span class="check-icon">&#10003;</span> Implantação e uso em 5 minutos
                    </div>
                    <div class="guarantee-item">
                        <span class="check-icon">&#10003;</span> Suporte direto via WhatsApp
                    </div>
                </div>

                <!-- TRUST METRICS -->
                <div class="metrics-grid">
                    <div class="metric-card">
                        <div class="metric-val">+350</div>
                        <div class="metric-label">Lava-jatos e estéticas ativos</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-val">&lt; 40s</div>
                        <div class="metric-label">Tempo médio de check-in</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-val">+28%</div>
                        <div class="metric-label">Aumento na recorrência via WhatsApp</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-val">100%</div>
                        <div class="metric-label">Blindagem contra falsas avarias</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- INTERACTIVE LIVE DEMO SHOWCASE -->
        <section class="demo-section" id="demonstracao">
            <div class="section-container">
                <div class="section-header center">
                    <div class="section-tag">DEMONSTRAÇÃO INTERATIVA</div>
                    <h2 class="section-title">Sinta na prática o poder do Lavaway</h2>
                    <p class="section-subtitle">
                        Navegue pelas telas principais e veja por que donos de centros automotivos aposentaram pranchetas e planilhas.
                    </p>
                </div>

                <div class="demo-tabs">
                    <button class="demo-tab @(_activeDemoTab == "whatsapp" ? "active" : "")" type="button" @onclick='() => SetDemoTab("whatsapp")'>
                        <span class="tab-icon">💬</span>
                        <span>01. Experiência WhatsApp</span>
                    </button>
                    <button class="demo-tab @(_activeDemoTab == "reception" ? "active" : "")" type="button" @onclick='() => SetDemoTab("reception")'>
                        <span class="tab-icon">⚡</span>
                        <span>02. Check-in &amp; Preços</span>
                    </button>
                    <button class="demo-tab @(_activeDemoTab == "yard" ? "active" : "")" type="button" @onclick='() => SetDemoTab("yard")'>
                        <span class="tab-icon">📊</span>
                        <span>03. Gestão do Pátio &amp; Boxes</span>
                    </button>
                </div>

                <div class="demo-window">
                    <div class="window-bar">
                        <div class="window-dots">
                            <span class="dot red"></span>
                            <span class="dot yellow"></span>
                            <span class="dot green"></span>
                        </div>
                        <div class="window-address">
                            <span>https://app.lavaway.com.br/@_activeDemoTab</span>
                        </div>
                        <div class="window-status">
                            <span class="live-badge">SISTEMA ATIVO</span>
                        </div>
                    </div>

                    <div class="demo-canvas">
                        @if (_activeDemoTab == "whatsapp")
                        {
                            <!-- WHATSAPP VIEW SIMULATION -->
                            <div class="wa-simulation">
                                <div class="wa-phone-frame">
                                    <div class="wa-header">
                                        <div class="wa-avatar">LW</div>
                                        <div class="wa-contact">
                                            <strong>Lavaway Garage &amp; Detail</strong>
                                            <span>online agora</span>
                                        </div>
                                        <div class="wa-verified">&#10003;</div>
                                    </div>
                                    <div class="wa-chat-body">
                                        <div class="wa-message received">
                                            <p>👋 <strong>Olá, Bruno!</strong> Seu <em>Jeep Compass (BRA-2E19)</em> deu entrada para <strong>Lavagem Detalhada + Vitrificação</strong>.</p>
                                            <div class="wa-card-preview">
                                                <div class="wa-card-title">🚗 Ordem de Serviço #1048</div>
                                                <div class="wa-card-detail">Previsão: Hoje às 16:30 • Box 03</div>
                                                <a class="wa-card-btn" href="#demonstracao" @onclick:preventDefault>Ver comprovante com fotos &rarr;</a>
                                            </div>
                                            <span class="wa-time">10:14</span>
                                        </div>

                                        <div class="wa-message received">
                                            <p>🧼 <strong>Atualização de status:</strong> A lavagem técnica de chassi e rodas foi concluída! Seu carro seguiu para a cabine de secagem e selamento cerâmico.</p>
                                            <span class="wa-time">13:40</span>
                                        </div>

                                        <div class="wa-message received highlight">
                                            <p>✨ <strong>SEU CARRO ESTÁ PRONTO!</strong> Pode vir retirar. Ficou impecável!</p>
                                            <div class="wa-payment-box">
                                                <span>Total: <strong>R$ 280,00</strong></span>
                                                <span class="pix-tag">Pague via Pix na retirada</span>
                                            </div>
                                            <span class="wa-time">15:58</span>
                                        </div>
                                    </div>
                                    <div class="wa-footer-bar">
                                        <span>Mensagem automática enviada pelo Lavaway</span>
                                    </div>
                                </div>

                                <div class="wa-features-list">
                                    <h3>O cliente não precisa ligar para perguntar se ficou pronto.</h3>
                                    <p>O próprio sistema avisa cada avanço de etapa e manda o comprovante digital com a <strong>sua logomarca</strong> e <strong>suas cores</strong>.</p>
                                    <ul class="benefit-bullets">
                                        <li><span>&#10003;</span> <strong>Sem custo de disparos:</strong> Conecte seu número de WhatsApp via QR Code em 30 segundos.</li>
                                        <li><span>&#10003;</span> <strong>Link público interativo:</strong> O cliente acompanha o progresso e as fotos da vistoria em tempo real.</li>
                                        <li><span>&#10003;</span> <strong>Fim das filas de entrega:</strong> O cliente chega com o Pix pronto e retira o carro com rapidez total.</li>
                                    </ul>
                                </div>
                            </div>
                        }
                        else if (_activeDemoTab == "reception")
                        {
                            <!-- FAST CHECK-IN SIMULATION -->
                            <div class="checkin-simulation">
                                <div class="checkin-card">
                                    <div class="sim-header">
                                        <span class="step-num">01</span>
                                        <div>
                                            <h4>Check-in Expresso</h4>
                                            <p>Digite a placa ou o celular para autopreenchimento instantâneo</p>
                                        </div>
                                    </div>

                                    <div class="sim-form">
                                        <div class="sim-input-row">
                                            <div class="sim-field">
                                                <label>PLACA DO VEÍCULO</label>
                                                <input value="BRA-2E19" readonly />
                                            </div>
                                            <div class="sim-field">
                                                <label>TELEFONE (WHATSAPP)</label>
                                                <input value="(11) 98765-4321" readonly />
                                            </div>
                                        </div>

                                        <div class="sim-field">
                                            <label>PORTE DO VEÍCULO</label>
                                            <div class="size-selector">
                                                <button class="size-pill @(_selectedDemoSize == "Hatch" ? "active" : "")" type="button" @onclick='() => _selectedDemoSize = "Hatch"'>Hatch/Sedan</button>
                                                <button class="size-pill @(_selectedDemoSize == "SUV" ? "active" : "")" type="button" @onclick='() => _selectedDemoSize = "SUV"'>SUV</button>
                                                <button class="size-pill @(_selectedDemoSize == "Pickup" ? "active" : "")" type="button" @onclick='() => _selectedDemoSize = "Pickup"'>Picape/Van</button>
                                                <button class="size-pill @(_selectedDemoSize == "Moto" ? "active" : "")" type="button" @onclick='() => _selectedDemoSize = "Moto"'>Moto</button>
                                            </div>
                                        </div>

                                        <div class="sim-service-summary">
                                            <div class="summary-line">
                                                <span>Serviço Selecionado:</span>
                                                <strong>Lavagem Completa + Cera Pro</strong>
                                            </div>
                                            <div class="summary-line">
                                                <span>Preço pelo porte (@_selectedDemoSize):</span>
                                                <span class="price-badge">@GetDemoPrice(_selectedDemoSize)</span>
                                            </div>
                                            <div class="summary-line">
                                                <span>Previsão de Execução:</span>
                                                <strong>1h 15min</strong>
                                            </div>
                                        </div>

                                        <div class="sim-btn-mock">
                                            &#10003; Abrir Ordem de Serviço &amp; Notificar WhatsApp
                                        </div>
                                    </div>
                                </div>

                                <div class="checkin-explanation">
                                    <h3>Seu atendente não erra o preço nunca mais.</h3>
                                    <p>Configure faixas de preços exclusivas por porte (Hatch, SUV, Picape e Moto). O Lavaway aplica os valores corretos e estima a entrega sem confusões.</p>
                                    <div class="feature-tags-grid">
                                        <span class="ftag">Placa Mercosul</span>
                                        <span class="ftag">Histórico do Cliente</span>
                                        <span class="ftag">Vistoria com Fotos</span>
                                        <span class="ftag">Impressão Térmica</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- YARD & CAPACITY SIMULATION -->
                            <div class="yard-simulation">
                                <div class="yard-stats-bar">
                                    <div class="ystat">
                                        <span class="ystat-title">CAPACIDADE DO PÁTIO</span>
                                        <strong>04 de 06 Boxes Ocupados (67%)</strong>
                                        <div class="progress-track"><div class="progress-fill" style="width: 67%;"></div></div>
                                    </div>
                                    <div class="ystat">
                                        <span class="ystat-title">FATURAMENTO DO DIA</span>
                                        <strong class="green-text">R$ 2.450,00</strong>
                                        <span class="ystat-sub">18 veículos atendidos hoje</span>
                                    </div>
                                </div>

                                <div class="boxes-grid">
                                    <div class="box-card active">
                                        <div class="box-header">
                                            <span class="box-tag">BOX 01</span>
                                            <span class="box-status washing">LAVAGEM</span>
                                        </div>
                                        <div class="box-vehicle">Toyota Corolla • <strong>BRA-1A22</strong></div>
                                        <div class="box-service">Ducha + Aspiração</div>
                                        <div class="box-operator">Operador: Rafael (Comissão: R$ 18,00)</div>
                                    </div>

                                    <div class="box-card active">
                                        <div class="box-header">
                                            <span class="box-tag">BOX 02</span>
                                            <span class="box-status detail">POLIMENTO</span>
                                        </div>
                                        <div class="box-vehicle">BMW 320i • <strong>FKW-9811</strong></div>
                                        <div class="box-service">Polimento Técnico 3 Etapas</div>
                                        <div class="box-operator">Operador: Carlos (Comissão: R$ 120,00)</div>
                                    </div>

                                    <div class="box-card ready">
                                        <div class="box-header">
                                            <span class="box-tag">BOX 03</span>
                                            <span class="box-status ready-status">PRONTO</span>
                                        </div>
                                        <div class="box-vehicle">Jeep Compass • <strong>ABC-1D23</strong></div>
                                        <div class="box-service">Higienização Completa</div>
                                        <div class="box-operator">Aguardando retirada pelo cliente</div>
                                    </div>

                                    <div class="box-card available">
                                        <div class="box-header">
                                            <span class="box-tag">BOX 04</span>
                                            <span class="box-status free">LIVRE</span>
                                        </div>
                                        <div class="box-empty-prompt">
                                            + Pronto para receber próximo veículo
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- PROBLEM VS SOLUTION SECTION -->
        <section class="comparison-section">
            <div class="section-container">
                <div class="section-header center">
                    <div class="section-tag">COMPARAÇÃO REAL</div>
                    <h2 class="section-title">O fim do estresse na sua operação</h2>
                    <p class="section-subtitle">Veja a diferença entre gerenciar com papel ou planilhas versus a eficiência do Lavaway.</p>
                </div>

                <div class="comparison-grid">
                    <div class="comp-col negative">
                        <div class="comp-col-header">
                            <span class="col-icon">&#10060;</span>
                            <h3>Como a maioria opera hoje</h3>
                            <p>Caos, prejuízos invisíveis e clientes desconfiados</p>
                        </div>
                        <ul class="comp-list">
                            <li>
                                <strong>Prancheta de papel molhada:</strong> Cadastros ilegíveis, fichas perdidas e histórico zero dos carros.
                            </li>
                            <li>
                                <strong>Golpes de avaria prévia:</strong> Cliente jura que aquele arranhão no para-choque foi feito na sua loja. Você acaba pagando o conserto.
                            </li>
                            <li>
                                <strong>WhatsApp sobrecarregado:</strong> Atendente gasta 2 horas por dia só respondendo "meu carro já tá pronto?".
                            </li>
                            <li>
                                <strong>Confusão nas comissões:</strong> Caderninho de anotação que gera brigas e desconfiança entre os lavadores todo final de semana.
                            </li>
                            <li>
                                <strong>Cobranças erradas:</strong> Cobrar preço de sedan em SUV grande porque o recepcionista se confundiu.
                            </li>
                        </ul>
                    </div>

                    <div class="comp-col positive">
                        <div class="comp-col-header">
                            <span class="col-icon">&#10004;</span>
                            <h3>Com o Lavaway no seu pátio</h3>
                            <p>Controle cirúrgico, credibilidade máxima e lucro consistente</p>
                        </div>
                        <ul class="comp-list">
                            <li>
                                <strong>Check-in em 35 segundos:</strong> Digite a placa, o histórico abre na hora e a OS é gerada com 2 toques.
                            </li>
                            <li>
                                <strong>Vistoria fotográfica blindada:</strong> Registre fotos e marcas na tela do celular antes de molhar o carro. Fim das contestações.
                            </li>
                            <li>
                                <strong>Notificações no piloto automático:</strong> O WhatsApp do cliente apita sozinho em cada troca de etapa no pátio.
                            </li>
                            <li>
                                <strong>Comissões calculadas na hora:</strong> Regras por serviço ou porte. Cada lavador sabe exatamente o que produziu.
                            </li>
                            <li>
                                <strong>Tabela travada por porte:</strong> Sem erros humanos. Preços calculados com precisão matemática.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6 CORE PLATFORM PILLARS -->
        <section class="features-section" id="recursos">
            <div class="section-container">
                <div class="section-header">
                    <div class="section-tag">RECURSOS COMPLETOS</div>
                    <h2 class="section-title">Tudo o que sua estética precisa em um só lugar</h2>
                    <p class="section-subtitle">
                        Construído exclusivamente para o fluxo de trabalho automotivo, sem adaptações ou módulos genéricos.
                    </p>
                </div>

                <div class="features-grid">
                    <article class="feature-box">
                        <div class="f-num">01</div>
                        <div class="f-icon-wrap">⚡</div>
                        <h3>Check-in Relâmpago</h3>
                        <p>Busca instantânea por placa Mercosul ou telefone. Cadastre cliente e veículo juntos sem travar a recepção em horários de pico.</p>
                        <ul class="f-micro-list">
                            <li>Autocompletar de clientes frequentes</li>
                            <li>Vínculo de múltiplos veículos por dono</li>
                        </ul>
                    </article>

                    <article class="feature-box">
                        <div class="f-num">02</div>
                        <div class="f-icon-wrap">📸</div>
                        <h3>Vistoria Digital Anti-Avaria</h3>
                        <p>Marque arranhões, mossas e trincas no diagrama interativo da carroceria e anexe fotos obrigatórias na entrada do veículo.</p>
                        <ul class="f-micro-list">
                            <li>Armazenamento seguro em nuvem</li>
                            <li>Comprovante com termo de aceite</li>
                        </ul>
                    </article>

                    <article class="feature-box">
                        <div class="f-num">03</div>
                        <div class="f-icon-wrap">💬</div>
                        <h3>Automação de WhatsApp</h3>
                        <p>Envie comprovantes digitais, atualizações de status e avisos de carro pronto direto no WhatsApp sem pagar taxa por mensagem.</p>
                        <ul class="f-micro-list">
                            <li>Pareamento via QR Code em 30s</li>
                            <li>Link público com sua logomarca</li>
                        </ul>
                    </article>

                    <article class="feature-box">
                        <div class="f-num">04</div>
                        <div class="f-icon-wrap">🏷️</div>
                        <h3>Tabela de Preços por Porte</h3>
                        <p>Defina preços e durações distintas para Hatch/Sedan, SUV, Picape/Van e Moto em serviços como Ducha, Higienização e Polimento.</p>
                        <ul class="f-micro-list">
                            <li>Previsão de entrega precisa</li>
                            <li>Elimina cobranças divergentes</li>
                        </ul>
                    </article>

                    <article class="feature-box">
                        <div class="f-num">05</div>
                        <div class="f-icon-wrap">🅿️</div>
                        <h3>Gestão de Pátio e Boxes</h3>
                        <p>Acompanhe em tempo real a ocupação de cada box de lavagem, secagem e detalhamento para não formar gargalos.</p>
                        <ul class="f-micro-list">
                            <li>Alertas de tempo excedido</li>
                            <li>Visualização clara por status</li>
                        </ul>
                    </article>

                    <article class="feature-box">
                        <div class="f-num">06</div>
                        <div class="f-icon-wrap">👥</div>
                        <h3>Equipe e Comissões</h3>
                        <p>Cadastre lavadores, polidores e recepcionistas com regras automáticas de comissão por serviço (percentual ou valor fixo).</p>
                        <ul class="f-micro-list">
                            <li>Extrato de comissão individual</li>
                            <li>Fechamento com 1 clique</li>
                        </ul>
                    </article>
                </div>
            </div>
        </section>

        <!-- INTERACTIVE ROI CALCULATOR -->
        <section class="roi-section" id="roi">
            <div class="section-container">
                <div class="section-header center">
                    <div class="section-tag">CALCULADORA DE RETORNO</div>
                    <h2 class="section-title">Veja quanto dinheiro você está deixando na mesa</h2>
                    <p class="section-subtitle">
                        Simule o impacto financeiro do Lavaway no faturamento mensal do seu estabelecimento.
                    </p>
                </div>

                <div class="roi-calculator-card">
                    <div class="roi-controls">
                        <div class="roi-control-group">
                            <div class="slider-header">
                                <label for="daily-cars-slider">Quantos carros você atende por dia?</label>
                                <span class="slider-value">@_calcDailyCars veículos/dia</span>
                            </div>
                            <input id="daily-cars-slider" type="range" min="5" max="100" step="5" @bind="_calcDailyCars" @bind:event="oninput" />
                        </div>

                        <div class="roi-control-group">
                            <div class="slider-header">
                                <label for="avg-ticket-slider">Ticket médio por serviço (R$)</label>
                                <span class="slider-value">R$ @_calcAvgTicket,00</span>
                            </div>
                            <input id="avg-ticket-slider" type="range" min="30" max="350" step="5" @bind="_calcAvgTicket" @bind:event="oninput" />
                        </div>

                        <div class="roi-helper-note">
                            * Consideramos 26 dias úteis/mês e uma taxa de retenção média de 18% obtida com lembretes automáticos no WhatsApp.
                        </div>
                    </div>

                    <div class="roi-results-board">
                        <div class="roi-result-metric primary">
                            <span class="rm-label">POTENCIAL DE FATURAMENTO EXTRA MENSAL</span>
