    private void CloseAudienceModal()
    {
        _selectedAudienceRule = null;
        _audienceList = [];
    }

    private async Task DispatchCampaignAsync(ReactivationCampaignRuleDto rule)
    {
        _isProcessing = true;
        _errorMessage = null;
        CloseAudienceModal();

        try
        {
            var result = await AfterSalesApi.DispatchCampaignRuleAsync(rule.Id);
            _successMessage = $"Campanha {rule.DaysInactive} dias executada! Disparados: {result.TotalDispatched} mensagens via WhatsApp. Bloqueados por anti-spam: {result.TotalSkippedFrequencyCap}. Opt-outs respeitados: {result.TotalSkippedOptOut}.";
            ToastService.ShowSuccess(_successMessage);
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Falha ao disparar campanha: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private List<CustomerCommunicationPreferenceDto> FilteredPreferences
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_preferenceSearchQuery))
            {
                return _preferences;
            }
            var q = _preferenceSearchQuery.Trim().ToLowerInvariant();
            return _preferences.Where(p => p.NormalizedPhone.Contains(q) || (p.Reason?.ToLowerInvariant().Contains(q) ?? false)).ToList();
        }
    }

    private async Task ToggleCustomerPreferenceAsync(CustomerCommunicationPreferenceDto pref)
    {
        _isProcessing = true;
        _errorMessage = null;
        try
        {
            var targetOptIn = !pref.IsOptedIn;
            var reason = targetOptIn ? "Opt-in reativado manualmente pelo operador no painel" : "Opt-out manual solicitado pelo cliente";
            var updated = await AfterSalesApi.TogglePreferenceAsync(new UpdateCustomerPreferenceRequest(pref.NormalizedPhone, targetOptIn, reason));

            var idx = _preferences.FindIndex(p => p.NormalizedPhone == pref.NormalizedPhone);
            if (idx >= 0)
            {
                _preferences[idx] = updated;
            }
            _successMessage = $"Preferência do telefone {FormatPhone(pref.NormalizedPhone)} alterada para {(targetOptIn ? "Permitido" : "Bloqueado")}.";
            ToastService.ShowSuccess(_successMessage);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Falha ao alterar preferência: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task HandleManualOptOutAsync()
    {
        if (string.IsNullOrWhiteSpace(_manualOptPhone)) return;
        _isProcessing = true;
        _errorMessage = null;
        try
        {
            var updated = await AfterSalesApi.TogglePreferenceAsync(new UpdateCustomerPreferenceRequest(
                _manualOptPhone.Trim(),
                false,
                "Opt-out registrado manualmente pelo operador"));

            var idx = _preferences.FindIndex(p => p.NormalizedPhone == updated.NormalizedPhone);
            if (idx >= 0)
            {
                _preferences[idx] = updated;
            }
            else
            {
                _preferences.Insert(0, updated);
            }

            _successMessage = $"Opt-Out para {_manualOptPhone} registrado com sucesso.";
            ToastService.ShowSuccess(_successMessage);
            _manualOptPhone = string.Empty;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Falha ao registrar opt-out manual: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private static string FormatPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "—";
        var clean = new string(phone.Where(char.IsDigit).ToArray());
        if (clean.StartsWith("55") && clean.Length == 13)
        {
            clean = clean[2..];
        }
        if (clean.Length == 11)
        {
            return $"({clean[..2]}) {clean.Substring(2, 5)}-{clean.Substring(7)}";
        }
        if (clean.Length == 10)
        {
            return $"({clean[..2]}) {clean.Substring(2, 4)}-{clean.Substring(6)}";
        }
        return phone;
    }

