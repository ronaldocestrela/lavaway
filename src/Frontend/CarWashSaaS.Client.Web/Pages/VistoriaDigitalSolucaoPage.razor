@layout LandingLayout

<PageTitle>App de Vistoria Veicular com Fotos para Lava-Jato | Lava Aê</PageTitle>

<HeadContent>
    <meta name="description" content="App de vistoria veicular com fotos e laudo em PDF no WhatsApp para lava-jato e estética automotiva. Elimine prejuízos com avarias prévias e registre o estado do carro em 35 segundos." />
    <link rel="canonical" href="https://lavaae.app/funcionalidades/vistoria-digital" />
    <meta property="og:title" content="App de Vistoria Veicular com Fotos para Lava-Jato | Lava Aê" />
    <meta property="og:description" content="Checklist digital de entrada com diagrama tátil de 5 vistas, 4 fotos obrigatórias de perímetro e envio automático do laudo em PDF no WhatsApp do cliente." />
    <meta property="og:url" content="https://lavaae.app/funcionalidades/vistoria-digital" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://lavaae.app/icon-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="App de Vistoria Veicular com Fotos para Lava-Jato | Lava Aê" />
    <meta name="twitter:description" content="Vistoria digital em 35 segundos no celular. Blindagem jurídica para lava-rápidos e estéticas automotivas." />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "Lava Aê - Vistoria Digital com Fotos e Laudo em PDF",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS (Cloud SaaS)",
          "offers": {
            "@@type": "Offer",
            "price": "77.90",
            "priceCurrency": "BRL",
            "description": "Incluso a partir do plano Básico (77,90) com recepção, vistoria, fotos e laudo WhatsApp"
          },
          "description": "Sistema de vistoria digital de entrada para lava-jatos e centros de estética automotiva com diagrama de avarias em 5 vistas, fotos de perímetro e laudo imediato no WhatsApp."
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Início",
              "item": "https://lavaae.app/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Soluções",
              "item": "https://lavaae.app/#recursos"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Vistoria Digital",
              "item": "https://lavaae.app/funcionalidades/vistoria-digital"
            }
          ]
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Preciso de internet rápida na pista para fazer a vistoria no celular?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O aplicativo opera diretamente pelo navegador do smartphone ou tablet com compressão inteligente das 4 fotos obrigatórias, funcionando perfeitamente em redes Wi-Fi comuns de pátio ou dados móveis 4G/5G."
              }
            },
            {
              "@@type": "Question",
              "name": "O cliente precisa baixar algum aplicativo para ver o laudo de vistoria?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O cliente final não instala nada. O laudo de vistoria com mapa de avarias, fotos de alta resolução e conferência de estepe/combustível é disparado automaticamente em PDF direto no WhatsApp dele no check-in."
              }
            },
            {
              "@@type": "Question",
              "name": "O laudo com fotos protege o lava-jato legalmente contra contestações?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Ao registrar as fotos com data, hora, coordenadas de avarias e enviar no WhatsApp do proprietário no ato da entrada, você cria uma prova documental imutável que neutraliza contestações de danos pré-existentes na lataria ou rodas."
              }
            },
            {
              "@@type": "Question",
              "name": "Em quais planos do Lava Aê a vistoria digital está inclusa?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "A recepção e a vistoria digital completa com fotos de perímetro e diagrama de 5 vistas estão inclusas desde o plano Básico (77,90), sem custos ocultos por vistoria realizada."
              }
            },
            {
              "@@type": "Question",
              "name": "Consigo cadastrar veículos com placa antiga além da placa Mercosul?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. A busca e o cadastro inteligente aceitam placas no padrão Mercosul (ex: ABC1D23) e placas cinzas tradicionais (ex: ABC-1234), além de permitir o check-in por número de telefone do cliente."
              }
            }
          ]
        }
      ]
    }
    </script>
</HeadContent>

<div class="solution-page">
