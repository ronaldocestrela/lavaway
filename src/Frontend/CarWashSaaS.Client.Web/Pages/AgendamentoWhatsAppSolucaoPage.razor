@page "/funcionalidades/agendamento-whatsapp"
@layout LandingLayout

<PageTitle>Sistema para Lava-Jato com Agendamento Automático no WhatsApp | Lava Aê</PageTitle>

<HeadContent>
    <meta name="description" content="Sistema para lava-jato com agendamento automático no WhatsApp 24/7. Agende clientes por porte de veículo sem aplicativo, previna faltas com lembretes automáticos e lote seus boxes." />
    <link rel="canonical" href="https://lavaae.app/funcionalidades/agendamento-whatsapp" />
    <meta property="og:title" content="Sistema para Lava-Jato com Agendamento Automático no WhatsApp | Lava Aê" />
    <meta property="og:description" content="Atendente virtual 24/7 via QR Code no número da sua loja. Agendamento conforme capacidade real de boxes, lembretes anti-falta automáticos e liberação imediata de horários." />
    <meta property="og:url" content="https://lavaae.app/funcionalidades/agendamento-whatsapp" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://lavaae.app/icon-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sistema para Lava-Jato com Agendamento Automático no WhatsApp | Lava Aê" />
    <meta name="twitter:description" content="Agendamento automático 24/7 no WhatsApp para lava-jato e estética automotiva. Elimine o 'vou ver e te aviso' e acabe com os buracos na agenda." />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "Lava Aê - Agendamento & Atendimento WhatsApp 24/7",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS (Cloud SaaS)",
          "offers": {
            "@@type": "Offer",
            "price": "127.00",
            "priceCurrency": "BRL",
            "description": "Chatbot conversacional 24/7 incluso no plano Pro (R$ 127/mês com até 1.500 msgs e 5 boxes) e Enterprise (R$ 197/mês ilimitado). Agenda manual disponível no plano Básico."
          },
          "description": "Sistema de agendamento conversacional automático 24 horas no WhatsApp para lava-jatos e estética automotiva, conectado à capacidade real de boxes e sem taxa extra por mensagem dentro da cota."
        },
        {
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Início",
              "item": "https://lavaae.app/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Soluções",
              "item": "https://lavaae.app/#recursos"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Agendamento WhatsApp",
              "item": "https://lavaae.app/funcionalidades/agendamento-whatsapp"
            }
          ]
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "O cliente precisa baixar algum aplicativo para agendar uma lavagem?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O cliente conversa diretamente pelo WhatsApp oficial do seu próprio lava-jato. Ele escolhe o serviço pelo porte do veículo, seleciona o horário vago e recebe a confirmação imediata sem instalar nenhum app."
              }
            },
            {
              "@@type": "Question",
              "name": "O que acontece quando o cliente cancela ou quer remarcar o horário?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O próprio cliente remarca ou cancela pelo WhatsApp com comandos simples. Ao cancelar, o sistema desocupa imediatamente o box na sua grade de agendamentos, liberando a vaga para outro motorista sem intervenção manual."
              }
            },
            {
              "@@type": "Question",
              "name": "O sistema cobra taxa por cada mensagem enviada no WhatsApp?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não. O Lava Aê não cobra taxas adicionais por disparo dentro da cota do seu plano. O plano Básico inclui 300 mensagens/ciclo, o plano Pro inclui 1.500 mensagens/ciclo e o Enterprise possui disparos ilimitados."
              }
            },
            {
              "@@type": "Question",
              "name": "O robô respeita o limite de carros que minha equipe consegue lavar por hora?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. O agendamento é sincronizado em tempo real com a capacidade física configurada de boxes e o tempo de execução de cada serviço por porte (Hatch/Sedan, SUV, Picape/Van ou Moto), impedindo sobreposição e lotação excessiva."
              }
            },
            {
              "@@type": "Question",
              "name": "Como funciona a prevenção de faltas (no-show)?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O Lava Aê dispara lembretes automáticos no WhatsApp 24 horas e 2 horas antes do horário marcado, solicitando a confirmação do cliente e reduzindo drasticamente os buracos na pista causados por esquecimentos."
              }
            }
          ]
        }
      ]
    }
    </script>
</HeadContent>

<div class="solution-page">
    <!-- TOP STICKY BAR -->
    <header class="solution-navbar">
        <div class="solution-container navbar-inner">
            <a href="/" class="brand-link" aria-label="Ir para a página inicial do Lava Aê">
                <img src="/icon-192.png" alt="Lava Aê" width="32" height="32" class="brand-logo" />
                <span class="brand-name">Lava Aê</span>
            </a>

            <div class="navbar-actions">
                <a href="/#planos" class="nav-link-subtle">Ver Planos</a>
                <a href="/authentication/login" class="btn-login-ghost">Entrar</a>
                <a href="/authentication/login" class="btn-top-cta">Testar 14 Dias Grátis</a>
            </div>
        </div>
    </header>

    <main class="solution-main">
        <!-- HERO SECTION -->
        <section class="hero-solution">
            <div class="solution-container">
                <nav class="breadcrumb-trail" aria-label="Breadcrumb">
                    <a href="/">Início</a>
                    <span class="separator">/</span>
                    <a href="/#recursos">Soluções</a>
                    <span class="separator">/</span>
                    <span class="current">Agendamento WhatsApp</span>
                </nav>

                <div class="hero-badge">
                    <span class="badge-dot"></span>
                    <span>ATENDIMENTO E AGENDA 24 HORAS NO WHATSAPP</span>
                </div>

                <h1 class="hero-heading">
                    Sistema para lava-jato com agendamento automático no WhatsApp: <span class="highlight-text">boxes cheios sem você passar o dia respondendo mensagem</span>.
                </h1>

                <p class="hero-lead">
                    Conecte o número da sua loja via QR Code. Seu cliente consulta o catálogo por porte do veículo, agenda o horário sozinho e recebe lembretes anti-falta automáticos enquanto você cuida da pista e do giro dos carros.
                </p>

                <div class="hero-cta-group">
                    <a href="/authentication/login" class="btn-primary-action">
                        <span>Testar Agendamento Grátis por 14 Dias</span>
                        <span class="arrow">&rarr;</span>
                    </a>
                    <a href="#comparativo" class="btn-secondary-action">
                        <span>Comparar com Atendimento Manual</span>
                    </a>
                </div>

                <div class="hero-trust-bar">
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>O cliente não precisa baixar aplicativo</span>
                    </div>
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>Conexão rápida com o número do seu próprio WhatsApp</span>
                    </div>
                    <div class="trust-item">
                        <span class="check-icon">&#10003;</span>
                        <span>Lembretes automáticos 24h e 2h antes</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ANSWER-FIRST BLOCK (GEO / IA OVERVIEWS) -->
        <section class="answer-first-section">
            <div class="solution-container">
                <div class="answer-card">
                    <div class="answer-badge">RESPOSTA DIRETA PARA GESTORES</div>
                    <h2 class="answer-title">O que é e como funciona o Agendamento no WhatsApp do Lava Aê?</h2>
                    <p class="answer-paragraph">
                        O <strong>Agendamento no WhatsApp do Lava Aê</strong> é um atendente inteligente 24/7 conectado diretamente ao número da sua loja via QR Code. O cliente consulta preços por porte do veículo (*Hatch/Sedan, SUV, Picape/Van, Moto*), escolhe horários conforme a capacidade real de boxes, recebe lembretes anti-falta automáticos e pode remarcar sozinho, liberando a vaga no pátio sem intervenção manual.
                    </p>
                </div>
            </div>
        </section>

        <!-- OPERATIONAL COMPARISON TABLE -->
        <section class="comparison-section" id="comparativo">
            <div class="solution-container">
                <div class="section-header">
                    <span class="section-tag">CONFRONTO OPERACIONAL</span>
                    <h2 class="section-title">Responder no dedo vs. Agendamento 24h sincronizado aos boxes</h2>
                    <p class="section-subtitle">
                        Descubra quantos clientes você deixa de atender à noite e nos finais de semana por não ter um sistema respondendo no WhatsApp.
                    </p>
                </div>

                <div class="table-wrapper">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th scope="col" class="col-metric">Situação da Pista</th>
                                <th scope="col" class="col-legacy">Como é no WhatsApp Manual</th>
                                <th scope="col" class="col-lavaae">Como funciona com o Lava Aê</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="metric-name">Mensagens Fora do Expediente</td>
                                <td class="legacy-val">Cliente manda mensagem às 21h pedindo horário para sábado de manhã; você só vê no dia seguinte e ele já agendou no concorrente.</td>
                                <td class="lavaae-val"><strong>Atendimento 24/7 automático:</strong> o cliente escolhe o serviço, confere a grade disponível e confirma a vaga na hora.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Controle de Capacidade dos Boxes</td>
                                <td class="legacy-val">Você marca 3 SUVs no mesmo horário de cabeça, a lavadora não dá conta e a fila de espera vira reclamação na porta.</td>
                                <td class="lavaae-val"><strong>Trava real de capacidade:</strong> o sistema só libera horários de acordo com o tempo do serviço e a quantidade de boxes livres.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Faltas e Horários Ociosos (No-Show)</td>
                                <td class="legacy-val">Cliente esquece que agendou, o box fica vazio por 1 hora e a equipe de lavadores fica parada gerando prejuízo.</td>
                                <td class="lavaae-val"><strong>Lembretes anti-falta 24h e 2h antes:</strong> o cliente confirma a presença ou clica para remarcar, liberando o box para outro.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Preços por Porte do Veículo</td>
                                <td class="legacy-val">Você digita tabelas de preço repetitivas dezenas de vezes ao dia pelo teclado do celular enquanto atende no caixa.</td>
                                <td class="lavaae-val"><strong>Catálogo inteligente por porte:</strong> o cliente seleciona Hatch/Sedan, SUV, Picape ou Moto e vê os valores exatos de imediato.</td>
                            </tr>
                            <tr>
                                <td class="metric-name">Comandos Rápidos do Cliente</td>
                                <td class="legacy-val">Cliente liga ou manda áudio pedindo chave Pix, saldo de fidelidade ou comprovante, exigindo parada do atendimento.</td>
                                <td class="lavaae-val"><strong>Autoatendimento por palavras-chave:</strong> cliente digita <code>PIX</code>, <code>PAGAR</code>, <code>FIDELIDADE</code> ou <code>SELOS</code> e resolve na hora.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- STEP BY STEP ON THE TRACK -->
        <section class="workflow-section">
            <div class="solution-container">
                <div class="section-header">
                    <span class="section-tag">PASSO A PASSO NA PRÁTICA</span>
                    <h2 class="section-title">Como o motorista agenda sozinho em 4 passos simples</h2>
                    <p class="section-subtitle">
                        Sem telas difíceis, sem login demorado e sem precisar baixar aplicativo da loja de apps.
                    </p>
                </div>

                <div class="steps-grid">
                    <div class="step-card">
                        <div class="step-number">01</div>
                        <h3 class="step-title">Mensagem no seu WhatsApp</h3>
                        <p class="step-description">
                            O cliente envia um "Oi" ou clica no link da sua bio do Instagram. O robô responde em segundos apresentando as opções de serviços e catálogo.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">02</div>
                        <h3 class="step-title">Escolha do Porte e Serviço</h3>
                        <p class="step-description">
                            O motorista informa se o carro é Hatch/Sedan, SUV, Picape/Van ou Moto e seleciona lavagem simples, detalhada, polimento ou higienização interna.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">03</div>
                        <h3 class="step-title">Seleção de Dia e Horário Real</h3>
                        <p class="step-description">
                            O sistema apresenta apenas os horários com boxes realmente livres. O cliente escolhe o melhor momento e o agendamento é registrado na sua grade.
                        </p>
                    </div>

                    <div class="step-card">
                        <div class="step-number">04</div>
                        <h3 class="step-title">Lembretes Automáticos Anti-Falta</h3>
                        <p class="step-description">
                            24 horas e 2 horas antes da lavagem, o motorista recebe aviso de confirmação. Se precisar remarcar, o box vaga na hora para outro motorista.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- TECHNICAL SPECS & PLAN INCLUSION -->
        <section class="specs-section">
            <div class="solution-container">
                <div class="specs-box">
                    <div class="specs-header">
                        <span class="specs-badge">ESPECIFICAÇÕES TÉCNICAS E PLANOS</span>
                        <h2 class="specs-title">Tudo o que está incluído no módulo de agendamento</h2>
                        <p class="specs-lead">
                            Sem surpresas na fatura: a automação de WhatsApp do Lava Aê não cobra taxas extras por mensagem disparada dentro da cota do seu plano.
                        </p>
