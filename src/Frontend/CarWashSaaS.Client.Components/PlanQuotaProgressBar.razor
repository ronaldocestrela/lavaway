<div class="quota-progress-container">
    <div class="quota-progress-header">
        <span class="quota-title">@Title</span>
        <span class="quota-numbers">
            @if (IsUnlimited)
            {
                <span class="quota-badge-unlimited">
                    <svg class="quota-badge-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Ilimitado (@Used consumidas)
                </span>
            }
            else
            {
                <span><strong>@Used</strong> / @Max (@Percentage%)</span>
            }
        </span>
    </div>

    @if (!IsUnlimited)
    {
        <div class="quota-bar-track">
            <div class="quota-bar-fill @ProgressBarColorClass"
                 style="width: @(Math.Min(Percentage, 100))%"></div>
        </div>

        @if (Percentage >= 90)
        {
            <p class="quota-warning-hint">
                <svg class="quota-warning-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span>Atenção: sua cota mensal está quase esgotada (@(Max - Used) restantes).</span>
            </p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public int Used { get; set; }

    [Parameter, EditorRequired]
    public int Max { get; set; }

    private bool IsUnlimited => Max <= 0;

    private int Percentage => Max > 0 ? (int)Math.Round((double)Used / Max * 100) : 0;

    private string ProgressBarColorClass => Percentage switch
    {
        >= 100 => "bar-danger",
        >= 80 => "bar-warning",
        _ => "bar-normal"
    };
}
