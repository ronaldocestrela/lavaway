@using CarWashSaaS.Shared.Contracts

@if (Status == TenantSubscriptionStatus.GracePeriod)
{
    <div class="alert-banner alert-grace" role="alert">
        <div class="alert-icon-wrapper">
            <svg class="alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <div class="alert-content">
            <h4 class="alert-title">Período de Tolerância Ativo (Fatura Pendente)</h4>
            <p class="alert-text">
                Sua assinatura do Lavaway possui uma fatura em aberto. Você pode continuar operando até
                <strong>@(GracePeriodEndsAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? "breve")</strong>. Após este prazo, o acesso à emissão de novas OS será suspenso.
            </p>
            @if (OnSettleClicked.HasDelegate)
            {
                <div class="alert-actions">
                    <button type="button" @onclick="OnSettleClicked" class="btn-alert-action">
                        <svg class="btn-action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                        </svg>
                        <span>Regularizar Fatura com Pix</span>
                    </button>
                </div>
            }
        </div>
    </div>
}
else if (Status == TenantSubscriptionStatus.Delinquent)
{
    <div class="alert-banner alert-delinquent" role="alert">
        <div class="alert-icon-wrapper">
            <svg class="alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
        </div>
        <div class="alert-content">
            <h4 class="alert-title">Operação Suspensa por Inadimplência</h4>
            <p class="alert-text">
                O período de tolerância expirou. A abertura de novas ordens de serviço e o envio de mensagens WhatsApp foram bloqueados temporariamente.
            </p>
            @if (OnSettleClicked.HasDelegate)
            {
                <div class="alert-actions">
                    <button type="button" @onclick="OnSettleClicked" class="btn-alert-action">
                        <svg class="btn-action-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Pagar e Desbloquear Acesso Imediatamente</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public TenantSubscriptionStatus Status { get; set; } = TenantSubscriptionStatus.Active;

    [Parameter]
    public DateTimeOffset? GracePeriodEndsAtUtc { get; set; }

    [Parameter]
    public EventCallback OnSettleClicked { get; set; }
}
