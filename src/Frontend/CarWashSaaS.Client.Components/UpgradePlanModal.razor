@using CarWashSaaS.Shared.Contracts

@if (IsOpen)
{
    <div class="modal-overlay" role="dialog" aria-modal="true">
        <div class="modal-card">
            <!-- Header -->
            <div class="modal-header">
                <div>
                    <h3 class="modal-title">Planos de Assinatura Lava Aê</h3>
                    <p class="modal-subtitle">Escolha o plano ideal para a capacidade e recursos do seu estabelecimento</p>
                </div>
                <button type="button" @onclick="Close" class="modal-close-btn" aria-label="Fechar">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Cards -->
            <div class="plans-grid">
                @foreach (var plan in Plans)
                {
                    var isCurrent = plan.Tier == CurrentTier;
                    var isSelected = plan.Tier == SelectedTier;

                    <div class="plan-card @(isSelected ? "is-selected" : "") @(isCurrent ? "is-current" : "")">
                        @if (isCurrent)
                        {
                            <span class="plan-badge badge-current">Plano Atual</span>
                        }
                        else if (plan.Tier == SaasPlanTier.Pro)
                        {
                            <span class="plan-badge badge-popular">Mais Popular</span>
                        }

                        <div class="plan-card-body">
                            <h4 class="plan-card-name">@plan.Name</h4>
                            <p class="plan-card-desc">@plan.Description</p>

                            <div class="plan-card-price-row">
                                <span class="plan-card-price">R$ @plan.MonthlyPrice.ToString("N2")</span>
                                <span class="plan-card-period">/mês</span>
                            </div>

                            <ul class="plan-features-list">
                                <li class="plan-feature-item">
                                    <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@(plan.MaxBoxes <= 0 ? "Boxes Ilimitados" : $"Até {plan.MaxBoxes} boxes de pátio")</span>
                                </li>
                                <li class="plan-feature-item">
                                    <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@(plan.MaxTeamMembers >= 999 ? "Equipe Ilimitada" : $"Até {plan.MaxTeamMembers} membros na equipe")</span>
                                </li>
                                <li class="plan-feature-item">
                                    <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@(plan.MaxWorkOrdersPerCycle > 0 ? $"Até {plan.MaxWorkOrdersPerCycle} OS/mês" : "OS Ilimitadas")</span>
                                </li>
                                <li class="plan-feature-item">
                                    <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@(plan.MaxWhatsAppMessagesPerCycle > 0 ? $"Até {plan.MaxWhatsAppMessagesPerCycle} msgs WhatsApp" : "WhatsApp Ilimitado")</span>
                                </li>
                                <li class="plan-feature-item">
                                    @if (plan.HasCustomerSubscriptions)
                                    {
                                        <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>Clube de Assinaturas</span>
                                    }
                                    else
                                    {
                                        <span class="feature-disabled">✕ Clube de Assinaturas</span>
                                    }
                                </li>
                                <li class="plan-feature-item">
                                    @if (plan.HasLoyalty)
                                    {
                                        <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>Fidelidade &amp; Comissões</span>
                                    }
                                    else
                                    {
                                        <span class="feature-disabled">✕ Fidelidade &amp; Comissões</span>
                                    }
                                </li>
                                <li class="plan-feature-item">
                                    @if (plan.HasAiChatbot)
                                    {
                                        <svg class="feature-check" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>Bot Conversacional IA</span>
                                    }
                                    else
                                    {
                                        <span class="feature-disabled">✕ Bot Conversacional IA</span>
                                    }
                                </li>
                            </ul>
                        </div>

                        <div class="plan-card-footer">
                            @if (isCurrent)
                            {
                                <button type="button" disabled class="btn-select-plan">
                                    Plano Atual
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => SelectTier(plan.Tier)"
                                        class="btn-select-plan @(isSelected ? "is-active-selection" : "")">
                                    @(isSelected ? "Selecionado" : "Mudar para este")
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" @onclick="Close" class="btn-modal-cancel">
                    Cancelar
                </button>
                <button type="button" @onclick="ConfirmStripeCheckout"
                        disabled="@(SelectedTier == null || SelectedTier == CurrentTier || IsLoading)"
                        class="btn-modal-stripe-checkout">
                    @if (IsLoading)
                    {
                        <svg class="spinner-icon" fill="none" viewBox="0 0 24 24">
                            <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Aguarde...</span>
                    }
                    else
                    {
                        <svg class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                        </svg>
                        <span>Contratar no Cartão (Stripe)</span>
                    }
                </button>
                @*<button type="button" @onclick="ConfirmPlanChange"
                        disabled="@(SelectedTier == null || SelectedTier == CurrentTier || IsLoading)"
                        class="btn-modal-confirm">
                    @if (IsLoading)
                    {
                        <svg class="spinner-icon" fill="none" viewBox="0 0 24 24">
                            <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Processando...</span>
                    }
                    else
                    {
                        <span>Confirmar Alteração</span>
                    }
                </button>*@
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public SaasPlanTier CurrentTier { get; set; } = SaasPlanTier.Basic;

    [Parameter]
    public IReadOnlyList<SaasPlanDto> Plans { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<SaasPlanTier> OnConfirm { get; set; }

    [Parameter]
    public EventCallback<SaasPlanTier> OnConfirmCheckout { get; set; }

    private SaasPlanTier? SelectedTier { get; set; }
    private bool IsLoading { get; set; }

    protected override void OnParametersSet()
    {
        if (SelectedTier == null)
        {
            SelectedTier = CurrentTier == SaasPlanTier.Basic ? SaasPlanTier.Pro : CurrentTier;
        }
    }

    private void SelectTier(SaasPlanTier tier) => SelectedTier = tier;

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task ConfirmPlanChange()
    {
        if (SelectedTier.HasValue && SelectedTier != CurrentTier)
        {
            IsLoading = true;
            try
            {
                await OnConfirm.InvokeAsync(SelectedTier.Value);
            }
            finally
            {
                IsLoading = false;
            }
        }
    }

    private async Task ConfirmStripeCheckout()
    {
        if (SelectedTier.HasValue && SelectedTier != CurrentTier)
        {
            IsLoading = true;
            try
            {
                if (OnConfirmCheckout.HasDelegate)
                {
                    await OnConfirmCheckout.InvokeAsync(SelectedTier.Value);
                }
                else
                {
                    await OnConfirm.InvokeAsync(SelectedTier.Value);
                }
            }
            finally
            {
                IsLoading = false;
            }
        }
    }
}
