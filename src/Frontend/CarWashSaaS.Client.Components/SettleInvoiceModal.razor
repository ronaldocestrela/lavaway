@using CarWashSaaS.Shared.Contracts

@if (IsOpen && Invoice is not null)
{
    <div class="modal-overlay" role="dialog" aria-modal="true">
        <div class="modal-card">
            <!-- Header -->
            <div class="modal-header">
                <div>
                    <h3 class="modal-title">Pagamento de Fatura</h3>
                    <p class="modal-subtitle">Fatura @Invoice.GatewayInvoiceId</p>
                </div>
                <button type="button" @onclick="Close" class="modal-close-btn" aria-label="Fechar">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="modal-body">
                <span class="pix-amount">R$ @Invoice.Amount.ToString("N2")</span>
                <span class="pix-due-date">Vencimento: @Invoice.DueDateUtc.ToString("dd/MM/yyyy")</span>

                @if (!string.IsNullOrWhiteSpace(Invoice.PixQrCode))
                {
                    <div class="qrcode-box">
                        <img src="@Invoice.PixQrCode" alt="QR Code Pix" class="qrcode-img" />
                    </div>
                    <span class="qrcode-instruction">Abra o app do seu banco e aponte a câmera</span>
                }

                @if (!string.IsNullOrWhiteSpace(Invoice.PixCopiaECola))
                {
                    <div class="copiacola-section">
                        <label class="copiacola-label">Código Pix Copia e Cola:</label>
                        <div class="copiacola-input-group">
                            <input type="text" readonly value="@Invoice.PixCopiaECola" class="copiacola-input" />
                            <button type="button" @onclick="CopyPixCode" class="btn-copy">
                                @(Copied ? "Copiado!" : "Copiar")
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Actions -->
            <div class="modal-footer">
                <button type="button" @onclick="ConfirmSettlement" disabled="@IsLoading" class="btn-confirm-settle">
                    @if (IsLoading)
                    {
                        <span>Confirmando Pagamento...</span>
                    }
                    else
                    {
                        <span>Simular Confirmação Pix (Baixa Imediata)</span>
                    }
                </button>
                <button type="button" @onclick="Close" class="btn-close-flat">
                    Fechar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public SaasInvoiceDto? Invoice { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSettle { get; set; }

    private bool Copied { get; set; }
    private bool IsLoading { get; set; }

    private void CopyPixCode()
    {
        Copied = true;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task ConfirmSettlement()
    {
        if (Invoice is null) return;
        IsLoading = true;
        try
        {
            await OnSettle.InvokeAsync(Invoice.Id);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
