@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.JSInterop
@inject BillingApiClient BillingClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleClose">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="header-titles">
                    <span class="modal-eyebrow">PAGAMENTO INSTANTÂNEO</span>
                    <h3 class="modal-title">Cobrança Pix da OS</h3>
                </div>
                <button type="button" class="btn-close" @onclick="HandleClose" aria-label="Fechar">&times;</button>
            </div>

            <div class="modal-body">
                <div class="order-summary-strip">
                    <div class="summary-field">
                        <span class="field-label">Veículo</span>
                        <span class="field-value plate-badge">@Plate</span>
                    </div>
                    <div class="summary-field">
                        <span class="field-label">Cliente</span>
                        <span class="field-value">@CustomerName</span>
                    </div>
                    <div class="summary-field">
                        <span class="field-label">Valor Total</span>
                        <span class="field-value price-highlight">
                            @((_charge?.Amount ?? TotalAmount).ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))
                        </span>
                    </div>
                    <div class="summary-field">
                        <span class="field-label">Status</span>
                        <span class="field-value">
                            @if (_charge is not null)
                            {
                                <span class="status-tag status-@_charge.Status.ToLowerInvariant()">
                                    @FormatStatus(_charge.Status)
                                </span>
                            }
                            else
                            {
                                <span class="status-tag status-pending">Calculando</span>
                            }
                        </span>
                    </div>
                </div>

                @if (_isLoading)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <span>Gerando QR Code Pix dinâmico com o gateway...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="error-state">
                        <span class="error-icon">⚠️</span>
                        <p class="error-text">@_errorMessage</p>
                        <button type="button" class="btn btn-secondary" @onclick="LoadOrGeneratePixAsync">Tentar Novamente</button>
                    </div>
                }
                else if (_charge is not null)
                {
                    <div class="pix-content-grid">
                        <div class="qr-code-box">
                            @if (!string.IsNullOrWhiteSpace(_charge.QrCodeBase64))
                            {
                                var imageSrc = _charge.QrCodeBase64.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
                                    ? _charge.QrCodeBase64
                                    : $"data:image/svg+xml;base64,{_charge.QrCodeBase64}";

                                <img src="@imageSrc" alt="QR Code Pix" class="qr-code-image" />
                            }
                            <span class="qr-expiration-hint">
                                Válido até @_charge.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")
                            </span>
                        </div>

                        <div class="pix-details-column">
                            <label class="form-label" for="pix-copypaste">Código Pix Copia e Cola:</label>
                            <div class="copypaste-input-wrapper">
                                <textarea id="pix-copypaste"
                                          class="copypaste-textarea"
                                          readonly
                                          rows="4">@_charge.CopyPasteKey</textarea>
                            </div>

                            <button type="button"
                                    class="btn btn-copy @(_isCopied ? "btn-copied" : "")"
                                    @onclick="CopyPixCodeAsync">
                                @if (_isCopied)
                                {
                                    <span>✅ Código Copiado!</span>
                                }
                                else
                                {
                                    <span>📋 Copiar Código Pix</span>
                                }
                            </button>

                            <div class="whatsapp-dispatch-card">
                                <div class="whatsapp-card-info">
                                    <span class="whatsapp-title">📱 Envio ao Cliente</span>
                                    @if (_charge.WhatsAppSentAtUtc.HasValue)
                                    {
                                        <span class="whatsapp-sent-tag">
                                            Enviado em @_charge.WhatsAppSentAtUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="whatsapp-hint">Envie o QR Code e código diretamente no WhatsApp do cliente</span>
                                    }
                                </div>

                                <button type="button"
                                        class="btn btn-whatsapp"
                                        disabled="@_isSendingWhatsApp"
                                        @onclick="SendViaWhatsAppAsync">
                                    @if (_isSendingWhatsApp)
                                    {
                                        <span class="spinner-small"></span>
                                        <span>Enviando...</span>
                                    }
                                    else
                                    {
                                        <span>💬 Enviar via WhatsApp</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (_charge is not null && _charge.ExpiresAtUtc <= DateTimeOffset.UtcNow)
                {
                    <button type="button" class="btn btn-outline" @onclick="LoadOrGeneratePixAsync">
                        🔄 Gerar Nova Cobrança
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="HandleClose">Fechar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid WorkOrderId { get; set; }
    [Parameter] public string Plate { get; set; } = string.Empty;
    [Parameter] public string CustomerName { get; set; } = string.Empty;
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<WorkOrderPixChargeDto> OnChargeUpdated { get; set; }

    private bool _isLoading;
    private bool _isSendingWhatsApp;
    private bool _isCopied;
    private string? _errorMessage;
    private WorkOrderPixChargeDto? _charge;
    private Guid _lastWorkOrderId = Guid.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && (WorkOrderId != _lastWorkOrderId || _charge is null))
        {
            _lastWorkOrderId = WorkOrderId;
            await LoadOrGeneratePixAsync();
        }
        else if (!IsOpen)
        {
            _isCopied = false;
        }
    }

    private async Task LoadOrGeneratePixAsync()
    {
        if (WorkOrderId == Guid.Empty) return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            _charge = await BillingClient.GetOrCreatePixChargeAsync(WorkOrderId);
            if (OnChargeUpdated.HasDelegate)
            {
                await OnChargeUpdated.InvokeAsync(_charge);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CopyPixCodeAsync()
    {
        if (_charge is null) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _charge.CopyPasteKey);
            _isCopied = true;
            ToastService.ShowSuccess("Código Pix Copia e Cola copiado para a área de transferência!");
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                _isCopied = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            ToastService.ShowError("Não foi possível copiar automaticamente. Selecione e copie manualmente o texto.");
        }
    }

    private async Task SendViaWhatsAppAsync()
    {
        if (_charge is null || WorkOrderId == Guid.Empty) return;

        _isSendingWhatsApp = true;
        try
        {
            _charge = await BillingClient.SendPixChargeToWhatsAppAsync(WorkOrderId);
            ToastService.ShowSuccess("Cobrança Pix enviada com sucesso para o WhatsApp do cliente!");
            if (OnChargeUpdated.HasDelegate)
            {
                await OnChargeUpdated.InvokeAsync(_charge);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro ao enviar WhatsApp: {ex.Message}");
        }
        finally
        {
            _isSendingWhatsApp = false;
        }
    }

    private async Task HandleClose()
    {
        _charge = null;
        _lastWorkOrderId = Guid.Empty;
        await OnClose.InvokeAsync();
    }

    private static string FormatStatus(string status) => status switch
    {
        PixChargeStatusConstants.Pending => "Aguardando Pagamento",
        PixChargeStatusConstants.Paid => "Pago",
        PixChargeStatusConstants.Expired => "Expirado",
        PixChargeStatusConstants.Cancelled => "Cancelado",
        _ => status
    };
}
