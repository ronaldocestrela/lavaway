@using CarWashSaaS.Client.Core
@using CarWashSaaS.Shared.Contracts
@using Microsoft.AspNetCore.Components.Forms

<div class="wizard-container" role="region" aria-label="Fluxo guiado de perfil do estabelecimento">
    <!-- Stepper Header -->
    <div class="stepper-bar">
        <div class="step-item @(CurrentStep == 1 ? "step-active" : CurrentStep > 1 ? "step-completed" : "")" @onclick="() => TryGoToStep(1)">
            <div class="step-badge">
                @if (CurrentStep > 1)
                {
                    <span class="step-check" aria-hidden="true">✓</span>
                }
                else
                {
                    <span>01</span>
                }
            </div>
            <div class="step-info">
                <span class="step-caption">ETAPA 01</span>
                <span class="step-title">Identificação</span>
            </div>
        </div>

        <div class="step-divider @(CurrentStep > 1 ? "divider-active" : "")"></div>

        <div class="step-item @(CurrentStep == 2 ? "step-active" : CurrentStep > 2 ? "step-completed" : "")" @onclick="() => TryGoToStep(2)">
            <div class="step-badge">
                @if (CurrentStep > 2)
                {
                    <span class="step-check" aria-hidden="true">✓</span>
                }
                else
                {
                    <span>02</span>
                }
            </div>
            <div class="step-info">
                <span class="step-caption">ETAPA 02</span>
                <span class="step-title">Contato & Endereço</span>
            </div>
        </div>

        <div class="step-divider @(CurrentStep > 2 ? "divider-active" : "")"></div>

        <div class="step-item @(CurrentStep == 3 ? "step-active" : CurrentStep > 3 ? "step-completed" : "")" @onclick="() => TryGoToStep(3)">
            <div class="step-badge">
                @if (CurrentStep > 3)
                {
                    <span class="step-check" aria-hidden="true">✓</span>
                }
                else
                {
                    <span>03</span>
                }
            </div>
            <div class="step-info">
                <span class="step-caption">ETAPA 03</span>
                <span class="step-title">Identidade Visual</span>
            </div>
        </div>

        <div class="step-divider @(CurrentStep > 3 ? "divider-active" : "")"></div>

        <div class="step-item @(CurrentStep == 4 ? "step-active" : "")" @onclick="() => TryGoToStep(4)">
            <div class="step-badge">
                <span>04</span>
            </div>
            <div class="step-info">
                <span class="step-caption">ETAPA 04</span>
                <span class="step-title">Revisão & Salvar</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="feedback feedback-error" role="alert">
            <span class="feedback-symbol">!</span>
            <div class="feedback-text">@ErrorMessage</div>
        </div>
    }

    <!-- Step 1: Identificação -->
    @if (CurrentStep == 1)
    {
        <div class="step-panel" data-testid="step-1-panel">
            <div class="panel-intro">
                <h3>Dados de Identificação Jurídica</h3>
                <p>Informe a razão social, o nome de fachada e o CNPJ registrado da sua unidade.</p>
            </div>

            <div class="form-grid">
                <div class="field field-full">
                    <label for="legalName">Razão Social <span class="required">*</span></label>
                    <input id="legalName"
                           type="text"
                           maxlength="200"
                           placeholder="Ex: Lava Rápido e Estética Automotiva Ltda"
                           @bind="Model.LegalName"
                           @bind:event="oninput" />
                    <span class="field-hint">Nome oficial registrado na Receita Federal.</span>
                </div>

                <div class="field field-half">
                    <label for="tradeName">Nome Fantasia <span class="required">*</span></label>
                    <input id="tradeName"
                           type="text"
                           maxlength="200"
                           placeholder="Ex: Lavaway Express Centro"
                           @bind="Model.TradeName"
                           @bind:event="oninput" />
                    <span class="field-hint">Nome exibido nos comprovantes e no pátio.</span>
                </div>

                <div class="field field-half">
                    <label for="cnpj">CNPJ <span class="required">*</span></label>
                    <input id="cnpj"
                           type="text"
                           maxlength="18"
                           placeholder="00.000.000/0000-00"
                           value="@Model.Cnpj"
                           @oninput="HandleCnpjInput" />
                    <span class="field-hint">Apenas números ou formato com pontuação.</span>
                </div>
            </div>

            <div class="wizard-actions">
                <div class="actions-left">
                    <span class="mandatory-notice"><span class="required">*</span> Campos de preenchimento obrigatório</span>
                </div>
                <div class="actions-right">
                    <button type="button" class="button button-primary" @onclick="NextStep">
                        <span>Avançar para Contato</span>
                        <span class="button-arrow" aria-hidden="true">→</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Step 2: Contato & Endereço -->
    @if (CurrentStep == 2)
    {
        <div class="step-panel" data-testid="step-2-panel">
            <div class="panel-intro">
                <h3>Contato e Localização da Unidade</h3>
                <p>Estes dados serão utilizados para identificação no sistema e cabeçalhos de ordem de serviço.</p>
            </div>

            <div class="form-grid">
                <div class="field field-half">
                    <label for="phone">Telefone Principal / WhatsApp <span class="required">*</span></label>
                    <input id="phone"
                           type="tel"
                           maxlength="32"
                           placeholder="(11) 99999-9999"
                           @bind="Model.Phone"
                           @bind:event="oninput" />
                    <span class="field-hint">Telefone de atendimento do estabelecimento.</span>
                </div>

                <div class="field field-half">
                    <label for="postalCode">CEP <span class="required">*</span></label>
                    <input id="postalCode"
                           type="text"
                           maxlength="9"
                           placeholder="00000-000"
                           value="@Model.PostalCode"
                           @oninput="HandleCepInput" />
                    <span class="field-hint">Código de endereçamento postal da unidade.</span>
                </div>

                <div class="field field-full">
                    <label for="street">Endereço / Logradouro <span class="required">*</span></label>
                    <input id="street"
                           type="text"
                           maxlength="200"
                           placeholder="Ex: Av. das Américas, 1500 - Bloco B"
                           @bind="Model.Street"
                           @bind:event="oninput" />
                    <span class="field-hint">Rua, avenida, número e complemento.</span>
                </div>

                <div class="field field-half">
                    <label for="city">Cidade <span class="required">*</span></label>
                    <input id="city"
                           type="text"
                           maxlength="150"
                           placeholder="Ex: São Paulo"
                           @bind="Model.City"
                           @bind:event="oninput" />
                </div>

                <div class="field field-half">
                    <label for="state">UF (Estado) <span class="required">*</span></label>
                    <input id="state"
                           type="text"
                           maxlength="2"
                           placeholder="SP"
                           style="text-transform: uppercase;"
                           @bind="Model.State"
                           @bind:event="oninput" />
                    <span class="field-hint">Sigla de 2 letras (ex: SP, RJ, MG).</span>
                </div>
            </div>

            <div class="wizard-actions">
                <div class="actions-left">
                    <button type="button" class="button button-secondary" @onclick="PrevStep">
                        <span class="button-arrow" aria-hidden="true">←</span>
                        <span>Voltar</span>
                    </button>
                </div>
                <div class="actions-right">
                    <button type="button" class="button button-primary" @onclick="NextStep">
                        <span>Avançar para Identidade Visual</span>
                        <span class="button-arrow" aria-hidden="true">→</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Step 3: Identidade Visual & Prévia ao Vivo -->
    @if (CurrentStep == 3)
    {
        <div class="step-panel" data-testid="step-3-panel">
            <div class="panel-intro">
                <h3>Identidade Visual & Cores da Marca</h3>
                <p>Personalize a logomarca e as cores que aparecerão nos comprovantes térmicos, ordens de serviço e no link de acompanhamento enviado aos clientes via WhatsApp.</p>
            </div>

            <div class="branding-layout">
                <!-- Branding Inputs Column -->
                <div class="branding-controls">
                    <!-- Logo Upload Section -->
                    <div class="branding-section">
                        <label class="control-label">Logomarca do Estabelecimento</label>
                        <p class="control-desc">Envie uma imagem PNG, JPG, WEBP ou SVG (máx. 2 MB) em alta definição.</p>

                        <div class="upload-dropzone">
                            <InputFile id="logoUploadInput"
                                       class="file-input-hidden"
                                       accept=".png,.jpg,.jpeg,.webp,.svg"
                                       OnChange="HandleLogoFileSelectedAsync" />

                            <label for="logoUploadInput" class="upload-dropzone-label">
                                <span class="upload-icon">📁</span>
                                <div>
                                    <strong>Clique para selecionar ou arraste o arquivo da logomarca</strong>
                                    <span class="upload-formats">Formatos aceitos: PNG, JPG, JPEG, WEBP ou SVG (até 2MB)</span>
                                </div>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                        {
                            <div class="selected-file-badge">
                                <span class="badge-icon">✓</span>
                                <span class="badge-filename">@_selectedFileName</span>
                                <button type="button" class="badge-clear" @onclick="ClearSelectedLogo">Remover</button>
                            </div>
                        }
                    </div>

                    <!-- Colors Selection Section -->
                    <div class="branding-section">
                        <label class="control-label">Paleta de Cores</label>
                        <p class="control-desc">Selecione as cores que refletem a identidade do seu lava-jato ou estética automotiva.</p>

                        <div class="color-pickers-row">
                            <div class="color-picker-box">
                                <span class="picker-label">Cor Primária</span>
                                <div class="picker-input-group">
                                    <input type="color"
                                           class="color-input"
                                           value="@GetEffectivePrimaryColor()"
                                           @onchange="e => Model.BrandPrimaryColor = e.Value?.ToString()" />
                                    <input type="text"
                                           class="hex-input mono"
                                           maxlength="7"
                                           placeholder="#2563EB"
                                           @bind="Model.BrandPrimaryColor"
                                           @bind:event="oninput" />
                                </div>
                                <span class="picker-hint">Botões, cabeçalhos de destaque e títulos.</span>
                            </div>

                            <div class="color-picker-box">
                                <span class="picker-label">Cor Secundária</span>
                                <div class="picker-input-group">
                                    <input type="color"
                                           class="color-input"
                                           value="@GetEffectiveSecondaryColor()"
                                           @onchange="e => Model.BrandSecondaryColor = e.Value?.ToString()" />
                                    <input type="text"
                                           class="hex-input mono"
                                           maxlength="7"
                                           placeholder="#0EA5E9"
                                           @bind="Model.BrandSecondaryColor"
                                           @bind:event="oninput" />
                                </div>
                                <span class="picker-hint">Badges, links e elementos de suporte.</span>
                            </div>
                        </div>

                        <!-- Presets rápidos -->
                        <div class="presets-section">
                            <span class="presets-label">Paletas Recomendadas para Lava-Jato:</span>
                            <div class="presets-grid">
                                <button type="button" class="preset-btn" @onclick='() => ApplyPreset("#2563EB", "#0EA5E9")'>
                                    <span class="preset-swatch" style="background: linear-gradient(135deg, #2563EB, #0EA5E9);"></span>
                                    <span>Azul Royal</span>
                                </button>
                                <button type="button" class="preset-btn" @onclick='() => ApplyPreset("#EA580C", "#F59E0B")'>
                                    <span class="preset-swatch" style="background: linear-gradient(135deg, #EA580C, #F59E0B);"></span>
                                    <span>Sunset Sport</span>
                                </button>
                                <button type="button" class="preset-btn" @onclick='() => ApplyPreset("#DC2626", "#EF4444")'>
                                    <span class="preset-swatch" style="background: linear-gradient(135deg, #DC2626, #EF4444);"></span>
                                    <span>Racing Red</span>
                                </button>
                                <button type="button" class="preset-btn" @onclick='() => ApplyPreset("#059669", "#10B981")'>
                                    <span class="preset-swatch" style="background: linear-gradient(135deg, #059669, #10B981);"></span>
                                    <span>Eco Green</span>
                                </button>
                                <button type="button" class="preset-btn" @onclick='() => ApplyPreset("#475569", "#06B6D4")'>
                                    <span class="preset-swatch" style="background: linear-gradient(135deg, #475569, #06B6D4);"></span>
                                    <span>Titanium Dark</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Preview Column -->
                <div class="branding-preview-column">
                    <div class="preview-sticky-wrap">
                        <div class="preview-header-bar">
                            <span class="preview-title">PRÉVIA EM TEMPO REAL</span>
                            <span class="preview-tag">Atualização Instantânea</span>
                        </div>

                        <BrandReceiptPreview TradeName="@Model.TradeName"
                                             Phone="@Model.Phone"
                                             Address="@GetFormattedAddress()"
                                             LogoUrl="@(_previewLogoDataUrl ?? Model.LogoUrl)"
                                             PrimaryColor="@GetEffectivePrimaryColor()"
                                             SecondaryColor="@GetEffectiveSecondaryColor()" />
                    </div>
                </div>
            </div>

            <div class="wizard-actions">
                <div class="actions-left">
                    <button type="button" class="button button-secondary" @onclick="PrevStep">
                        <span class="button-arrow" aria-hidden="true">←</span>
                        <span>Voltar</span>
                    </button>
                </div>
                <div class="actions-right">
                    <button type="button" class="button button-primary" @onclick="NextStep">
                        <span>Revisar Dados</span>
                        <span class="button-arrow" aria-hidden="true">→</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Step 4: Revisão & Salvar -->
    @if (CurrentStep == 4)
    {
        <div class="step-panel" data-testid="step-4-panel">
            <div class="panel-intro">
                <h3>Confirmação dos Dados Cadastrais & Identidade</h3>
                <p>Revise todas as informações antes de salvar o perfil do estabelecimento.</p>
            </div>

            <div class="review-grid">
                <div class="review-card">
                    <div class="review-card-header">
                        <span class="card-icon">🏢</span>
                        <h4>Identificação</h4>
                        <button type="button" class="text-link" @onclick="() => CurrentStep = 1">Editar</button>
                    </div>
                    <div class="review-list">
                        <div class="review-row">
                            <span class="review-label">Razão Social:</span>
                            <span class="review-value">@Model.LegalName</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">Nome Fantasia:</span>
                            <span class="review-value">@Model.TradeName</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">CNPJ:</span>
                            <span class="review-value mono">@Model.Cnpj</span>
                        </div>
                    </div>
                </div>

                <div class="review-card">
                    <div class="review-card-header">
                        <span class="card-icon">📍</span>
                        <h4>Contato e Localização</h4>
                        <button type="button" class="text-link" @onclick="() => CurrentStep = 2">Editar</button>
                    </div>
                    <div class="review-list">
                        <div class="review-row">
                            <span class="review-label">Telefone:</span>
                            <span class="review-value mono">@Model.Phone</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">Endereço:</span>
                            <span class="review-value">@Model.Street</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">Cidade / UF:</span>
                            <span class="review-value">@Model.City - @Model.State.ToUpperInvariant()</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">CEP:</span>
                            <span class="review-value mono">@Model.PostalCode</span>
                        </div>
                    </div>
                </div>

                <div class="review-card review-card-full">
                    <div class="review-card-header">
                        <span class="card-icon">🎨</span>
                        <h4>Identidade Visual Configurada</h4>
                        <button type="button" class="text-link" @onclick="() => CurrentStep = 3">Editar</button>
                    </div>
                    <div class="branding-review-row">
                        <div class="branding-review-logo">
                            @if (!string.IsNullOrWhiteSpace(_previewLogoDataUrl ?? Model.LogoUrl))
                            {
                                <img src="@(_previewLogoDataUrl ?? Model.LogoUrl)" alt="Logomarca" class="review-logo-preview" />
                            }
                            else
                            {
                                <div class="review-logo-fallback" style="background: @GetEffectivePrimaryColor();">
                                    @(string.IsNullOrWhiteSpace(Model.TradeName) ? "L" : Model.TradeName.Trim()[..1].ToUpperInvariant())
                                </div>
                            }
                            <span class="review-logo-name">@(SelectedLogoFile?.Name ?? (string.IsNullOrWhiteSpace(Model.LogoUrl) ? "Sem logomarca (usará iniciais)" : "Logomarca cadastrada"))</span>
                        </div>

                        <div class="branding-review-colors">
                            <div class="color-sample">
                                <span class="color-chip" style="background: @GetEffectivePrimaryColor();"></span>
                                <span class="color-code mono">@GetEffectivePrimaryColor() (Primária)</span>
                            </div>
                            <div class="color-sample">
                                <span class="color-chip" style="background: @GetEffectiveSecondaryColor();"></span>
                                <span class="color-code mono">@GetEffectiveSecondaryColor() (Secundária)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="wizard-actions">
                <div class="actions-left">
                    <button type="button" class="button button-secondary" disabled="@IsSubmitting" @onclick="PrevStep">
                        <span class="button-arrow" aria-hidden="true">←</span>
                        <span>Voltar</span>
                    </button>
                </div>
                <div class="actions-right">
                    <button type="button" class="button button-primary button-save" disabled="@IsSubmitting" @onclick="SubmitAsync">
                        @if (IsSubmitting)
                        {
                            <span class="button-spinner" aria-hidden="true"></span>
                            <span>Salvando cadastro...</span>
                        }
                        else
                        {
                            <span class="button-check" aria-hidden="true">✓</span>
                            <span>@(IsEditMode ? "Atualizar Perfil" : "Concluir Cadastro")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public StoreProfileFormModel Model { get; set; } = new();

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback<StoreProfileFormModel> OnSave { get; set; }

    [Parameter]
    public EventCallback<IBrowserFile> OnLogoSelected { get; set; }

    public int CurrentStep { get; set; } = 1;
    public string? ErrorMessage { get; set; }

    public IBrowserFile? SelectedLogoFile { get; private set; }
    public byte[]? SelectedLogoBytes { get; private set; }
    public string? SelectedLogoFileName { get; private set; }
    private string? _selectedFileName;
    private string? _previewLogoDataUrl;

    private static readonly HashSet<string> AllowedExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".png", ".jpg", ".jpeg", ".webp", ".svg"
    };

    private void HandleCnpjInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        Model.Cnpj = StoreProfileFormModel.FormatCnpj(raw);
    }

    private void HandleCepInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        Model.PostalCode = StoreProfileFormModel.FormatCep(raw);
    }

    private async Task HandleLogoFileSelectedAsync(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file is null) return;

        var ext = Path.GetExtension(file.Name);
        if (!AllowedExtensions.Contains(ext))
        {
            ErrorMessage = "Formato de imagem inválido. Escolha um arquivo PNG, JPG, JPEG, WEBP ou SVG.";
            return;
        }

        if (file.Size > 2 * 1024 * 1024)
        {
            ErrorMessage = "O arquivo de logomarca deve ter no máximo 2 MB.";
            return;
        }

        try
        {
            SelectedLogoFile = file;
            SelectedLogoFileName = file.Name;
            _selectedFileName = $"{file.Name} ({(file.Size / 1024):N0} KB)";

            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            SelectedLogoBytes = ms.ToArray();
            var base64 = Convert.ToBase64String(SelectedLogoBytes);
            var mime = file.ContentType;
            if (string.IsNullOrWhiteSpace(mime))
            {
                mime = ext.ToLowerInvariant() switch
                {
                    ".png" => "image/png",
                    ".jpg" or ".jpeg" => "image/jpeg",
                    ".webp" => "image/webp",
                    ".svg" => "image/svg+xml",
                    _ => "application/octet-stream"
                };
            }
            _previewLogoDataUrl = $"data:{mime};base64,{base64}";

            await OnLogoSelected.InvokeAsync(file);
        }
        catch (Exception)
        {
            ErrorMessage = "Erro ao carregar o arquivo da logomarca. Tente novamente.";
        }
    }

    private void ClearSelectedLogo()
    {
        SelectedLogoFile = null;
        SelectedLogoBytes = null;
        SelectedLogoFileName = null;
        _selectedFileName = null;
        _previewLogoDataUrl = null;
        Model.LogoUrl = null;
    }

    private void ApplyPreset(string primary, string secondary)
    {
        Model.BrandPrimaryColor = primary;
        Model.BrandSecondaryColor = secondary;
    }

    private string GetEffectivePrimaryColor() =>
        string.IsNullOrWhiteSpace(Model.BrandPrimaryColor) ? "#2563EB" : Model.BrandPrimaryColor;

    private string GetEffectiveSecondaryColor() =>
        string.IsNullOrWhiteSpace(Model.BrandSecondaryColor) ? "#0EA5E9" : Model.BrandSecondaryColor;

    private string GetFormattedAddress()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Street)) parts.Add(Model.Street);
        if (!string.IsNullOrWhiteSpace(Model.City)) parts.Add(Model.City);
        if (!string.IsNullOrWhiteSpace(Model.State)) parts.Add(Model.State.ToUpperInvariant());
        return string.Join(" • ", parts);
    }

    private void NextStep()
    {
        ErrorMessage = null;
        if (CurrentStep == 1)
        {
            var (isValid, error) = Model.ValidateStep1();
            if (!isValid)
            {
                ErrorMessage = error;
                return;
            }
            CurrentStep = 2;
        }
        else if (CurrentStep == 2)
        {
            var (isValid, error) = Model.ValidateStep2();
            if (!isValid)
            {
                ErrorMessage = error;
                return;
            }
            CurrentStep = 3;
        }
        else if (CurrentStep == 3)
        {
            var (isValid, error) = Model.ValidateStep3Branding();
            if (!isValid)
            {
                ErrorMessage = error;
                return;
            }
            CurrentStep = 4;
        }
    }

    private void PrevStep()
    {
        ErrorMessage = null;
        if (CurrentStep > 1)
        {
            CurrentStep--;
        }
    }

    private void TryGoToStep(int targetStep)
    {
        ErrorMessage = null;
        if (targetStep < CurrentStep)
        {
            CurrentStep = targetStep;
            return;
        }

        if (targetStep == 2)
        {
            var (isValid, error) = Model.ValidateStep1();
            if (isValid) CurrentStep = 2;
            else ErrorMessage = error;
        }
        else if (targetStep == 3)
        {
            var (s1Valid, s1Error) = Model.ValidateStep1();
            if (!s1Valid) { ErrorMessage = s1Error; return; }
            var (s2Valid, s2Error) = Model.ValidateStep2();
            if (!s2Valid) { ErrorMessage = s2Error; return; }
            CurrentStep = 3;
        }
        else if (targetStep == 4)
        {
            var (s1Valid, s1Error) = Model.ValidateStep1();
            if (!s1Valid) { ErrorMessage = s1Error; return; }
            var (s2Valid, s2Error) = Model.ValidateStep2();
            if (!s2Valid) { ErrorMessage = s2Error; return; }
            var (s3Valid, s3Error) = Model.ValidateStep3Branding();
            if (!s3Valid) { ErrorMessage = s3Error; return; }
            CurrentStep = 4;
        }
    }

    private async Task SubmitAsync()
    {
        ErrorMessage = null;
        var (s1Valid, s1Error) = Model.ValidateStep1();
        if (!s1Valid)
        {
            ErrorMessage = s1Error;
            CurrentStep = 1;
            return;
        }

        var (s2Valid, s2Error) = Model.ValidateStep2();
        if (!s2Valid)
        {
            ErrorMessage = s2Error;
            CurrentStep = 2;
            return;
        }

        var (s3Valid, s3Error) = Model.ValidateStep3Branding();
        if (!s3Valid)
        {
            ErrorMessage = s3Error;
            CurrentStep = 3;
            return;
        }

        await OnSave.InvokeAsync(Model);
    }
}
