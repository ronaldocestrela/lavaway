@using CarWashSaaS.Shared.Contracts
@implements IAsyncDisposable

<div class="checklist-card">
    <div class="card-header">
        <div class="card-header-top">
            <span class="header-tag">CONFERÊNCIA DE ENTRADA</span>
            <div class="autosave-indicator @GetStatusClass()">
                <span class="status-dot"></span>
                <span class="status-text">@GetStatusText()</span>
            </div>
        </div>
        <h3 class="header-title">Itens e Estado do Veículo</h3>
    </div>

    <!-- Indicador de Combustível -->
    <div class="section-group">
        <label class="section-label">Nível de Combustível</label>
        <div class="fuel-level-pills">
            <button type="button" class="btn-pill @(FuelLevel == "Empty" ? "active" : "")" @onclick='() => SetFuel("Empty")'>
                Reserva / Vazio
            </button>
            <button type="button" class="btn-pill @(FuelLevel == "OneQuarter" ? "active" : "")" @onclick='() => SetFuel("OneQuarter")'>
                1/4
            </button>
            <button type="button" class="btn-pill @(FuelLevel == "Half" ? "active" : "")" @onclick='() => SetFuel("Half")'>
                1/2
            </button>
            <button type="button" class="btn-pill @(FuelLevel == "ThreeQuarters" ? "active" : "")" @onclick='() => SetFuel("ThreeQuarters")'>
                3/4
            </button>
            <button type="button" class="btn-pill @(FuelLevel == "Full" ? "active" : "")" @onclick='() => SetFuel("Full")'>
                Cheio
            </button>
        </div>
    </div>

    <!-- Odômetro -->
    <div class="section-group">
        <label class="section-label">Quilometragem (Odômetro)</label>
        <div class="odometer-input-wrapper">
            <span class="odometer-icon">&#128392;</span>
            <input type="number"
                   class="odometer-input"
                   placeholder="Ex.: 45000"
                   value="@OdometerKm"
                   @oninput="HandleOdometerInput"
                   @onchange="HandleOdometerChange"
                   @onblur="HandleOdometerBlur"
                   disabled="@IsReadOnly" />
            <span class="odometer-unit">km</span>
        </div>
    </div>

    <!-- Itens de Checklist Físico -->
    <div class="section-group">
        <label class="section-label">Itens de Conferência</label>
        <div class="items-list">
            @foreach (var item in Items)
            {
                <div class="checklist-item-row">
                    <div class="item-info">
                        <span class="item-title">@item.Title</span>
                        @if (!string.IsNullOrWhiteSpace(item.Observation))
                        {
                            <span class="item-obs">Obs: @item.Observation</span>
                        }
                    </div>
                    <div class="item-status-actions">
                        <button type="button"
                                class="btn-status ok @(GetItemStatus(item) == ChecklistItemStatus.Ok ? "active" : "")"
                                @onclick="() => SetItemStatus(item, ChecklistItemStatus.Ok)"
                                disabled="@IsReadOnly">
                            OK
                        </button>
                        <button type="button"
                                class="btn-status missing @(GetItemStatus(item) == ChecklistItemStatus.Missing ? "active" : "")"
                                @onclick="() => SetItemStatus(item, ChecklistItemStatus.Missing)"
                                disabled="@IsReadOnly">
                            Faltando
                        </button>
                        <button type="button"
                                class="btn-status damaged @(GetItemStatus(item) == ChecklistItemStatus.Damaged ? "active" : "")"
                                @onclick="() => SetItemStatus(item, ChecklistItemStatus.Damaged)"
                                disabled="@IsReadOnly">
                            Avariado
                        </button>
                        <button type="button"
                                class="btn-status na @(GetItemStatus(item) == ChecklistItemStatus.NotApplicable ? "active" : "")"
                                @onclick="() => SetItemStatus(item, ChecklistItemStatus.NotApplicable)"
                                disabled="@IsReadOnly">
                            N/A
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Observações Gerais -->
    <div class="section-group">
        <label class="section-label">Observações Gerais da Vistoria</label>
        <textarea class="notes-textarea"
                  placeholder="Ex.: Pertences no porta-malas conferidos com o cliente..."
                  rows="3"
                  value="@Notes"
                  @oninput="HandleNotesInput"
                  @onchange="HandleNotesChange"
                  @onblur="HandleNotesBlur"
                  disabled="@IsReadOnly"
                  maxlength="500"></textarea>
        <span class="char-count">@((Notes?.Length ?? 0))/500 caracteres</span>
    </div>
</div>

@code {
    [Parameter] public string? FuelLevel { get; set; }
    [Parameter] public int? OdometerKm { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public IReadOnlyCollection<InspectionChecklistItemDto> Items { get; set; } = [];
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<UpdateInspectionChecklistRequest> OnSave { get; set; }

    private enum AutoSaveStatus { Saved, Saving, Error }
    private AutoSaveStatus _status = AutoSaveStatus.Saved;
    private CancellationTokenSource? _debounceCts;

    private readonly Dictionary<string, (ChecklistItemStatus Status, string? Obs)> _localChanges = [];

    protected override void OnParametersSet()
    {
        if (Items.Count > 0 && _localChanges.Count > 0)
        {
            var keysToRemove = _localChanges
                .Where(kv =>
                {
                    var matching = Items.FirstOrDefault(i => i.ItemKey == kv.Key);
                    return matching is not null && matching.Status == kv.Value.Status && matching.Observation == kv.Value.Obs;
                })
                .Select(kv => kv.Key)
                .ToList();

            foreach (var key in keysToRemove)
            {
                _localChanges.Remove(key);
            }
        }
    }

    private async Task SetFuel(string level)
    {
        if (IsReadOnly) return;
        FuelLevel = level;
        await TriggerAutoSaveAsync();
    }

    private void HandleOdometerInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var km))
        {
            OdometerKm = km;
        }
        else if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
        {
            OdometerKm = null;
        }
        ScheduleDebouncedSave();
    }

    private async Task HandleOdometerBlur()
    {
        await FlushAutoSaveAsync();
    }

    private async Task HandleOdometerChange(ChangeEventArgs e)
    {
        HandleOdometerInput(e);
        await FlushAutoSaveAsync();
    }

    private void HandleNotesInput(ChangeEventArgs e)
    {
        Notes = e.Value?.ToString();
        ScheduleDebouncedSave();
    }

    private async Task HandleNotesBlur()
    {
        await FlushAutoSaveAsync();
    }

    private async Task HandleNotesChange(ChangeEventArgs e)
    {
        Notes = e.Value?.ToString();
        await FlushAutoSaveAsync();
    }

    private ChecklistItemStatus GetItemStatus(InspectionChecklistItemDto item)
    {
        return _localChanges.TryGetValue(item.ItemKey, out var change)
            ? change.Status
            : item.Status;
    }

    private async Task SetItemStatus(InspectionChecklistItemDto item, ChecklistItemStatus status)
    {
        if (IsReadOnly) return;
        var currentObs = _localChanges.TryGetValue(item.ItemKey, out var existing) ? existing.Obs : item.Observation;
        _localChanges[item.ItemKey] = (status, currentObs);
        await TriggerAutoSaveAsync();
    }

    private void ScheduleDebouncedSave()
    {
        if (IsReadOnly) return;
        _status = AutoSaveStatus.Saving;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(TriggerAutoSaveAsync);
                }
            }
            catch (OperationCanceledException)
            {
                // Debounce cancelado por alteração subsequente
            }
        }, token);
    }

    private async Task FlushAutoSaveAsync()
    {
        if (IsReadOnly) return;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
        await TriggerAutoSaveAsync();
    }

    private async Task TriggerAutoSaveAsync()
    {
        if (IsReadOnly) return;
        try
        {
            _status = AutoSaveStatus.Saving;
            StateHasChanged();

            var updatedItems = Items.Select(i =>
            {
                if (_localChanges.TryGetValue(i.ItemKey, out var change))
                {
                    return new UpdateChecklistItemRequest(i.ItemKey, i.Title, change.Status, change.Obs);
                }
                return new UpdateChecklistItemRequest(i.ItemKey, i.Title, i.Status, i.Observation);
            }).ToArray();

            var request = new UpdateInspectionChecklistRequest(FuelLevel, OdometerKm, Notes, updatedItems);
            await OnSave.InvokeAsync(request);
            _status = AutoSaveStatus.Saved;
        }
        catch
        {
            _status = AutoSaveStatus.Error;
            throw;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetStatusClass() => _status switch
    {
        AutoSaveStatus.Saving => "saving",
        AutoSaveStatus.Error => "error",
        _ => "saved"
    };

    private string GetStatusText() => _status switch
    {
        AutoSaveStatus.Saving => "Salvando...",
        AutoSaveStatus.Error => "Falha ao salvar",
        _ => "Salvo automaticamente"
    };

    public async ValueTask DisposeAsync()
    {
        if (_debounceCts is not null)
        {
            _debounceCts.Cancel();
            _debounceCts.Dispose();
            _debounceCts = null;
            await TriggerAutoSaveAsync();
        }
    }
}
