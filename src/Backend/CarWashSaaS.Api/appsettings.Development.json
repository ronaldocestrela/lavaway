{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5199",
      "https://localhost:7288"
    ]
  },
  "Authentication": {
    "Authority": "http://localhost:5000",
    "Issuer": "http://localhost:5000",
    "Audience": "CarWashSaaS.Client",
    "SigningKey": "LavawayDefaultSecretKeyForJwtTokens2026!MustBeAtLeast256Bits",
    "AccessTokenLifetimeMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "Minio": {
      "Endpoint": "localhost:9000",
      "Bucket": "lavaway-private",
      "UseSSL": false
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Uri": "amqp://lavaway:CHANGE_ME@localhost:5672/",
      "Queue": "lavaway.tenant-events",
      "MaxDeliveryAttempts": 5,
      "RetryBaseDelayMilliseconds": 500,
      "RetryMaxDelayMilliseconds": 30000
    }
  },
  "WhatsApp": {
    "EvolutionApi": {
      "BaseUrl": "http://localhost:8080/",
      "ApiKey": "CHANGE_ME",
      "InstanceNamePrefix": "lavaway",
      "WebhookSecret": "LavawayEvolutionWebhookSecretDev2026!",
      "WebhookUrl": "http://host.docker.internal:5225/whatsapp/webhooks/evolution?secret=LavawayEvolutionWebhookSecretDev2026!"
    }
  }
}
