{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Authority": "http://api:8080",
    "Issuer": "http://api:8080",
    "Audience": "CarWashSaaS.Client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "Storage": {
    "Minio": {
      "Endpoint": "minio:9000",
      "Bucket": "lavaway-private",
      "UseSSL": false
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Uri": "amqp://lavaway:lavaway@rabbitmq:5672/",
      "Queue": "lavaway.tenant-events",
      "MaxDeliveryAttempts": 5,
      "RetryBaseDelayMilliseconds": 500,
      "RetryMaxDelayMilliseconds": 30000
    }
  },
  "WhatsApp": {
    "EvolutionApi": {
      "BaseUrl": "http://evolution-api:8080/",
      "ApiKey": "CHANGE_ME",
      "InstanceNamePrefix": "lavaway",
      "WebhookSecret": "",
      "WebhookUrl": ""
    }
  }
}
